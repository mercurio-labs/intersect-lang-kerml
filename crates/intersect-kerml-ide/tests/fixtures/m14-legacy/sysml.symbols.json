{
  "schemaVersion": 1,
  "id": "sysml.symbols",
  "imports": [],
  "definitions": [
    {
      "id": "sysml.symbols/structure",
      "version": "1",
      "role": "node",
      "parameters": {},
      "slots": {
        "title": "text",
        "subtitle": "text",
        "compartments": "compartments",
        "children": "children"
      },
      "root": {
        "id": "frame",
        "when": null,
        "anchors": [],
        "content": {
          "kind": "frame",
          "padding": 12,
          "radius": 5,
          "fill": "#edf5ff",
          "stroke": "#395674",
          "strokeWidth": 1,
          "children": [
            {
              "id": "subtitle",
              "when": null,
              "anchors": [],
              "content": {
                "kind": "text",
                "slot": "subtitle",
                "size": 11,
                "weight": 400,
                "italic": false,
                "align": "center",
                "wrap": true,
                "color": "#243b53"
              }
            },
            {
              "id": "title",
              "when": null,
              "anchors": [],
              "content": {
                "kind": "text",
                "slot": "title",
                "size": 13,
                "weight": 700,
                "italic": false,
                "align": "center",
                "wrap": true,
                "color": "#243b53"
              }
            },
            {
              "id": "compartments",
              "when": null,
              "anchors": [],
              "content": {
                "kind": "content",
                "slot": "compartments"
              }
            },
            {
              "id": "children",
              "when": null,
              "anchors": [],
              "content": {
                "kind": "content",
                "slot": "children"
              }
            }
          ]
        }
      },
      "connectionAnchor": null
    },
    {
      "id": "sysml.symbols/port",
      "version": "1",
      "role": "port",
      "parameters": {
        "angle": {
          "kind": "number",
          "default": 0
        },
        "facing": {
          "kind": "choice",
          "values": [
            "WEST",
            "EAST"
          ],
          "default": "EAST"
        }
      },
      "slots": {
        "label": "text"
      },
      "root": {
        "id": "port",
        "when": null,
        "anchors": [],
        "content": {
          "kind": "overlay",
          "children": [
            {
              "id": "orientation",
              "when": null,
              "anchors": [],
              "content": {
                "kind": "transform",
                "x": 0,
                "y": 0,
                "rotate": {
                  "op": "parameter",
                  "name": "angle"
                },
                "scaleX": 1,
                "scaleY": 1,
                "child": {
                  "id": "direction",
                  "when": null,
                  "anchors": [],
                  "content": {
                    "kind": "transform",
                    "x": 0,
                    "y": 0,
                    "rotate": 0,
                    "scaleX": {
                      "op": "select",
                      "condition": {
                        "op": "equal",
                        "name": "facing",
                        "value": "EAST"
                      },
                      "ifTrue": 1,
                      "ifFalse": -1
                    },
                    "scaleY": 1,
                    "child": {
                      "id": "glyph",
                      "when": null,
                      "anchors": [
                        {
                          "id": "tip",
                          "x": 16,
                          "y": 8,
                          "dx": 1,
                          "dy": 0
                        }
                      ],
                      "content": {
                        "kind": "overlay",
                        "children": [
                          {
                            "id": "outline",
                            "when": null,
                            "anchors": [],
                            "content": {
                              "kind": "geometry",
                              "geometry": {
                                "kind": "rectangle",
                                "width": 16,
                                "height": 16,
                                "radius": 2
                              },
                              "fill": "#ffffff",
                              "stroke": "#375b43",
                              "strokeWidth": 1.3
                            }
                          },
                          {
                            "id": "arrow",
                            "when": null,
                            "anchors": [],
                            "content": {
                              "kind": "geometry",
                              "geometry": {
                                "kind": "path",
                                "width": 16,
                                "height": 16,
                                "commands": [
                                  {
                                    "kind": "move",
                                    "x": 3,
                                    "y": 8
                                  },
                                  {
                                    "kind": "line",
                                    "x": 12,
                                    "y": 8
                                  },
                                  {
                                    "kind": "move",
                                    "x": 8,
                                    "y": 4
                                  },
                                  {
                                    "kind": "line",
                                    "x": 12,
                                    "y": 8
                                  },
                                  {
                                    "kind": "line",
                                    "x": 8,
                                    "y": 12
                                  }
                                ]
                              },
                              "fill": "none",
                              "stroke": "#375b43",
                              "strokeWidth": 1.4
                            }
                          }
                        ]
                      }
                    }
                  }
                }
              }
            },
            {
              "id": "outsideLabel",
              "when": null,
              "anchors": [],
              "content": {
                "kind": "transform",
                "x": {
                  "op": "select",
                  "condition": {
                    "op": "equal",
                    "name": "facing",
                    "value": "EAST"
                  },
                  "ifTrue": 28,
                  "ifFalse": {
                    "op": "subtract",
                    "left": -12,
                    "right": {
                      "op": "slotWidth",
                      "slot": "label"
                    }
                  }
                },
                "y": -2,
                "rotate": 0,
                "scaleX": 1,
                "scaleY": 1,
                "child": {
                  "id": "labelText",
                  "when": null,
                  "anchors": [],
                  "content": {
                    "kind": "text",
                    "slot": "label",
                    "size": 12,
                    "weight": 400,
                    "italic": false,
                    "align": "start",
                    "wrap": false,
                    "color": "#375b43"
                  }
                }
              }
            }
          ]
        }
      },
      "connectionAnchor": "tip"
    }
  ]
}
