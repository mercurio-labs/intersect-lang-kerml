        reference "#//@eClassifiers.58/@eStructuralFeatures.23";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref usage: Usage [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "featuringUsage";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Usages</code> that are <code>features</code> of this <code>Usage</code> (not necessarily owned).</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.160/@eStructuralFeatures.3";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref variant: Usage [0,*] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "owningVariationUsage";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Usages</code> which represent the variants of this <code>Usage</code> as a variation point <code>Usage</code>, if <code>isVariation = true</code>. If <code>isVariation = false</code>, then there must be no <code>variants</code>.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.107/@eStructuralFeatures.4";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref variantMembership: VariantMembership [0,*] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "owningVariationUsage";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>ownedMemberships</code> of this <code>Usage</code> that are <code>VariantMemberships</code>. If <code>isVariation = true</code>, then this must be all <code>memberships</code> of the <code>Usage</code>. If <code>isVariation = false</code>, then <code>variantMembership</code>must be empty.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.107/@eStructuralFeatures.5";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class UseCaseDefinition extends CaseDefinition {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>UseCaseDefinition</code> is a <code>CaseDefinition</code> that specifies a set of actions performed by its subject, in interaction with one or more actors external to the subject. The objective is to yield an observable result that is of value to one or more of the actors.</p>\n\nincludedUseCase = ownedUseCase->\n    selectByKind(IncludeUseCaseUsage).\n    useCaseIncluded\nspecializesFromLibrary('UseCases::UseCase')";
    }
    ref includedUseCase: UseCaseUsage [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "includingUseCaseDefinition";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>UseCaseUsages</code> that are included by this <code>UseCaseDefinition</code>, which are the <code>useCaseIncludeds</code> of the <code>IncludeUseCaseUsages</code> owned by this <code>UseCaseDefinition<code>.</p>";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class UseCaseUsage extends CaseUsage {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>UseCaseUsage</code> is a <code>Usage</code> of a <code>UseCaseDefinition</code>.</p>\nincludedUseCase = ownedUseCase->\n    selectByKind(IncludeUseCaseUsage).\n    useCaseIncluded\nspecializesFromLibrary('UseCases::useCases')\nisComposite and owningType <> null and\n(owningType.oclIsKindOf(UseCaseDefinition) or\n owningType.oclIsKindOf(UseCaseUsage)) implies\n    specializesFromLibrary('UseCases::UseCase::subUseCases')";
    }
    ref includedUseCase: UseCaseUsage [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "includingUseCase";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>UseCaseUsages</code> that are included by this <code>UseCaseUse</code>, which are the <code>useCaseIncludeds</code> of the <code>IncludeUseCaseUsages</code> owned by this <code>UseCaseUsage<code>.</p>";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref useCaseDefinition: UseCaseDefinition [0,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "definedUseCase";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>UseCaseDefinition</code> that is the <code>definition</code> of this <code>UseCaseUsage</code>.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.23/@eStructuralFeatures.1";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class VariantMembership extends OwningMembership {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>VariantMembership</code> is a <code>Membership</code> between a variation point <code>Definition</code> or <code>Usage</code> and a <code>Usage</code> that represents a variant in the context of that variation. The <code>membershipOwningNamespace</code> for the <code>VariantMembership</code> must be either a Definition or a <code>Usage</code> with <code>isVariation = true</code>.</p>\nmembershipOwningNamespace.oclIsKindOf(Definition) and\n    membershipOwningNamespace.oclAsType(Definition).isVariation or\nmembershipOwningNamespace.oclIsKindOf(Usage) and\n    membershipOwningNamespace.oclAsType(Usage).isVariation\n";
    }
    ref ownedVariantUsage: Usage [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "owningVariantMembership";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Usage</code> that represents a variant in the context of the <code>owningVariationDefinition</code> or <code>owningVariationUsage</code>.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.115/@eStructuralFeatures.0";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class VerificationCaseDefinition extends CaseDefinition {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>VerificationCaseDefinition</code> is a <code>CaseDefinition</code> for the purpose of verification of the subject of the case against its requirements.</p>\nverifiedRequirement =\n    if objectiveRequirement = null then OrderedSet{}\n    else \n        objectiveRequirement.featureMembership->\n            selectByKind(RequirementVerificationMembership).\n            verifiedRequirement->asOrderedSet()\n    endif\nspecializesFromLibrary('VerificationCases::VerificationCase')";
    }
    ref verifiedRequirement: RequirementUsage [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "verifyingCaseDefinition";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>RequirementUsages</code> verified by this <code>VerificationCaseDefinition</code>, which are the <code>verifiedRequirements</code> of all <code>RequirementVerificationMemberships</code> of the <code>objectiveRequirement</code>.</p>";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class VerificationCaseUsage extends CaseUsage {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>VerificationCaseUsage</code> is a </code>Usage</code> of a <code>VerificationCaseDefinition</code>.</p>\nverifiedRequirement =\n    if objectiveRequirement = null then OrderedSet{}\n    else \n        objectiveRequirement.featureMembership->\n            selectByKind(RequirementVerificationMembership).\n            verifiedRequirement->asOrderedSet()\n    endif\nspecializesFromLibrary('VerificationCases::verificationCases')\nisComposite and owningType <> null and\n    (owningType.oclIsKindOf(VerificationCaseDefinition) or\n     owningType.oclIsKindOf(VerificationCaseUsage)) implies \n    specializesFromLibrary('VerificationCases::VerificationCase::subVerificationCases')";
    }
    ref verificationCaseDefinition: VerificationCaseDefinition [0,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "definedVerificationCase";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>VerificationCase</code> that is the <code>definition</code> of this <code>VerificationCaseUsage</code>.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.23/@eStructuralFeatures.1";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref verifiedRequirement: RequirementUsage [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "verifyingCase";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>RequirementUsages</code> verified by this <code>VerificationCaseUsage</code>, which are the <code>verifiedRequirements</code> of all <code>RequirementVerificationMemberships</code> of the <code>objectiveRequirement</code>.</p>";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class ViewDefinition extends PartDefinition {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>ViewDefinition</code> is a <code>PartDefinition</code> that specifies how a view artifact is constructed to satisfy a <code>viewpoint</code>. It specifies a <code>viewConditions</code> to define the model content to be presented and a <code>viewRendering</code> to define how the model content is presented.</p>\nview = usage->selectByKind(ViewUsage)\nsatisfiedViewpoint = ownedRequirement->\n    selectByKind(ViewpointUsage)->\n    select(isComposite)\nviewRendering =\n    let renderings: OrderedSet(ViewRenderingMembership) =\n        featureMembership->selectByKind(ViewRenderingMembership) in\n    if renderings->isEmpty() then null\n    else renderings->first().referencedRendering\n    endif\nviewCondition = ownedMembership->\n    selectByKind(ElementFilterMembership).\n    condition\nfeatureMembership->\n    selectByKind(ViewRenderingMembership)->\n    size() <= 1\nspecializesFromLibrary('Views::View')";
    }
    ref satisfiedViewpoint: ViewpointUsage [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "viewpointSatisfyingViewDefinition";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The composite <code>ownedRequirements</code> of this <code>ViewDefinition</code> that are <code>ViewpointUsages</code> for viewpoints satisfied by the <code>ViewDefinition</code>.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.44/@eStructuralFeatures.21";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref view: ViewUsage [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "featuringView";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>usages</code> of this <code>ViewDefinition</code> that are <code>ViewUsages</code>.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.44/@eStructuralFeatures.29";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref viewCondition: Expression [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "owningViewDefinition";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Expressions</code> related to this <code>ViewDefinition</code> by <code>ElementFilterMemberships</code>, which specify conditions on <code>Elements</code> to be rendered in a view.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.107/@eStructuralFeatures.4";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref viewRendering: RenderingUsage [0,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "renderingOwningViewDefinition";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>RenderingUsage</code> to be used to render views defined by this <code>ViewDefinition</code>, which is the <code>referencedRendering</code> of the <code>ViewRenderingMembership</code> of the <code>ViewDefinition</code>.<p>";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class ViewRenderingMembership extends FeatureMembership {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>ViewRenderingMembership</code> is a <coed>FeatureMembership</code> that identifies the <code>viewRendering</code> of a <code>ViewDefinition</code> or <code>ViewUsage</code>.</p>\nreferencedRendering =\n    let referencedFeature : Feature = \n        ownedRendering.referencedFeatureTarget() in\n    if referencedFeature = null then ownedRendering\n    else if referencedFeature.oclIsKindOf(RenderingUsage) then\n        refrencedFeature.oclAsType(RenderingUsage)\n    else null\n    endif endif\nowningType.oclIsKindOf(ViewDefinition) or\nowningType.oclIsKindOf(ViewUsage)";
    }
    ref ownedRendering: RenderingUsage [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "viewRenderingMembership";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The owned <code>RenderingUsage</code> that is either itself the <code>referencedRendering</code> or subsets the <code>referencedRendering</code>.";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.62/@eStructuralFeatures.0";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref referencedRendering: RenderingUsage [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "referencingRenderingMembership";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p> The <code>RenderingUsage</code> that is referenced through this <code>ViewRenderingMembership</code>. It is the <code>referencedFeature</code> of the <code>ownedReferenceSubsetting</code> for the <code>ownedRendering</code>, if there is one, and, otherwise, the <code>ownedRendering</code> itself.</p>";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class ViewUsage extends PartUsage {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>ViewUsage</code> is a usage of a <code>ViewDefinition</code> to specify the generation of a view of the <code>members</code> of a collection of <code>exposedNamespaces</code>. The <code>ViewUsage</code> can satisfy more <code>viewpoints</code> than its definition, and it can specialize the <code>viewRendering</code> specified by its definition.<p>\nexposedElement = ownedImport->selectByKind(Expose).\n    importedMemberships(Set{}).memberElement->\n    select(elm | includeAsExposed(elm))->\n    asOrderedSet()\nsatisfiedViewpoint = ownedRequirement->\n    selectByKind(ViewpointUsage)->\n    select(isComposite)\nviewCondition = ownedMembership->\n    selectByKind(ElementFilterMembership).\n    condition\nviewRendering =\n    let renderings: OrderedSet(ViewRenderingMembership) =\n        featureMembership->selectByKind(ViewRenderingMembership) in\n    if renderings->isEmpty() then null\n    else renderings->first().referencedRendering\n    endif\nfeatureMembership->\n    selectByKind(ViewRenderingMembership)->\n    size() <= 1\nspecializesFromLibrary('Views::views')\nowningType <> null and\n(owningType.oclIsKindOf(ViewDefinition) or\n owningType.oclIsKindOf(ViewUsage)) implies\n    specializesFromLibrary('Views::View::subviews')";
    }
    op includeAsExposed(element: Element [1,1] unordered) -> EBoolean [1,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Determine whether the given <code>element</code> meets all the owned and inherited <code>viewConditions</code>.</p>\nlet metadataFeatures: Sequence(AnnotatingElement) = \n    element.ownedAnnotation.annotatingElement->\n        select(oclIsKindOf(MetadataFeature)) in\nself.membership->selectByKind(ElementFilterMembership).\n    condition->forAll(cond | \n        metadataFeatures->exists(elem | \n            cond.checkCondition(elem)))";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref exposedElement: Element [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "exposingView";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Elements</code> that are exposed by this <code>ViewUsage</code>, which are those <code>memberElements</code> of the imported <code>Memberships</code> from all the <code>Expose</code> <code>Relationships</code> that meet all the owned and inherited <code>viewConditions</code>.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.107/@eStructuralFeatures.1";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref satisfiedViewpoint: ViewpointUsage [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "viewpointSatisfyingView";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>nestedRequirements</code> of this <code>ViewUsage</code> that are <code>ViewpointUsages</code> for (additional) viewpoints satisfied by the <code>ViewUsage</code>.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.163/@eStructuralFeatures.24";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref viewCondition: Expression [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "owningView";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Expressions</code> related to this <code>ViewUsage</code> by <code>ElementFilterMemberships</code>, which specify conditions on <code>Elements</code> to be rendered in a view.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.107/@eStructuralFeatures.4";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref viewDefinition: ViewDefinition [0,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "definedView";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>ViewDefinition</code> that is the <code>definition</code> of this <code>ViewUsage</code>.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.119/@eStructuralFeatures.0";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref viewRendering: RenderingUsage [0,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "renderingOwningView";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>RenderingUsage</code> to be used to render views defined by this <code>ViewUsage</code>, which is the <code>referencedRendering</code> of the <code>ViewRenderingMembership</code> of the <code>ViewUsage</code>.<p>";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class ViewpointDefinition extends RequirementDefinition {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>ViewpointDefinition</code> is a <code>RequirementDefinition</code> that specifies one or more stakeholder concerns that are to be satisfied by creating a view of a model.</p>\nviewpointStakeholder = framedConcern.featureMemberhsip->\n    selectByKind(StakeholderMembership).\n    ownedStakeholderParameter\nspecializesFromLibrary('Views::ViewpointCheck')";
    }
    ref viewpointStakeholder: PartUsage [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "viewpointDefinitionForStakeholder";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>PartUsages</code> that identify the stakeholders with concerns framed by this <code>ViewpointDefinition</code>, which are the owned and inherited <code>stakeholderParameters</code> of the <code>framedConcerns</code> of this <code>ViewpointDefinition</code>.</p>";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class ViewpointUsage extends RequirementUsage {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>ViewpointUsage</code> is a <code>Usage</code> of a <code>ViewpointDefinition</code>.</p>\n\n\nviewpointStakeholder = framedConcern.featureMemberhsip->\n    selectByKind(StakeholderMembership).\n    ownedStakeholderParameter\nspecializesFromLibrary('Views::viewpointChecks')\nisComposite and owningType <> null and\n(owningType.oclIsKindOf(ViewDefinition) or\n owningType.oclIsKindOf(ViewUsage)) implies\n    specializesFromLibrary('Views::View::viewpointSatisfactions')";
    }
    ref viewpointDefinition: ViewpointDefinition [0,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "definedViewpoint";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>ViewpointDefinition</code> that is the <code>definition</code> of this <code>ViewpointUsage<code>.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.134/@eStructuralFeatures.5";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref viewpointStakeholder: PartUsage [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "viewpointForStakeholder";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>PartUsages</code> that identify the stakeholders with concerns framed by this <code>ViewpointUsage</code>, which are the owned and inherited <code>stakeholderParameters</code> of the <code>framedConcerns</code> of this <code>ViewpointUsage</code>.</p>";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  enum VisibilityKind {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p><code>VisibilityKind</code> is an enumeration whose literals specify the visibility of a <code>Membership</code> of an <code>Element</code> in a <code>Namespace</code> outside of that <code>Namespace</code>. Note that &quot;visibility&quot; specifically restricts whether an <code>Element</code> in a <code>Namespace</code> may be referenced by name from outside the <code>Namespace</code> and only otherwise restricts access to an <code>Element</code> as provided by specific constraints in the abstract syntax (e.g., preventing the import or inheritance of private <code>Elements</code>).</p>\n";
    }
    `private` = 0
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Indicates a <code>Membership</code> is not visible outside its owning <code>Namespace</code>.</p>";
      };
    protected = 1
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>An intermediate level of visibility between <code>public</code> and <code>private</code>. By default, it is equivalent to <code>private</code> for the purposes of normal access to and import of <code>Elements</code> from a <code>Namespace</code>. However, other <code>Relationships</code> may be specified to include <code>Memberships</code> with <code>protected</code> visibility in the list of <code>memberships</code> for a <code>Namespace</code> (e.g., <code>Specialization</code>).</p>\n";
      };
    public = 2
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Indicates that a <code>Membership</code> is publicly visible outside its owning <code>Namespace</code>.</p>";
      };
  }
  class WhileLoopActionUsage extends LoopActionUsage {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>WhileLoopActionUsage</code> is a <code>LoopActionUsage</code> that specifies that the <code>bodyAction</code> <code>ActionUsage</code> should be performed repeatedly while the result of the <code>whileArgument</code> <code>Expression</code> is true or until the result of the <code>untilArgument</code> <code>Expression</code> (if provided) is true. The <code>whileArgument</code> <code>Expression</code> is evaluated before each (possible) performance of the <code>bodyAction</code>, and the <code>untilArgument</code> <code>Expression</code> is evaluated after each performance of the <code>bodyAction</code>.</p>\nisSubactionUsage() implies\n    specializesFromLibrary('Actions::Action::whileLoops')\nuntilArgument =\n    let parameter : Feature = inputParameter(3) in\n    if parameter <> null and parameter.oclIsKindOf(Expression) then\n        parameter.oclAsType(Expression)\n    else\n        null\n    endif\n\nspecializesFromLibrary('Actions::whileLoopActions')\nwhileArgument =\n    let parameter : Feature = inputParameter(1) in\n    if parameter <> null and parameter.oclIsKindOf(Expression) then\n        parameter.oclAsType(Expression)\n    else\n        null\n    endif\n\ninputParameters()->size() >= 2";
    }
    ref untilArgument: Expression [0,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "untilLoopAction";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Expression</code> whose result, if false, determines that the <code>bodyAction</code> should continue to be performed. It is the (optional) third owned <code>parameter</code> of the <code>WhileLoopActionUsage</code>.</p> \n";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref whileArgument: Expression [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "whileLoopAction";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Expression</code> whose result, if true, determines that the <code>bodyAction</code> should continue to be performed. It is the first owned <code>parameter</code> of the <code>WhileLoopActionUsage</code>.</p> \n";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
}
