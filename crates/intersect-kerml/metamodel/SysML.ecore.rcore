      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>VerificationCaseUsages</code> that are <code>nestedUsages</code> of this <code>Usage</code>.</p> \n";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.163/@eStructuralFeatures.10";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref nestedView: ViewUsage [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "viewOwningUsage";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>ViewUsages</code> that are <code>nestedUsages</code> of this <code>Usage</code>.</p> \n";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.163/@eStructuralFeatures.20";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref nestedViewpoint: ViewpointUsage [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "viewpointOwningUsage";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>ViewpointUsages</code> that are <code>nestedUsages</code> of this <code>Usage</code>.</p> \n";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.163/@eStructuralFeatures.24";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref owningDefinition: Definition [0,1] unordered derived transient volatile opposite external "#//@eClassifiers.44/@eStructuralFeatures.24"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Definition</code> that owns this <code>Usage</code> (if any).</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.58/@eStructuralFeatures.23";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref owningUsage: Usage [0,1] unordered derived transient volatile opposite external "#//@eClassifiers.163/@eStructuralFeatures.27"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Usage</code> in which this <code>Usage</code> is nested (if any).</p>";
      }
