    ref usage: Usage [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "featuringDefinition";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Usages</code> that are <code>features</code> of this <code>Definition</code> (not necessarily owned).</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.160/@eStructuralFeatures.3";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref variant: Usage [0,*] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "owningVariationDefinition";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Usages</code> which represent the variants of this <code>Definition</code> as a variation point <code>Definition</code>, if <code>isVariation</code> = true. If <code>isVariation = false</code>, the there must be no <code>variants</code>.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.107/@eStructuralFeatures.4";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref variantMembership: VariantMembership [0,*] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "owningVariationDefinition";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>ownedMemberships</code> of this <code>Definition</code> that are <code>VariantMemberships</code>. If <code>isVariation</code> = true, then this must be all <code>ownedMemberships</code> of the <code>Definition</code>. If <code>isVariation</code> = false, then <code>variantMembership</code>must be empty.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.107/@eStructuralFeatures.5";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class Dependency extends Relationship {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>Dependency</code> is a <code>Relationship</code> that indicates that one or more <code>client</code> <code>Elements</code> require one more <code>supplier</code> <code>Elements</code> for their complete specification. In general, this means that a change to one of the <code>supplier</code> <code>Elements</code> may necessitate a change to, or re-specification of, the <code>client</code> <code>Elements</code>.</p>\n\n<p>Note that a <code>Dependency</code> is entirely a model-level <code>Relationship</code>, without instance-level semantics.</p>";
    }
    ref client: Element [1,*]
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "clientDependency";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Element</code> or <code>Elements</code> dependent on the <code>supplier</code> <code>Elements</code>.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.129/@eStructuralFeatures.4";
      };
    ref supplier: Element [1,*]
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "supplierDependency";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Element</code> or <code>Elements</code> on which the <code>client</code> <code>Elements</code> depend in some respect.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.129/@eStructuralFeatures.5";
      };
  }
  class Differencing extends Relationship {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p><code>Differencing</code> is a <code>Relationship</code> that makes its <code>differencingType</code> one of the <code>differencingTypes</code> of its <code>typeDifferenced</code>.</p>\n";
    }
    ref differencingType: Type [1,1] unordered
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "differencedDifferencing";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p><code>Type</code> that partly determines interpretations of <code>typeDifferenced</code>, as described in <code>Type::differencingType</code>.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.129/@eStructuralFeatures.5";
      };
    ref typeDifferenced: Type [1,1] unordered derived transient volatile opposite external "#//@eClassifiers.160/@eStructuralFeatures.15"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p><code>Type</code> with interpretations partly determined by <code>differencingType</code>, as described in <code>Type::differencingType</code>.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.129/@eStructuralFeatures.4";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.129/@eStructuralFeatures.2";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class Disjoining extends Relationship {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>Disjoining</code> is a <code>Relationship</code> between <code>Types</code> asserted to have interpretations that are not shared (disjoint) between them, identified as <code>typeDisjoined</code> and <code>disjoiningType</code>. For example, a <code>Classifier</code> for mammals is disjoint from a <code>Classifier</code> for minerals, and a <code>Feature</code> for people&#39;s parents is disjoint from a <code>Feature</code> for their children.</p>\n";
    }
    ref disjoiningType: Type [1,1] unordered
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "disjoinedTypeDisjoining";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p><code>Type</code> asserted to be disjoint with the <code>typeDisjoined</code>.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.129/@eStructuralFeatures.5";
      };
    ref owningType: Type [0,1] unordered derived transient volatile opposite external "#//@eClassifiers.160/@eStructuralFeatures.16"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>A <code>typeDisjoined</code> that is also an <code>owningRelatedElement</code>.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.129/@eStructuralFeatures.2";
        reference "#//@eClassifiers.47/@eStructuralFeatures.2";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref typeDisjoined: Type [1,1] unordered
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "disjoiningTypeDisjoining";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p><code>Type</code> asserted to be disjoint with the <code>disjoiningType</code>.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.129/@eStructuralFeatures.4";
      };
  }
  class Documentation extends Comment {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p><code>Documentation</code> is a <code>Comment</code> that specifically documents a <code>documentedElement</code>, which must be its <code>owner</code>.</p>\n";
    }
    ref documentedElement: Element [1,1] unordered derived transient volatile opposite external "#//@eClassifiers.49/@eStructuralFeatures.3"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Element</code> that is documented by this <code>Documentation</code>.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.8/@eStructuralFeatures.0";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.49/@eStructuralFeatures.11";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  abstract class Element {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>An <code>Element</code> is a constituent of a model that is uniquely identified relative to all other <code>Elements</code>. It can have <code>Relationships</code> with other <code>Elements</code>. Some of these <code>Relationships</code> might imply ownership of other <code>Elements</code>, which means that if an <code>Element</code> is deleted from a model, then so are all the <code>Elements</code> that it owns.</p>\n\nownedElement = ownedRelationship.ownedRelatedElement\nowner = owningRelationship.owningRelatedElement\nqualifiedName =\n    if owningNamespace = null then null\n    else if name <> null and \n        owningNamespace.ownedMember->\n        select(m | m.name = name).indexOf(self) <> 1 then null\n    else if owningNamespace.owner = null then escapedName()\n    else if owningNamespace.qualifiedName = null or \n            escapedName() = null then null\n    else owningNamespace.qualifiedName + '::' + escapedName()\n    endif endif endif endif\ndocumentation = ownedElement->selectByKind(Documentation)\nownedAnnotation = ownedRelationship->\n    selectByKind(Annotation)->\n    select(a | a.annotatedElement = self)\nname = effectiveName()\nownedRelationship->exists(isImplied) implies isImpliedIncluded\nisLibraryElement = libraryNamespace() <> null\n\nshortName = effectiveShortName()\nowningNamespace =\n    if owningMembership = null then null\n    else owningMembership.membershipOwningNamespace\n    endif\ntextualRepresentation = ownedElement->selectByKind(TextualRepresentation)";
    }
    op effectiveName() -> EString [0,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Return an effective <code>name</code> for this <code>Element</code>. By default this is the same as its <code>declaredName</code>.</p>\ndeclaredName";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op effectiveShortName() -> EString [0,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Return an effective <code>shortName</code> for this <code>Element</code>. By default this is the same as its <code>declaredShortName</code>.</p>\ndeclaredShortName";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op escapedName() -> EString [0,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Return <code>name</code>, if that is not null, otherwise the <code>shortName</code>, if that is not null, otherwise null. If the returned value is non-null, it is returned as-is if it has the form of a basic name, or, otherwise, represented as a restricted name according to the lexical structure of the KerML textual notation (i.e., surrounded by single quote characters and with special characters escaped).</p>";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op libraryNamespace() -> Namespace [0,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>By default, return the library Namespace of the <code>owningRelationship</code> of this Element, if it has one.</p>\nif owningRelationship <> null then owningRelationship.libraryNamespace()\nelse null endif";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op path() -> EString [1,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Return a unique description of the location of this <code>Element</code> in the containment structure rooted in a root <code>Namespace</code>. If the <code>Element</code> has a non-null <code>qualifiedName</code>, then return that. Otherwise, if it has an <code>owningRelationship</code>, then return the string constructed by appending to the <code>path</code> of it's <code>owningRelationship</code> the character <code>/</code> followed by the string representation of its position in the list of <code>ownedRelatedElements</code> of the <code>owningRelationship</code> (indexed starting at 1). Otherwise, return the empty string.</p>\n\n<p>(Note that this operation is overridden for <code>Relationships</code> to use <code>owningRelatedElement</code> when appropriate.)</p>\nif qualifiedName <> null then qualifiedName\nelse if owningRelationship <> null then\n    owningRelationship.path() + '/' + \n    owningRelationship.ownedRelatedElement->indexOf(self).toString()\n    -- A position index shall be converted to a decimal string representation \n    -- consisting of only decimal digits, with no sign, leading zeros or leading \n    -- or trailing whitespace.\nelse ''\nendif endif";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    attr aliasIds: EString [0,*]
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Various alternative identifiers for this Element. Generally, these will be set by tools.</p>";
      };
    attr declaredName: EString [0,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The declared name of this <code>Element</code>.</p>\n";
      };
    attr declaredShortName: EString [0,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>An optional alternative name for the <code>Element</code> that is intended to be shorter or in some way more succinct than its primary <code>name</code>. It may act as a modeler-specified identifier for the <code>Element</code>, though it is then the responsibility of the modeler to maintain the uniqueness of this identifier within a model or relative to some other context.</p> \n";
      };
    ref documentation: Documentation [0,*] derived transient volatile opposite external "#//@eClassifiers.48/@eStructuralFeatures.0"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The Documentation owned by this Element.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.49/@eStructuralFeatures.9";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    attr elementId: EString [1,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The globally unique identifier for this Element. This is intended to be set by tooling, and it must not change during the lifetime of the Element.</p>";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    attr isImpliedIncluded: EBoolean [1,1] unordered default "false"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Whether all necessary implied Relationships have been included in the <code>ownedRelationships</code> of this Element. This property may be true, even if there are not actually any <code>ownedRelationships</code> with <code>isImplied = true</code>, meaning that no such Relationships are actually implied for this Element. However, if it is false, then <code>ownedRelationships</code> may <em>not</em> contain any implied Relationships. That is, either <em>all</em> required implied Relationships must be included, or none of them.</p>";
      };
    attr isLibraryElement: EBoolean [1,1] unordered derived transient volatile
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Whether this Element is contained in the ownership tree of a library model.</p>";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    attr name: EString [0,1] unordered derived transient volatile
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The name to be used for this <code>Element</code> during name resolution within its <code>owningNamespace</code>. This is derived using the <code>effectiveName()</code> operation. By default, it is the same as the <code>declaredName</code>, but this is overridden for certain kinds of <code>Elements</code> to compute a <code>name</code> even when the <code>declaredName</code> is null.</p>";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref ownedAnnotation: Annotation [0,*] derived transient volatile opposite external "#//@eClassifiers.9/@eStructuralFeatures.3"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>ownedRelationships</code> of this <code>Element</code> that are <code>Annotations</code>, for which this <code>Element</code> is the <code>annotatedElement</code>.</code>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.49/@eStructuralFeatures.10";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref ownedElement: Element [0,*] derived transient volatile opposite external "#//@eClassifiers.49/@eStructuralFeatures.11"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The Elements owned by this Element, derived as the <tt>ownedRelatedElements</tt> of the <tt>ownedRelationships</tt> of this Element.</p>\n";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref ownedRelationship: Relationship [0,*] containment opposite external "#//@eClassifiers.129/@eStructuralFeatures.2"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The Relationships for which this Element is the <tt>owningRelatedElement</tt>.</p>";
      };
    ref owner: Element [0,1] unordered derived transient volatile opposite external "#//@eClassifiers.49/@eStructuralFeatures.9"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The owner of this Element, derived as the <code>owningRelatedElement</code> of the <code>owningRelationship</code> of this Element, if any.</p>";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref owningMembership: OwningMembership [0,1] unordered derived transient volatile opposite external "#//@eClassifiers.115/@eStructuralFeatures.0"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>owningRelationship</code> of this <code>Element</code>, if that <code>Relationship</code> is a <code>Membership</code>.</p>\n";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.49/@eStructuralFeatures.14";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref owningNamespace: Namespace [0,1] unordered derived transient volatile opposite external "#//@eClassifiers.107/@eStructuralFeatures.4"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Namespace</code> that owns this <code>Element</code>, which is the <code>membershipOwningNamespace</code> of the <code>owningMembership</code> of this <code>Element</code>, if any.</p>\n";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref owningRelationship: Relationship [0,1] unordered opposite external "#//@eClassifiers.129/@eStructuralFeatures.1"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The Relationship for which this Element is an <tt>ownedRelatedElement</tt>, if any.</p>\n";
      };
    attr qualifiedName: EString [0,1] unordered derived transient volatile
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The full ownership-qualified name of this <code>Element</code>, represented in a form that is valid according to the KerML textual concrete syntax for qualified names (including use of unrestricted name notation and escaped characters, as necessary). The <code>qualifiedName</code> is null if this <code>Element</code> has no <code>owningNamespace</code> or if there is not a complete ownership chain of named <code>Namespaces</code> from a root <code>Namespace</code> to this <code>Element</code>. If the <code>owningNamespace</code> has other <code>Elements</code> with the same name as this one, then the <code>qualifiedName</code> is null for all such <code>Elements</code> other than the first.</p>";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    attr shortName: EString [0,1] unordered derived transient volatile
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The short name to be used for this <code>Element</code> during name resolution within its <code>owningNamespace</code>. This is derived using the <code>effectiveShortName()</code> operation. By default, it is the same as the <code>declaredShortName</code>, but this is overridden for certain kinds of <code>Elements</code> to compute a <code>shortName</code> even when the <code>declaredName</code> is null.</p>";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref textualRepresentation: TextualRepresentation [0,*] derived transient volatile opposite external "#//@eClassifiers.156/@eStructuralFeatures.2"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>TextualRepresentations</code> that annotate this <code>Element</code>.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.49/@eStructuralFeatures.9";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class ElementFilterMembership extends OwningMembership {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p><code>ElementFilterMembership</code> is a <code>Membership</code> between a <code>Namespace</code> and a model-level evaluable <code><em>Boolean</em></code>-valued <code>Expression</code>, asserting that imported <code>members</code> of the <code>Namespace</code> should be filtered using the <code>condition</code> <code>Expression</code>. A general <code>Namespace</code> does not define any specific filtering behavior, but such behavior may be defined for various specialized kinds of <code>Namespaces</code>.</p>\n\ncondition.isModelLevelEvaluable\ncondition.result.specializesFromLibrary('ScalarValues::Boolean')";
    }
    ref condition: Expression [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "owningFilter";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The model-level evaluable <code>Boolean</code>-valued <code>Expression</code> used to filter the imported <code>members</code> of the <code>membershipOwningNamespace</code> of this <code>ElementFilterMembership</code>.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.115/@eStructuralFeatures.0";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class EndFeatureMembership extends FeatureMembership {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p><code>EndFeatureMembership</code> is a <code>FeatureMembership</code> that requires its <code>memberFeature</code> be owned and have <code>isEnd = true</code>.</p>\n\nownedMemberFeature.isEnd";
    }
  }
  class EnumerationDefinition extends AttributeDefinition {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>An <code>EnumerationDefinition</code> is an <code>AttributeDefinition</code> all of whose instances are given by an explicit list of <code>enumeratedValues</code>. This is realized by requiring that the <code>EnumerationDefinition</code> have <code>isVariation = true</code>, with the <code>enumeratedValues</code> being its <code>variants</code>.</p> \nisVariation";
    }
    ref enumeratedValue: EnumerationUsage [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "owningEnumerationDefinition";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p><code>EnumerationUsages</code> of this <code>EnumerationDefinition</code>that have distinct, fixed values. Each <code>enumeratedValue</code> specifies one of the allowed instances of the <code>EnumerationDefinition</code>.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.44/@eStructuralFeatures.30";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class EnumerationUsage extends AttributeUsage {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>An <code>EnumerationUsage</code> is an <code>AttributeUsage</code> whose <code>attributeDefinition</code> is an <code>EnumerationDefinition</code>.</p>";
    }
    ref enumerationDefinition: EnumerationDefinition [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "definedEnumeration";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The single EnumerationDefinition that is the type of this EnumerationUsage.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.15/@eStructuralFeatures.0";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class EventOccurrenceUsage extends OccurrenceUsage {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>An <code>EventOccurrenceUsage</code> is an <code>OccurrenceUsage</code> that represents another <code>OccurrenceUsage</code> occurring as a <code><em>suboccurrence</em></code> of the containing occurrence of the <code>EventOccurrenceUsage</code>. Unless it is the <code>EventOccurrenceUsage</code> itself, the referenced <code>OccurrenceUsage</code> is related to the <code>EventOccurrenceUsage</code> by a <code>ReferenceSubsetting</code> <code>Relationship</code>.</p>\n\n<p>If the <code>EventOccurrenceUsage</code> is owned by an <code>OccurrenceDefinition</code> or <code>OccurrenceUsage</code>, then it also subsets the <em><code>timeEnclosedOccurrences</code></em> property of the <code>Class</code> <em><code>Occurrence</code></em> from the Kernel Semantic Library model <em><code>Occurrences</code></em>.</p>\neventOccurrence =\n    if referencedFeatureTarget() = null then self\n    else if referencedFeatureTarget().oclIsKindOf(OccurrenceUsage) then\n        referencedFeatureTarget().oclAsType(OccurrenceUsage)\n    else null\n    endif endif\nreferencedFeatureTarget() <> null implies\n    referencedFeatureTarget().oclIsKindOf(OccurrenceUsage)\nowningType <> null and\n(owningType.oclIsKindOf(OccurrenceDefinition) or\n owningType.oclIsKindOf(OccurrenceUsage)) implies\n    specializesFromLibrary('Occurrences::Occurrence::timeEnclosedOccurrences')\nisReference";
    }
    ref eventOccurrence: OccurrenceUsage [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "referencingOccurrence";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>OccurrenceUsage</code> referenced as an event by this <code>EventOccurrenceUsage</code>. It is the <code>referenceFeature</code> of the <code>ownedReferenceSubsetting</code> for the <code>EventOccurrenceUsage</code>, if there is one, and, otherwise, the <code>EventOccurrenceUsage</code> itself.</p>";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class ExhibitStateUsage extends StateUsage, PerformActionUsage {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>An <code>ExhibitStateUsage</code> is a <code>StateUsage</code> that represents the exhibiting of a <code>StateUsage</code>. Unless it is the <code>StateUsage</code> itself, the <code>StateUsage</code> to be exhibited is related to the <code>ExhibitStateUsage</code> by a <code>ReferenceSubsetting</code> <code>Relationship</code>. An <code>ExhibitStateUsage</code> is also a <code>PerformActionUsage</code>, with its <code>exhibitedState</code> as the <code>performedAction</code>.</p>\n\nowningType <> null and\n(owningType.oclIsKindOf(PartDefinition) or\n owningType.oclIsKindOf(PartUsage)) implies\n    specializesFromLibrary('Parts::Part::exhibitedStates')\nreferencedFeatureTarget() <> null implies\n    referencedFeatureTarget().oclIsKindOf(StateUsage)";
    }
    ref exhibitedState: StateUsage [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "exhibitingState";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>StateUsage</code> to be exhibited by the <code>ExhibitStateUsage</code>. It is the <code>performedAction</code> of the <code>ExhibitStateUsage</code> considered as a <code>PerformActionUsage</code>, which must be a <code>StateUsage</code>.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.121/@eStructuralFeatures.0";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  abstract class Expose extends Import {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>An <code>Expose</code> is an <code>Import</code> of <code>Memberships</code> into a <code>ViewUsage</code> that provide the <code>Elements</code> to be included in a view. Visibility is always ignored for an <code>Expose</code> (i.e., <code>isImportAll = true</code>).</p>\nisImportAll\nimportOwningNamespace.oclIsType(ViewUsage)\nvisibility = VisibilityKind::protected";
    }
  }
  class Expression extends Step {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>An <code>Expression</code> is a <code>Step</code> that is typed by a <code>Function</code>. An <code>Expression</code> that also has a <code>Function</code> as its <code>featuringType</code> is a computational step within that <code>Function</code>. An <code>Expression</code> always has a single <code>result</code> parameter, which redefines the <code>result</code> parameter of its defining <code>function</code>. This allows <code>Expressions</code> to be interconnected in tree structures, in which inputs to each <code>Expression</code> in the tree are determined as the results of other <code>Expression</code> in the tree.</p>\n\nisModelLevelEvaluable = modelLevelEvaluable(Set(Element){})\nspecializesFromLibrary('Performances::evaluations')\nowningMembership <> null and \nowningMembership.oclIsKindOf(FeatureValue) implies\n    let featureWithValue : Feature = \n        owningMembership.oclAsType(FeatureValue).featureWithValue in\n    featuringType = featureWithValue.featuringType\nownedMembership.selectByKind(ResultExpressionMembership)->\n    forAll(mem | ownedFeature.selectByKind(BindingConnector)->\n        exists(binding |\n            binding.relatedFeature->includes(result) and\n            binding.relatedFeature->includes(mem.ownedResultExpression.result)))\nresult =\n    let resultParams : Sequence(Feature) =\n        featureMemberships->\n            selectByKind(ReturnParameterMembership).\n            ownedMemberParameter in\n    if resultParams->notEmpty() then resultParams->first()\n    else null\n    endif\n\nfeatureMembership->\n    selectByKind(ReturnParameterMembership)->\n    size() = 1\nmembership->selectByKind(ResultExpressionMembership)->size() <= 1";
    }
    op checkCondition(target: Element [1,1] unordered) -> EBoolean [1,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Model-level evaluate this <code>Expression</code> with the given <code>target</code>. If the result is a <code>LiteralBoolean</code>, return its <code>value</code>. Otherwise return <code>false</code>.</p>\n\nlet results: Sequence(Element) = evaluate(target) in\n    result->size() = 1 and\n    results->first().oclIsKindOf(LiteralBoolean) and \n    results->first().oclAsType(LiteralBoolean).value";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op evaluate(target: Element [1,1] unordered) -> Element [0,*] nonunique
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>If this <code>Expression</code> <code>isModelLevelEvaluable</code>, then evaluate it using the <code>target</code> as the context <code>Element</code> for resolving <code>Feature</code> names and testing classification. The result is a collection of <code>Elements</code>, which, for a fully evaluable <code>Expression</code>, will be a <code>LiteralExpression</code> or a <code>Feature</code> that is not an <code>Expression</code>.</p>\nisModelLevelEvaluable\nlet resultExprs : Sequence(Expression) =\n    ownedFeatureMembership->\n        selectByKind(ResultExpressionMembership).\n        ownedResultExpression in\nif resultExpr->isEmpty() then Sequence{}\nelse resultExprs->first().evaluate(target)\nendif";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op modelLevelEvaluable(visited: Feature [0,*] unordered) -> EBoolean [1,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Return whether this <code>Expression</code> is model-level evaluable. The <code>visited</code> parameter is used to track possible circular <code>Feature</code> references made from <code>FeatureReferenceExpressions</code> (see the redefinition of this operation for <code>FeatureReferenceExpression</code>). Such circular references are not allowed in model-level evaluable expressions.</p>\n\n<p>An <code>Expression</code> that is not otherwise specialized is model-level evaluable if it has no (non-implied) <code>ownedSpecializations</code> and all its <code>ownedFeatures</code> are either <code>in</code> parameters, the <code>result</code> <code>parameter</code> or a result <code>Expression</code> owned via a <code>ResultExpressionMembership</code>. The <code>parameters</code>  must not have any <code>ownedFeatures</code> or a <code>FeatureValue</code>, and the result <code>Expression</code> must be model-level evaluable.</p>\nownedSpecialization->forAll(isImplied) and \nownedFeature->forAll(f |\n    (directionOf(f) = FeatureDirectionKind::_'in' or f = result) and\n        f.ownedFeature->isEmpty() and f.valuation = null or\n    f.owningFeatureMembership.oclIsKindOf(ResultExpressionMembership) and\n        f.oclAsType(Expression).modelLevelEvaluable(visited)\n    ";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref function: Function [0,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "typedExpression";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Function</code> that types this <code>Expression</code>.</p>\n\n<p>This is the Function that types the Expression.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.146/@eStructuralFeatures.0";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    attr isModelLevelEvaluable: EBoolean [1,1] unordered derived transient volatile
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Whether this <code>Expression</code> meets the constraints necessary to be evaluated at <em>model level</em>, that is, using metadata within the model.</p>";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref result: Feature [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "computingExpression";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p><p>An <code>output</code> <code>parameter</code> of the <code>Expression</code> whose value is the result of the <code>Expression</code>. The result of an <code>Expression</code> is either inherited from its <code>function</code> or it is related to the <code>Expression</code> via a <code>ReturnParameterMembership</code>, in which case it redefines the <code>result</code> <code>parameter</code> of its <code>function</code>.</p>\n";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.160/@eStructuralFeatures.13";
        reference "#//@eClassifiers.146/@eStructuralFeatures.1";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class Feature extends Type {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>Feature</code> is a <code>Type</code> that classifies relations between multiple things (in the universe). The domain of the relation is the intersection of the <code>featuringTypes</code> of the <code>Feature</code>. (The domain of a <code>Feature</code> with no <code>featuringTyps</code> is implicitly the most general <code>Type</code> <em><code>Base::Anything</code></em> from the Kernel Semantic Library.) The co-domain of the relation is the intersection of the <code>types</code> of the <code>Feature</code>.\n\n<p>In the simplest cases, the <code>featuringTypes</code> and <code>types</code> are <code>Classifiers</code> and the <code>Feature</code> relates two things, one from the domain and one from the range. Examples include cars paired with wheels, people paired with other people, and cars paired with numbers representing the car length.</p>\n\n<p>Since <code>Features</code> are <code>Types</code>, their <code>featuringTypes</code> and <code>types</code> can be <code>Features</code>. In this case, the <code>Feature</code> effectively classifies relations between relations, which can be interpreted as the sequence of things related by the domain <code>Feature</code> concatenated with the sequence of things related by the co-domain <code>Feature</code>.</p>\n\n<p>The <em>values</em> of a <code>Feature</code> for a given instance of its domain are all the instances of its co-domain that are related to that domain instance by the <code>Feature</code>. The values of a <code>Feature</code> with <code>chainingFeatures</code> are the same as values of the last <code>Feature</code> in the chain, which can be found by starting with values of the first <code>Feature</code>, then using those values as domain instances to obtain valus of the second <code>Feature</code>, and so on, to values of the last <code>Feature</code>.</p>\n\nownedRedefinition = ownedSubsetting->selectByKind(Redefinition)\nownedTypeFeaturing = ownedRelationship->selectByKind(TypeFeaturing)->\n    select(tf | tf.featureOfType = self)\nownedSubsetting = ownedSpecialization->selectByKind(Subsetting)\nownedTyping = ownedGeneralization->selectByKind(FeatureTyping)\ntype = \n    let types : OrderedSet(Types) = OrderedSet{self}->\n        -- Note: The closure operation automatically handles circular relationships.\n        closure(typingFeatures()).typing.type->asOrderedSet() in\n    types->reject(t1 | types->exist(t2 | t2 <> t1 and t2.specializes(t1)))\nmultiplicity <> null implies multiplicity.featuringType = featuringType \nspecializesFromLibrary('Base::things')\nchainingFeature->excludes(self)\nownedFeatureChaining = ownedRelationship->selectByKind(FeatureChaining)\nchainingFeature = ownedFeatureChaining.chainingFeature\nchainingFeature->size() <> 1\nisEnd and owningType <> null implies\n    let i : Integer = \n        owningType.ownedEndFeature->indexOf(self) in\n    owningType.ownedSpecialization.general->\n        forAll(supertype |\n             supertype.endFeature->size() >= i implies\n                redefines(supertype.endFeature->at(i))\ndirection = null and\nownedSpecializations->forAll(isImplied) implies\n    ownedMembership->\n        selectByKind(FeatureValue)->\n        forAll(fv | specializes(fv.value.result))\nisEnd and owningType <> null and\n(owningType.oclIsKindOf(Association) or\n owningType.oclIsKindOf(Connector)) implies\n    specializesFromLibrary('Links::Link::participant')\nisComposite and\nownedTyping.type->includes(oclIsKindOf(Structure)) and\nowningType <> null and\n(owningType.oclIsKindOf(Structure) or\n owningType.type->includes(oclIsKindOf(Structure))) implies\n    specializesFromLibrary('Occurrence::Occurrence::suboccurrences')\nownedTyping.type->exists(selectByKind(Class)) implies\n    specializesFromLibrary('Occurrences::occurrences')\nisComposite and\nownedTyping.type->includes(oclIsKindOf(Class)) and\nowningType <> null and\n(owningType.oclIsKindOf(Class) or\n owningType.oclIsKindOf(Feature) and\n    owningType.oclAsType(Feature).type->\n        exists(oclIsKindOf(Class))) implies\n    specializesFromLibrary('Occurrence::Occurrence::suboccurrences')\nownedTyping.type->exists(selectByKind(DataType)) implies\n    specializesFromLibrary('Base::dataValues')\nowningType <> null and\nowningType.oclIsKindOf(FlowEnd) and\nowningType.ownedFeature->at(1) = self implies\n    let flowType : Type = owningType.owningType in\n    flowType <> null implies\n        let i : Integer = \n            flowType.ownedFeature.indexOf(owningType) in\n        (i = 1 implies \n            redefinesFromLibrary('Transfers::Transfer::source::sourceOutput')) and\n        (i = 2 implies\n            redefinesFromLibrary('Transfers::Transfer::target::targetInput'))\n                 \nowningType <> null and\n(owningType.oclIsKindOf(Behavior) or\n owningType.oclIsKindOf(Step) and\n    (owningType.oclIsKindOf(InvocationExpression) implies\n        not ownedRedefinition->exists(not isImplied)))\nimplies\n    let ownerParameters : Sequence(Feature) =\n        owningType.ownedFeature->select(direction <> null)->\n            reject(owningFeatureMembership.\n                oclIsKindOf(ReturnParameterMembership)) in\n    ownerParameters->includes(self) implies\n        let i : Integer = ownerParameters.indexof(self) in\n        owningType.ownedSpecialization.general->\n            forAll(supertype |\n                supertype.oclIsKindOf(Behavior) or \n                    supertype.oclIsKindOf(Step) \n                implies\n                    let ownedParameters : Sequence(Feature) =\n                        supertype.ownedFeature->select(direction <> null)->\n                            reject(owningFeatureMembership.\n                                oclIsKindOf(ReturnParameterMembership)) in\n                    ownedParameters->size() >= i implies\n                        redefines(ownedParameters->at(i)))\nownedTyping.type->exists(selectByKind(Structure)) implies\n    specializesFromLibrary('Objects::objects')\nowningType <> null and\n(owningType.oclIsKindOf(Function) and\n    self = owningType.oclAsType(Function).result or\n owningType.oclIsKindOf(Expression) and\n    self = owningType.oclAsType(Expression).result) implies\n    owningType.ownedSpecialization.general->\n        select(oclIsKindOf(Function) or oclIsKindOf(Expression))->\n        forAll(supertype |\n            redefines(\n                if superType.oclIsKindOf(Function) then\n                    superType.oclAsType(Function).result\n                else\n                    superType.oclAsType(Expression).result\n                endif)\nownedFeatureInverting = ownedRelationship->selectByKind(FeatureInverting)->\n    select(fi | fi.featureInverted = self)\nfeaturingType =\n    let featuringTypes : OrderedSet(Type) = \n        typeFeaturing.type->asOrderedSet() in\n    if chainingFeature->isEmpty() then featuringTypes\n    else\n        featuringTypes->\n            union(chainingFeature->first().featuringType)->\n            asOrderedSet()\n    endif\nownedReferenceSubsetting =\n    let referenceSubsettings : OrderedSet(ReferenceSubsetting) =\n        ownedSubsetting->selectByKind(ReferenceSubsetting) in\n    if referenceSubsettings->isEmpty() then null\n    else referenceSubsettings->first() endif\nownedSubsetting->selectByKind(ReferenceSubsetting)->size() <= 1\nSequence{2..chainingFeature->size()}->forAll(i |\n    chainingFeature->at(i).isFeaturedWithin(chainingFeature->at(i-1)))\n\nisPortion and\nownedTyping.type->includes(oclIsKindOf(Class)) and\nowningType <> null and\n(owningType.oclIsKindOf(Class) or\n owningType.oclIsKindOf(Feature) and\n    owningType.oclAsType(Feature).type->\n        exists(oclIsKindOf(Class))) implies\n    specializesFromLibrary('Occurrence::Occurrence::portions')\nfeatureTarget = if chainingFeature->isEmpty() then self else chainingFeature->last() endif\nownedCrossSubsetting =\n    let crossSubsettings: Sequence(CrossSubsetting) = \n        ownedSubsetting->selectByKind(CrossSubsetting) in\n    if crossSubsettings->isEmpty() then null\n    else crossSubsettings->first()\n    endif\nisEnd implies \n    multiplicities().allSuperTypes()->flatten()->\n    selectByKind(MultiplicityRange)->exists(hasBounds(1,1))\ncrossFeature <> null implies\n    crossFeature.type->asSet() = type->asSet()\nownedSubsetting->selectByKind(CrossSubsetting)->size() <= 1\ncrossFeature =\n    if ownedCrossSubsetting = null then null\n    else \n        let chainingFeatures: Sequence(Feature) = \n            ownedCrossSubsetting.crossedFeature.chainingFeature in\n        if chainingFeatures->size() < 2 then null\n        else chainingFeatures->at(2)\n    endif\nisOwnedCrossFeature() implies\n    owner.oclAsType(Feature).type->forAll(t | self.specializes(t))\nisOwnedCrossFeature() implies\n    ownedSubsetting.subsettedFeature->includesAll(\n        owner.oclAsType(Feature).ownedRedefinition.redefinedFeature->\n            select(crossFeature <> null).crossFeature)\ncrossFeature <> null implies\n    ownedRedefinition.redefinedFeature.crossFeature->\n            forAll(f | f <> null implies crossFeature.specializes(f))\nownedCrossFeature() <> null implies\n    crossFeature = ownedCrossFeature()\nisOwnedCrossFeature() implies\n    let otherEnds : OrderedSet(Feature) = \n        owner.oclAsType(Feature).owningType.endFeature->excluding(self) in\n    if (otherEnds->size() = 1) then\n        featuringType = otherEnds->first().type\n    else\n        featuringType->size() = 1 and\n        featuringType->first().isCartesianProduct() and\n        featuringType->first().asCartesianProduct() = otherEnds.type and\n        featuringType->first().allSupertypes()->includesAll(\n            owner.oclAsType(Feature).ownedRedefinition.redefinedFeature->\n               select(crossFeature() <> null).crossFeature().featuringType)      \n    endif\nisPortion implies not isVariable\nisEnd implied direction = null\nowningFeatureMembership <> null implies\n    featuringTypes->exists(t | isFeaturingType(t))\nisConstant implies isVariable\nisVariable implies\n    owningType <> null and \n    owningType.specializes('Occurrences::Occurrence')\nisEnd implies not (isDerived or isAbstract or isComposite or isPortion)\nisEnd and isVariable implies isConstant";
    }
    op allRedefinedFeatures() -> Feature [0,*] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Return this <code>Feature</code> and all the <code>Features</code> that are directly or indirectly <code>Redefined</code> by this <code>Feature</code>.</p>\nownedRedefinition.redefinedFeature->\n    closure(ownedRedefinition.redefinedFeature)->\n    asOrderedSet()->prepend(self)\n";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op asCartesianProduct() -> Type [0,*] nonunique
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>If <code>isCartesianProduct</code> is true, then return the list of <code>Types</code> whose Cartesian product can be represented by this <code>Feature</code>. (If <code>isCartesianProduct</code> is not true, the operation will still return a valid value, it will just not represent anything useful.)</p>\nfeaturingType->select(t | t.owner <> self)->\n    union(featuringType->select(t | t.owner = self)->\n        selectByKind(Feature).asCartesianProduct())->\n    union(type)";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op canAccess(feature: Feature [1,1] unordered) -> EBoolean [1,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>A <code>Feature</code> can access another <code>feature</code> if the other <code>feature</code> is featured within one of the direct or indirect <code>featuringTypes</code> of this <code>Feature</code>.</p>\nlet anythingType: Element =\n    subsettingFeature.resolveGlobal('Base::Anything').memberElement in\nlet allFeaturingTypes : Sequence(Type) =\n    featuringTypes->closure(t |\n        if not t.oclIsKindOf(Feature) then Sequence{}\n        else\n            let featuringTypes : OrderedSet(Type) = t.oclAsType(Feature).featuringType in\n            if featuringTypes->isEmpty() then Sequence{anythingType}\n            else featuringTypes\n            endif \n        endif) in\nallFeaturingTypes->exists(t | feature.isFeaturedWithin(t))";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op directionFor(type: Type [1,1] unordered) -> FeatureDirectionKind [0,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Return the <code>directionOf</code> this <code>Feature</code> relative to the given <code>type</code>.</p>\ntype.directionOf(self)";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op isCartesianProduct() -> EBoolean [1,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Check whether this <code>Feature</code> can be used to represent a Cartesian product of <code>Types</code>.</p>\ntype->size() = 1 and\nfeaturingType.size() = 1 and\n(featuringType.first().owner = self implies\n    featuringType.first().oclIsKindOf(Feature) and\n    featuringType.first().oclAsType(Feature).isCartesianProduct())";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op isFeaturedWithin(type: Type [0,1] unordered) -> EBoolean [1,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Return if the <code>featuringTypes</code> of this <code>Feature</code> are compatible with the given <code>type</code>. If <code>type</code> is null, then check if this <code>Feature</code> is explicitly or implicitly featured by <em><code>Base::Anything</code></em>. If this <code>Feature</code> has <code>isVariable = true</code>, then also consider it to be featured within its <code>owningType</code>. If this <code>Feature</code> is a feature chain whose first <code>chainingFeature</code> has <code>isVariable = true</code>, then also consider it to be featured within the <code>owningType</code> of its first <code>chainingFeature</code>.</p>\nif type = null then\n    featuringType->forAll(f | f = resolveGlobal('Base::Anything').memberElement)\nelse\n    featuringType->forAll(f | type.isCompatibleWith(f)) or\n    isVariable and type.specializes(owningType) or\n    chainingFeature->notEmpty() and chainingFeature->first().isVariable and\n        type.specializes(chainingFeature->first().owningType)\nendif";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op isFeaturingType(type: Type [1,1] unordered) -> EBoolean [1,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Return whether the given <code>type</code> must be a <code>featuringType</code> of this <code>Feature</code>. If this <code>Feature</code> has <code>isVariable = false</code>, then return true if the <code>type</code> is the <code>owningType</code> of the <code>Feature</code>. If <code>isVariable = true</code>, then return true if the <code>type</code> is a <code>Feature</code> representing the <em><code>snapshots</code></em> of the <code>owningType</code> of this <code>Feature</code>.</p>\nowningType <> null and\nif not isVariable then type = owningType\nelse if owningType = resolveGlobal('Occurrences::Occurrence').memberElement then\n    type = resolveGlobal('Occurrences::Occurrence::snapshots').memberElement \nelse \n    type.oclIsKindOf(Feature) and\n    let feature : Feature = type.oclAsType(Feature) in\n    feature.featuringType->includes(owningType) and\n    feature.redefinesFromLibrary('Occurrences::Occurrence::snapshots')\nendif\n";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op isOwnedCrossFeature() -> EBoolean [1,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Return whether this <code>Feature</code> is an owned cross <code>Feature</code> of an end <code>Feature</code>.</p>\nowningNamespace <> null and \nowningNamespace.oclIsKindOf(Feature) and \nowningNamespace.oclAsType(Feature).ownedCrossFeature() = self";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op namingFeature() -> Feature [0,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>By default, the naming <code>Feature</code> of a <code>Feature</code> is given by its first <code>redefinedFeature</code> of its first <code>ownedRedefinition</code>, if any.</p>\nif ownedRedefinition->isEmpty() then\n    null\nelse\n    ownedRedefinition->at(1).redefinedFeature\nendif";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op ownedCrossFeature() -> Feature [0,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>If this <code>Feature</code> is an end <code>Feature</code> of its <code>owningType</code>, then return the first <code>ownedMember</code> of the <code>Feature</code> that is a <code>Feature</code>, but <em>not</em> a <code>Multiplicity</code>, <code>MetadataFeature</code>, or <code>BindingConnector</code>, and whose <code>owningMembership</code> is <em>not</em> a <code>FeatureMembership</code> or <code>FeatureValue</code>. If this exists, it is the <code>crossFeature</code> of the end <code>Feature</code>.</p>\nif not isEnd or owningType = null then null\nelse\n    let ownedMemberFeatures: Sequence(Feature) =\n        ownedMember->selectByKind(Feature)->\n            reject(oclIsKindOf(Multiplicity) or\n                   oclIsKindOf(MetadataFeature) or\n                   oclIsKindOf(BindingConnector))->\n            reject(owningMembership.oclIsKindOf(FeatureMembership) or\n                   owningMembership.oclIsKindOf(FeatureValue)) in\n    if ownedMemberFeatures.isEmpty() then null\n    else ownedMemberFeatures->first()\n    endif\nendif\n";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op redefines(redefinedFeature: Feature [1,1] unordered) -> EBoolean [1,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Check whether this <code>Feature</code> <em>directly</em> redefines the given <code>redefinedFeature</code>.</p>\nownedRedefinition.redefinedFeature->includes(redefinedFeature)";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op redefinesFromLibrary(libraryFeatureName: EString [1,1] unordered) -> EBoolean [1,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Check whether this <code>Feature</code> <em>directly</em> redefines the named library <code>Feature</code>. <code>libraryFeatureName</code> must conform to the syntax of a KerML qualified name and must resolve to a <code>Feature</code> in global scope.</p>\nlet mem: Membership = resolveGlobal(libraryFeatureName) in\nmem <> null and mem.memberElement.oclIsKindOf(Feature) and\nredefines(mem.memberElement.oclAsType(Feature))";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op subsetsChain(first: Feature [1,1] unordered, second: Feature [1,1] unordered) -> EBoolean [1,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Check whether this <code>Feature</code> directly or indirectly specializes a <code>Feature</code> whose last two <code>chainingFeatures</code> are the given <code>Features</code> <code>first</code> and <code>second</code>.</p>\nallSuperTypes()->selectAsKind(Feature)->\n    exists(f | let n: Integer = f.chainingFeature->size() in\n        n >= 2 and\n        f.chainingFeature->at(n-1) = first and\n        f.chainingFeature->at(n) = second)";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op typingFeatures() -> Feature [0,*] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Return the <code>Features</code> used to determine the <code>types</code> of this <code>Feature</code> (other than this <code>Feature</code> itself). If this <code>Feature</code> is <em>not</em> conjugated, then the <code>typingFeatures</code> consist of all subsetted <code>Features</code>, <em>except</em> from <code>CrossSubsetting</code>, and the last <code>chainingFeature</code> (if any). If this <code>Feature</code> <em>is</em> conjugated, then the <code>typingFeatures</code> are only its <code>originalType</code> (if the <code>originalType</code> is a <code>Feature</code>).</p>\n\n<p><strong>Note.</strong> <code>CrossSubsetting</code> is excluded from the determination of the <code>type</code> of a <code>Feature</code> in order to avoid circularity in the construction of implied <code>CrossSubsetting</code> relationships. The <code>validateFeatureCrossFeatureType</code> requires that the <code>crossFeature</code> of a <code>Feature</code> have the same <code>type</code> as the <code>Feature</code>.</p>\n\nif not isConjugated then\n    let subsettedFeatures : OrderedSet(Feature) = \n        subsetting->reject(s | s.oclIsKindOf(CrossSubsetting)).subsettedFeatures in \n    if chainingFeature->isEmpty() or\n       subsettedFeature->includes(chainingFeature->last())\n    then subsettedFeatures\n    else subsettedFeatures->append(chainingFeature->last())\n    endif\nelse if conjugator.originalType.oclIsKindOf(Feature) then\n    OrderedSet{conjugator.originalType.oclAsType(Feature)}\nelse OrderedSet{}\nendif endif";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref chainingFeature: Feature [0,*] nonunique derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "chainedFeature";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Feature</code> that are chained together to determine the values of this <code>Feature</code>, derived from the <code>chainingFeatures</code> of the <code>ownedFeatureChainings</code> of this <code>Feature</code>, in the same order. The values of a <code>Feature</code> with <code>chainingFeatures</code> are the same as values of the last <code>Feature</code> in the chain, which can be found by starting with the values of the first <code>Feature</code> (for each instance of the domain of the original <code>Feature</code>), then using each of those as domain instances to find the values of the second <code>Feature</code> in chainingFeatures, and so on, to values of the last <code>Feature</code>.</p>";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref crossFeature: Feature [0,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "featureCrossing";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The second <code>chainingFeature</code> of the <code>crossedFeature</code> of the <code>ownedCrossSubsetting</code> of this <code>Feature</code>, if it has one. Semantically, the values of the <code>crossFeature</code> of an end <code>Feature</code> must include all values of the end <code>Feature</code> obtained when navigating from values of the other end <code>Features</code> of the same <code>owningType</code>.\n</p>";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    attr direction: FeatureDirectionKind [0,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Indicates how values of this <code>Feature</code> are determined or used (as specified for the <code>FeatureDirectionKind</code>).</p>\n";
      };
    ref endOwningType: Type [0,1] unordered derived transient volatile opposite external "#//@eClassifiers.160/@eStructuralFeatures.17"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Type</code> that is related to this <code>Feature</code> by an <code>EndFeatureMembership</code> in which the <code>Feature</code> is an <code>ownedMemberFeature</code>.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.58/@eStructuralFeatures.23";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref featureTarget: Feature [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "baseFeature";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The last of the <code>chainingFeatures</code> of this <code>Feature</code>, if it has any. Otherwise, this <code>Feature</code> itself.</p>";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref featuringType: Type [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "featureOfType";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p><code>Types</code> that feature this <code>Feature</code>, such that any instance in the domain of the <code>Feature</code> must be classified by all of these <code>Types</code>, including at least all the <code>featuringTypes</code> of its <code>typeFeaturings</code>.  If the <code>Feature</code> is chained, then the <code>featuringTypes</code> of the first <code>Feature</code> in the chain are also <code>featuringTypes</code> of the chained <code>Feature</code>.</p>";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    attr isComposite: EBoolean [1,1] unordered default "false"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Whether the <code>Feature</code> is a composite <code>feature</code> of its <code>featuringType</code>. If so, the values of the <code>Feature</code> cannot exist after its featuring instance no longer does and cannot be values of another composite feature that is not on the same featuring instance.</p>\n";
      };
    attr isConstant: EBoolean [1,1] unordered default "false"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>If <code>isVariable</code> is true, then whether the value of this <code>Feature</code> nevertheless does not change over all <code><em>snapshots</em></code> of its <code>owningType</code>.</p>\n";
      };
    attr isDerived: EBoolean [1,1] unordered default "false"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Whether the values of this <code>Feature</code> can always be computed from the values of other <code>Features</code>.</p>\n";
      };
    attr isEnd: EBoolean [1,1] unordered default "false"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Whether or not this <code>Feature</code> is an end <code>Feature</code>. An end <code>Feature</code> always has multiplicity 1, mapping each of its domain instances to a single co-domain instance. However, it may have a <code>crossFeature</code>, in which case values of the <code>crossFeature</code> must be the same as those found by navigation across instances of the <code>owningType</code> from values of other end <code>Features</code> to values of this Feature. If the <code>owningType</code> has <em>n</em> end <code>Features</code>, then the multiplicity, ordering, and uniqueness declared for the <code>crossFeature</code> of any one of these end <code>Features</code> constrains the cardinality, ordering, and uniqueness of the collection of values of that <code>Feature</code> reached by navigation when the values of the other <em>n-1</em> end <code>Features</code> are held fixed.</p>\n";
      };
    attr isOrdered: EBoolean [1,1] unordered default "false"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Whether an order exists for the values of this <code>Feature</code> or not.</p>";
      };
    attr isPortion: EBoolean [1,1] unordered default "false"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Whether the values of this <code>Feature</code> are contained in the space and time of instances of the domain of the <code>Feature</code> and represent the same thing as those instances.</p>\n";
      };
    attr isUnique: EBoolean [1,1] unordered default "true"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Whether or not values for this <code>Feature</code> must have no duplicates or not.</p>\n";
      };
    attr isVariable: EBoolean [1,1] unordered default "false"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Whether the value of this <code>Feature</code> might vary over time. That is, whether the <code>Feature</code> may have a different value for each <em><code>snapshot</code></em> of an <code>owningType</code> that is an <em><code>Occurrence</code></em>.</p>";
      };
    ref ownedCrossSubsetting: CrossSubsetting [0,1] unordered derived transient volatile opposite external "#//@eClassifiers.41/@eStructuralFeatures.1"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The one <code>ownedSubsetting</code> of this <code>Feature</code>, if any, that is a <code>CrossSubsetting}, for which the <code>Feature</code> is the <code>crossingFeature</code>.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.58/@eStructuralFeatures.19";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref ownedFeatureChaining: FeatureChaining [0,*] derived transient volatile opposite external "#//@eClassifiers.60/@eStructuralFeatures.1"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>ownedRelationships</code> of this <code>Feature</code> that are <code>FeatureChainings</code>, for which the <code>Feature</code> will be the <code>featureChained</code>.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.49/@eStructuralFeatures.10";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref ownedFeatureInverting: FeatureInverting [0,*] unordered derived transient volatile opposite external "#//@eClassifiers.61/@eStructuralFeatures.2"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>ownedRelationships</code> of this <code>Feature</code> that are <code>FeatureInvertings</code> and for which the <code>Feature</code> is the <code>featureInverted</code>.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.49/@eStructuralFeatures.10";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref ownedRedefinition: Redefinition [0,*] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "owningFeature";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>ownedSubsettings</code> of this <code>Feature</code> that are <code>Redefinitions</code>, for which the <code>Feature</code> is the <code>redefiningFeature</code>.</p>\n\n";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.58/@eStructuralFeatures.19";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref ownedReferenceSubsetting: ReferenceSubsetting [0,1] unordered derived transient volatile opposite external "#//@eClassifiers.127/@eStructuralFeatures.1"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The one <code>ownedSubsetting</code> of this <code>Feature</code>, if any, that is a <code>ReferenceSubsetting</code>, for which the <code>Feature</code> is the <code>referencingFeature</code>.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.58/@eStructuralFeatures.19";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref ownedSubsetting: Subsetting [0,*] unordered derived transient volatile opposite external "#//@eClassifiers.150/@eStructuralFeatures.0"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>ownedSpecializations</code> of this <code>Feature</code> that are <code>Subsettings</code>, for which the <code>Feature</code> is the <code>subsettingFeature</code>.</p>\n";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.160/@eStructuralFeatures.21";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref ownedTypeFeaturing: TypeFeaturing [0,*] derived transient volatile opposite external "#//@eClassifiers.161/@eStructuralFeatures.2"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>ownedRelationships</code> of this <code>Feature</code> that are <code>TypeFeaturings</code> and for which the <code>Feature</code> is the <code>featureOfType</code>.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.49/@eStructuralFeatures.10";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref ownedTyping: FeatureTyping [0,*] derived transient volatile opposite external "#//@eClassifiers.64/@eStructuralFeatures.0"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>ownedSpecializations</code> of this <code>Feature</code> that are <code>FeatureTypings</code>, for which the <code>Feature</code> is the <code>typedFeature</code>.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.160/@eStructuralFeatures.21";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref owningFeatureMembership: FeatureMembership [0,1] unordered derived transient volatile opposite external "#//@eClassifiers.62/@eStructuralFeatures.0"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>FeatureMembership</code> that owns this <code>Feature</code> as an <code>ownedMemberFeature</code>, determining its <code>owningType</code>.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.49/@eStructuralFeatures.12";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref owningType: Type [0,1] unordered derived transient volatile opposite external "#//@eClassifiers.160/@eStructuralFeatures.18"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Type</code> that is the <code>owningType</code> of the <code>owningFeatureMembership</code> of this <code>Feature</code>.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.49/@eStructuralFeatures.13";
        reference "#//@eClassifiers.58/@eStructuralFeatures.5";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref type: Type [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "typedFeature";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p><code>Types</code> that restrict the values of this <code>Feature</code>, such that the values must be instances of all the <code>types</code>. The types of a <code>Feature</code> are derived from its <code>typings</code> and the <code>types</code> of its <code>subsettings</code>. If the <code>Feature</code> is chained, then the <code>types</code> of the last <code>Feature</code> in the chain are also <code>types</code> of the chained <code>Feature</code>.</p>\n";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class FeatureChainExpression extends OperatorExpression {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>FeatureChainExpression</code> is an <code>OperatorExpression</code> whose operator is <code>\".\"</code>, which resolves to the <code>Function</code> <em><code>ControlFunctions::'.'</code></em> from the Kernel Functions Library. It evaluates to the result of chaining the <code>result</code> <code>Feature</code> of its single <code>argument</code> <code>Expression</code> with its <code>targetFeature</code>.</p>\nlet sourceTargetFeature : Feature = sourceTargetFeature() in\nsourceTargetFeature <> null and\nsourceTargetFeature.redefinesFromLibrary('ControlFunctions::\\'.\\'::source::target')\nlet sourceTargetFeature : Feature = sourceTargetFeature() in\nsourceTargetFeature <> null and\nsourceTargetFeature.redefines(targetFeature)\ntargetFeature =\n    let nonParameterMemberships : Sequence(Membership) = ownedMembership->\n        reject(oclIsKindOf(ParameterMembership)) in\n    if nonParameterMemberships->isEmpty() or\n       not nonParameterMemberships->first().memberElement.oclIsKindOf(Feature)\n    then null\n    else nonParameterMemberships->first().memberElement.oclAsType(Feature)\n    endif\nargument->notEmpty() implies\n    targetFeature.isFeaturedWithin(argument->first().result)\noperator = '.'\nlet inputParameters : Sequence(Feature) = \n    ownedFeatures->select(direction = _'in') in\nlet sourceTargetFeature : Feature = \n    owningExpression.sourceTargetFeature() in\nsourceTargetFeature <> null and\nresult.subsetsChain(inputParameters->first(), sourceTargetFeature) and\nresult.owningType = self";
    }
    op sourceTargetFeature() -> Feature [0,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Return the first <code>ownedFeature</code> of the first owned input <code>parameter</code> of this <code>FeatureChainExpression</code> (if any).</p>\nlet inputParameters : Feature = ownedFeatures->\n    select(direction = _'in') in\nif inputParameters->isEmpty() or \n   inputParameters->first().ownedFeature->isEmpty()\nthen null\nelse inputParameters->first().ownedFeature->first()\nendif";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref targetFeature: Feature [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "chainExpression";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Feature</code> that is accessed by this <code>FeatureChainExpression<code>, which is its first non-<code>parameter</code> <code>member</code>.<p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.107/@eStructuralFeatures.1";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class FeatureChaining extends Relationship {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p><code>FeatureChaining</code> is a <code>Relationship</code> that makes its target <code>Feature</code> one of the <code>chainingFeatures</code> of its owning <code>Feature</code>.</p>";
    }
    ref chainingFeature: Feature [1,1] unordered
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "chainedFeatureChaining";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Feature</code> whose values partly determine values of <code>featureChained</code>, as described in <code>Feature::chainingFeature</code>.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.129/@eStructuralFeatures.5";
      };
    ref featureChained: Feature [1,1] unordered derived transient volatile opposite external "#//@eClassifiers.58/@eStructuralFeatures.15"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Feature</code> whose values are partly determined by values of the <code>chainingFeature</code>, as described in <code>Feature::chainingFeature</code>.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.129/@eStructuralFeatures.4";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.129/@eStructuralFeatures.2";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  enum FeatureDirectionKind {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p><code>FeatureDirectionKind</code> enumerates the possible kinds of <code>direction</code> that a <code>Feature</code> may be given as a member of a <code>Type</code>.</p>\n";
    }
    `in` = 0
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Values of the <code>Feature</code> on each instance of its domain are determined externally to that instance and used internally.</p>\n";
      };
    inout = 1
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Values of the <code>Feature</code> on each instance are determined either as <em>in</em> or <em>out</em> directions, or both.</p>\n";
      };
    out = 2
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Values of the <code>Feature</code> on each instance of its domain are determined internally to that instance and used externally.</p>\n";
      };
  }
  class FeatureInverting extends Relationship {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>FeatureInverting</code> is a <code>Relationship</code> between <code>Features</code> asserting that their interpretations (sequences) are the reverse of each other, identified as <code>featureInverted</code> and <code>invertingFeature</code>. For example, a <code>Feature</code> identifying each person&#39;s parents is the inverse of a <code>Feature</code> identifying each person&#39;s children. A person identified as a parent of another will identify that other as one of their children.</p>\n";
    }
    ref featureInverted: Feature [1,1] unordered
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "invertingFeatureInverting";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Feature</code> that is an inverse of the <code>invertingFeature</code>.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.129/@eStructuralFeatures.4";
      };
    ref invertingFeature: Feature [1,1] unordered
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "invertedFeatureInverting";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Feature</code> that is an inverse of the <code>invertedFeature</code>.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.129/@eStructuralFeatures.5";
      };
    ref owningFeature: Feature [0,1] unordered derived transient volatile opposite external "#//@eClassifiers.58/@eStructuralFeatures.16"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>A <code>featureInverted</code> that is also the <code>owningRelatedElement</code> of this <code>FeatureInverting</code>.</p>\n";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.61/@eStructuralFeatures.0";
        reference "#//@eClassifiers.129/@eStructuralFeatures.2";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class FeatureMembership extends OwningMembership {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>FeatureMembership</code> is an <code>OwningMembership</code> between an <code>ownedMemberFeature</code> and an <code>owningType</code>. If the <code>ownedMemberFeature</code> has <code>isVariable = false</code>, then the <code>FeatureMembership</code> implies that the <code>owningType</code> is also a <code>featuringType</code> of the <code>ownedMemberFeature</code>. If the <code>ownedMemberFeature</code> has <code>isVariable = true</code>, then the <code>FeatureMembership</code> implies that the <code>ownedMemberFeature</code> is featured by the <em><code>snapshots</code></em> of the <code>owningType</code>, which must specialize the Kernel Semantic Library base class <em><code>Occurrence</code></em>.</p>\n";
    }
    ref ownedMemberFeature: Feature [1,1] unordered derived transient volatile opposite external "#//@eClassifiers.58/@eStructuralFeatures.22"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Feature</code> that this <code>FeatureMembership</code> relates to its <code>owningType</code>, making it an <code>ownedFeature</code> of the <code>owningType</code>.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.115/@eStructuralFeatures.0";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref owningType: Type [1,1] unordered derived transient volatile opposite external "#//@eClassifiers.160/@eStructuralFeatures.19"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Type</code> that owns this <code>FeatureMembership</code>.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.96/@eStructuralFeatures.4";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class FeatureReferenceExpression extends Expression {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>FeatureReferenceExpression</code> is an <code>Expression</code> whose <code>result</code> is bound to a <code>referent</code> <code>Feature</code>.</p>\nreferent =\n    let nonParameterMemberships : Sequence(Membership) = ownedMembership->\n        reject(oclIsKindOf(ParameterMembership)) in\n    if nonParameterMemberships->isEmpty() or\n       not nonParameterMemberships->first().memberElement.oclIsKindOf(Feature)\n    then null\n    else nonParameterMemberships->first().memberElement.oclAsType(Feature)\n    endif\nownedMember->selectByKind(BindingConnector)->exists(b |\n    b.relatedFeatures->includes(targetFeature) and\n    b.relatedFeatures->includes(result))\nlet membership : Membership = \n    ownedMembership->reject(m | m.oclIsKindOf(ParameterMembership)) in\nmembership->notEmpty() and\nmembership->at(1).memberElement.oclIsKindOf(Feature)\nresult.owningType() = self and result.specializes(referent)\nresult.owningType = self";
    }
    ref referent: Feature [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "referenceExpression";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Feature</code> that is referenced by this <code>FeatureReferenceExpression</code>, which is its first non-<code>parameter</code> <code>member</code>.<p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.107/@eStructuralFeatures.1";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class FeatureTyping extends Specialization {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p><code>FeatureTyping</code> is <code>Specialization</code> in which the <code>specific</code> <code>Type</code> is a <code>Feature</code>. This means the set of instances of the (specific) <code>typedFeature</code> is a subset of the set of instances of the (general) <code>type</code>. In the simplest case, the <code>type</code> is a <code>Classifier</code>, whereupon the <code>typedFeature</code> has values that are instances of the <code>Classifier</code>.</p>\n";
    }
    ref owningFeature: Feature [0,1] unordered derived transient volatile opposite external "#//@eClassifiers.58/@eStructuralFeatures.21"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>A <code>typedFeature</code> that is also the <code>owningRelatedElement</code> of this <code>FeatureTyping</code>.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.141/@eStructuralFeatures.1";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.64/@eStructuralFeatures.2";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref type: Type [1,1] unordered
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "typingByType";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Type</code> that is being applied by this <code>FeatureTyping</code>.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.141/@eStructuralFeatures.0";
      };
    ref typedFeature: Feature [1,1] unordered
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "typing";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Feature</code> that has a <code>type</code> determined by this <code>FeatureTyping</code>.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.141/@eStructuralFeatures.2";
      };
  }
  class FeatureValue extends OwningMembership {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>FeatureValue</code> is a <code>Membership</code> that identifies a particular member <code>Expression</code> that provides the value of the <code>Feature</code> that owns the <code>FeatureValue</code>. The value is specified as either a bound value or an initial value, and as either a concrete or default value. A <code>Feature</code> can have at most one <code>FeatureValue</code>.</p>\n\n<p>The result of the <code>value</code> <code>Expression</code> is bound to the <code>featureWithValue</code> using a <code>BindingConnector</code>. If <code>isInitial = false</code>, then the <code>featuringType</code> of the <code>BindingConnector</code> is the same as the <code>featuringType</code> of the <code>featureWithValue</code>. If <code>isInitial = true</code>, then the <code>featuringType</code> of the <code>BindingConnector</code> is restricted to its <code>startShot</code>.\n\n<p>If <code>isDefault = false</code>, then the above semantics of the <code>FeatureValue</code> are realized for the given <code>featureWithValue</code>. Otherwise, the semantics are realized for any individual of the <code>featuringType</code> of the <code>featureWithValue</code>, unless another value is explicitly given for the <code>featureWithValue</code> for that individual.</p>\n\nnot isDefault implies\n    featureWithValue.ownedMember->\n        selectByKind(BindingConnector)->exists(b |\n            b.relatedFeature->includes(featureWithValue) and\n            b.relatedFeature->exists(f | \n                f.chainingFeature = Sequence{value, value.result}) and\n            if not isInitial then \n                b.featuringType = featureWithValue.featuringType\n            else \n                b.featuringType->exists(t |\n                    t.oclIsKindOf(Feature) and\n                    t.oclAsType(Feature).chainingFeature =\n                        Sequence{\n                            resolveGlobal('Base::things::that').\n                                memberElement,\n                            resolveGlobal('Occurrences::Occurrence::startShot').\n                                memberElement\n                        }\n                )\n            endif)\nfeatureWithValue.redefinition.redefinedFeature->\n    closure(redefinition.redefinedFeature).valuation->\n    forAll(isDefault)\nisInitial implies featureWithValue.isVariable";
    }
    ref featureWithValue: Feature [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "valuation";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The Feature to be provided a value.</p>\n<p>The <code>Feature</code> to be provided a value.</p>\n";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.96/@eStructuralFeatures.4";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    attr isDefault: EBoolean [1,1] unordered default "false"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Whether this <code>FeatureValue</code> is a concrete specification of the bound or initial value of the <code>featureWithValue</code>, or just a default value that may be overridden.</p>";
      };
    attr isInitial: EBoolean [1,1] unordered default "false"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Whether this <code>FeatureValue</code> specifies a bound value or an initial value for the <code>featureWithValue</code>.</p>";
      };
    ref value: Expression [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "expressedValuation";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The Expression that provides the value as a result.</p>\n<p>The <code>Expression</code> that provides the value of the <code>featureWithValue</code> as its <code>result</code>.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.115/@eStructuralFeatures.0";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class Flow extends Connector, Step {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>An <code>Flow</code> is a <code>Step</code> that represents the transfer of values from one <code>Feature</code> to another. <code>Flows</code> can take non-zero time to complete.</p>\n\nspecializesFromLibrary('Transfers::transfers')\npayloadType =\n    if payloadFeature = null then Sequence{}\n    else payloadFeature.type\n    endif\nsourceOutputFeature =\n    if connectorEnd->isEmpty() or \n        connectorEnd.ownedFeature->isEmpty()\n    then null\n    else connectorEnd.ownedFeature->first()\n    endif\ntargetInputFeature =\n    if connectorEnd->size() < 2 or \n        connectorEnd->at(2).ownedFeature->isEmpty()\n    then null\n    else connectorEnd->at(2).ownedFeature->first()\n    endif\nflowEnd = connectorEnd->selectByKind(FlowEnd)\npayloadFeature =\n    let payloadFeatures : Sequence(PayloadFeature) =\n        ownedFeature->selectByKind(PayloadFeature) in\n    if payloadFeatures->isEmpty() then null\n    else payloadFeatures->first()\n    endif\nownedFeature->selectByKind(PayloadFeature)->size() <= 1\nownedEndFeatures->notEmpty() implies\n    specializesFromLibrary('Transfers::flowTransfers')";
    }
    ref flowEnd: FlowEnd [0,2] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "featuringFlow";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>connectorEnds</code> of this <code>Flow</code> that are <code>FlowEnds</code>.</p>\n";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.35/@eStructuralFeatures.1";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref interaction: Interaction [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "typedFlow";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Interactions</code> that type this <code>Flow</code>. <code>Interactions</code> are both <code>Associations</code> and <code>Behaviors</code>, which can type <code>Connectors</code> and <code>Steps</code>, respectively.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.35/@eStructuralFeatures.0";
        reference "#//@eClassifiers.146/@eStructuralFeatures.0";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref payloadFeature: PayloadFeature [0,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "flowWithPayloadFeature";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>ownedFeature</code> of the <code>Flow</code> that is a <code>PayloadFeature</code> (if any).</p>\n";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.160/@eStructuralFeatures.18";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref payloadType: Classifier [0,*] nonunique derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "flowForPayloadType";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The type of values transferred, which is the <code>type</code> of the <code>payloadFeature</code> of the <code>Flow</code>.</p>\n\n";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref sourceOutputFeature: Feature [0,1] nonunique derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "flowFromOutput";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Feature</code> that provides the items carried by the <code>Flow</code>. It must be a <code>feature</code> of the <code>source</code> of the <code>Flow</code>.</p>\n";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref targetInputFeature: Feature [0,1] nonunique derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "flowToInput";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Feature</code> that receives the values carried by the <code>Flow</code>. It must be a <code>feature</code> of the <code>target</code> of the <code>Flow</code>.</p>";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class FlowDefinition extends ActionDefinition, Interaction {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>FlowDefinition</code> is an <code>ActionDefinition</code> that is also an <code>Interaction</code> (which is both a KerML <code>Behavior</code> and <code>Association</code>), representing flows between <code>Usages</code>.</p>\nspecializesFromLibrary('Flows::MessageAction')\nflowEnd->size() = 2 implies\n    specializesFromLibrary('Flows::Message')\nflowEnd->size() <= 2";
    }
    ref flowEnd: Usage [0,*] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "flowDefinitionWithEnd";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Usages</code> that define the things related by the <code>FlowDefinition</code>.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.12/@eStructuralFeatures.0";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class FlowEnd extends Feature {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>FlowEnd</code> is a <code>Feature</code> that is one of the <code>connectorEnds</code> giving the <code><em>source</em></code> or <code><em>target</em></code> of a <code>Flow</code>. For <code>Flows</code> typed by <code><em>FlowTransfer</em></code> or its specializations, <code>FlowEnds</code> must have exactly one <code>ownedFeature</code>, which redefines <code><em>Transfer::source::sourceOutput</em></code> or <code><em>Transfer::target::targetInput</em></code> and redefines the corresponding feature of the <code>relatedElement</code> for its end.</p>\nisEnd\nownedFeature->size() = 1\nowningType <> null and owningType.oclIsKindOf(Flow)";
    }
  }
  class FlowUsage extends ConnectorAsUsage, ActionUsage, Flow {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>FlowUsage</code> is an <code>ActionUsage</code> that is also a <code>ConnectorAsUsage</code> and a KerML <code>Flow</code>.</p>\nspecializesFromLibrary('Flows::messages')\nownedEndFeatures->notEmpty() implies\n    specializesFromLibrary('Flows::flows')";
    }
    ref flowDefinition: Interaction [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "definedFlow";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Interactions</code> that are the <code>types</code> of this <code>FlowUsage</code>. Nominally, these are <code>FlowDefinitions</code>, but other kinds of Kernel <code>Interactions</code> are also allowed, to permit use of Interactions from the Kernel Model Libraries.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.2/@eStructuralFeatures.0";
        reference "#//@eClassifiers.66/@eStructuralFeatures.1";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class ForLoopActionUsage extends LoopActionUsage {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>ForLoopActionUsage</code> is a <code>LoopActionUsage</code> that specifies that its <code>bodyAction</code> <code>ActionUsage</code> should be performed once for each value, in order, from the sequence of values obtained as the result of the <code>seqArgument</code> <code>Expression</code>, with the <code>loopVariable</code> set to the value for each iteration.</p>\nseqArgument = argument(1)\n\nisSubactionUsage() implies\n    specializesFromLibrary('Actions::Action::forLoops')\nloopVariable <> null and\nloopVariable.redefinesFromLibrary('Actions::ForLoopAction::var')\nspecializesFromLibrary('Actions::forLoopActions')\nloopVariable =\n    if ownedFeature->isEmpty() or \n        not ownedFeature->first().oclIsKindOf(ReferenceUsage) then \n        null\n    else \n        ownedFeature->first().oclAsType(ReferenceUsage)\n    endif\nownedFeature->notEmpty() and\nownedFeature->at(1).oclIsKindOf(ReferenceUsage)\n\ninputParameters()->size() = 2";
    }
    ref loopVariable: ReferenceUsage [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "forLoopAction";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>ownedFeature</code> of this <co>ForLoopActionUsage</code> that acts as the loop variable, which is assigned the successive values of the input sequence on each iteration. It is the <code>ownedFeature</code> that redefines <em><code>ForLoopAction::var</code></em>.</p> ";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref seqArgument: Expression [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "forLoopAction";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Expression</code> whose result provides the sequence of values to which the <code>loopVariable</code> is set for each iterative performance of the <code>bodyAction</code>. It is the <code>Expression</code> whose <code>result</code> is bound to the <em><code>seq</code></em> <code>input</code> <code>parameter</code> of this <code>ForLoopActionUsage</code>.</p>\n";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class ForkNode extends ControlNode {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>ForkNode</code> is a <code>ControlNode</code> that must be followed by successor <code>Actions</code> as given by all its outgoing <code>Successions</code>.</p>\ntargetConnector->selectByKind(Succession)->size() <= 1\nspecializesFromLibrary('Actions::Action::forks')";
    }
  }
  class FramedConcernMembership extends RequirementConstraintMembership {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>FramedConcernMembership</code> is a <code>RequirementConstraintMembership</code> for a framed <code>ConcernUsage</code> of a <code>RequirementDefinition</code> or <code>RequirementUsage</code>.</p>\nkind = RequirementConstraintKind::requirement";
    }
    ref ownedConcern: ConcernUsage [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "framedConstraintMembership";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>ConcernUsage</code> that is the <code>ownedConstraint</code> of this <code>FramedConcernMembership</code>.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.132/@eStructuralFeatures.1";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref referencedConcern: ConcernUsage [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "referencingConcernMembership";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p> The <code>ConcernUsage</code> that is referenced through this <code>FramedConcernMembership</code>. It is the <code>referencedConstraint</code> of the <code>FramedConcernMembership</code> considered as a <code>RequirementConstraintMembership</code>, which must be a <code>ConcernUsage</code>.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.132/@eStructuralFeatures.2";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class Function extends Behavior {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>Function</code> is a <code>Behavior</code> that has an <code>out</code> <code>parameter</code> that is identified as its <code>result</code>. A <code>Function</code> represents the performance of a calculation that produces the values of its <code>result</code> <code>parameter</code>. This calculation may be decomposed into <code>Expressions</code> that are <code>steps</code> of the <code>Function</code>.</p>\n\nfeatureMembership->\n    selectByKind(ReturnParameterMembership)->\n    size() = 1\nspecializesFromLibrary('Performances::Evaluation')\nownedMembership.selectByKind(ResultExpressionMembership)->\n    forAll(mem | ownedFeature.selectByKind(BindingConnector)->\n        exists(binding |\n            binding.relatedFeature->includes(result) and\n            binding.relatedFeature->includes(mem.ownedResultExpression.result)))\nresult =\n    let resultParams : Sequence(Feature) =\n        featureMemberships->\n            selectByKind(ReturnParameterMembership).\n            ownedMemberParameter in\n    if resultParams->notEmpty() then resultParams->first()\n    else null\n    endif\nmembership->selectByKind(ResultExpressionMembership)->size() <= 1";
    }
    ref expression: Expression [0,*] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "computedFunction";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Expressions</code> that are <code>steps</code> in the calculation of the <code>result</code> of this <code>Function</code>.</p>\n\n<p>The set of expressions that represent computational steps or parts of a system of equations within the Function.</p>\n";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.16/@eStructuralFeatures.1";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    attr isModelLevelEvaluable: EBoolean [1,1] unordered derived transient volatile
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Whether this <code>Function</code> can be used as the <code>function</code> of a model-level evaluable <code>InvocationExpression</code>. Certain <code>Functions</code> from the Kernel Functions Library are considered to have <code>isModelLevelEvaluable = true</code>. For all other <code>Functions</code> it is <code>false</code>.</p>\n\n<p><strong>Note:</strong> See the specification of the KerML concrete syntax notation for <code>Expressions</code> for an identification of which library <code>Functions</code> are model-level evaluable.</p>";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref result: Feature [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "computingFunction";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The object or value that is the result of evaluating the Function.</p>\n<p>The <code>result</code> <code>parameter</code> of the <code>Function</code>, which is owned by the <code>Function</code> via a <code>ReturnParameterMembership</code>.</p>\n";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.160/@eStructuralFeatures.13";
        reference "#//@eClassifiers.16/@eStructuralFeatures.0";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class IfActionUsage extends ActionUsage {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>An <code>IfActionUsage</code> is an <code>ActionUsage</code> that specifies that the <code>thenAction</code> <code>ActionUsage</code> should be performed if the result of the <code>ifArgument</code> <code>Expression</code> is true. It may also optionally specify an <code>elseAction</code> <code>ActionUsage</code> that is performed if the result of the <code>ifArgument</code> is false.</p>\nthenAction = \n    let parameter : Feature = inputParameter(2) in\n    if parameter <> null and parameter.oclIsKindOf(ActionUsage) then\n        parameter.oclAsType(ActionUsage)\n    else\n        null\n    endif\nisSubactionUsage() implies\n    specializesFromLibrary('Actions::Action::ifSubactions')\nif elseAction = null then\n    specializesFromLibrary('Actions::ifThenActions')\nelse\n    specializesFromLibrary('Actions::ifThenElseActions')\nendif\nifArgument = \n    let parameter : Feature = inputParameter(1) in\n    if parameter <> null and parameter.oclIsKindOf(Expression) then\n        parameter.oclAsType(Expression)\n    else\n        null\n    endif\nelseAction = \n    let parameter : Feature = inputParameter(3) in\n    if parameter <> null and parameter.oclIsKindOf(ActionUsage) then\n        parameter.oclAsType(ActionUsage)\n    else\n        null\n    endif\ninputParameters()->size() >= 2";
    }
    ref elseAction: ActionUsage [0,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "ifElseAction";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>ActionUsage</code> that is to be performed if the result of the <code>ifArgument</code> is false. It is the (optional) third <code>parameter</code> of the <code>IfActionUsage</code>.</p> \n";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref ifArgument: Expression [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "ifAction";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Expression</code> whose result determines whether the <code>thenAction</code> or (optionally) the <code>elseAction</code> is performed. It is the first <code>parameter<code> of the <code>IfActionUsage</code>.</p> \n";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref thenAction: ActionUsage [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "ifThenAction";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>ActionUsage</code> that is to be performed if the result of the <code>ifArgument</code> is true. It is the second <code>parameter<code> of the <code>IfActionUsage</code>.</p> \n";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  abstract class Import extends Relationship {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>An <code>Import</code> is an <code>Relationship</code> between its <code>importOwningNamespace</code> and either a <code>Membership</code> (for a <code>MembershipImport</code>) or another <code>Namespace</code> (for a <code>NamespaceImport</code>), which determines a set of <code>Memberships</code> that become <code>importedMemberships</code> of the <code>importOwningNamespace</code>. If <code>isImportAll = false</code> (the default), then only public <code>Memberships</code> are considered &quot;visible&quot;. If <code>isImportAll = true</code>, then all <code>Memberships</code> are considered &quot;visible&quot;, regardless of their declared <code>visibility</code>. If <code>isRecursive = true</code>, then visible <code>Memberships</code> are also recursively imported from owned sub-<code>Namespaces</code>.</p>\n\n\nimportOwningNamespace.owner = null implies \n    visibility = VisibilityKind::private";
    }
    op importedMemberships(excluded: Namespace [0,*] unordered) -> Membership [0,*]
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Returns Memberships that are to become <code>importedMemberships</code> of the <code>importOwningNamespace</code>. (The <code>excluded</code> parameter is used to handle the possibility of circular Import Relationships.)</p>\n";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref importOwningNamespace: Namespace [1,1] unordered derived transient volatile opposite external "#//@eClassifiers.107/@eStructuralFeatures.3"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The Namespace into which Memberships are imported by this Import, which must be the <code>owningRelatedElement</code> of the Import.</p> \n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.129/@eStructuralFeatures.4";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.129/@eStructuralFeatures.2";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref importedElement: Element [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "membershipImport";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The effectively imported <code>Element</code> for this </code>Import</code>. For a <code>MembershipImport</code>, this is the <code>memberElement</code> of the <code>importedMembership</code>. For a <code>NamespaceImport</code>, it is the <code>importedNamespace</code>.</p>";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    attr isImportAll: EBoolean [1,1] unordered default "false"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Whether to import memberships without regard to declared visibility.</p>\n";
      };
    attr isRecursive: EBoolean [1,1] unordered default "false"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Whether to recursively import Memberships from visible, owned sub-Namespaces.</p>";
      };
    attr visibility: VisibilityKind [1,1] unordered default "private"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The visibility level of the imported <code>members</code> from this Import relative to the <code>importOwningNamespace</code>. The default is <code>private</code>.</p>\n";
      };
  }
  class IncludeUseCaseUsage extends UseCaseUsage, PerformActionUsage {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>An <code>IncludeUseCaseUsage</code> is a <code>UseCaseUsage</code> that represents the inclusion of a <code>UseCaseUsage</code> by a <code>UseCaseDefinition</code> or <code>UseCaseUsage</code>. Unless it is the <code>IncludeUseCaseUsage</code> itself, the <code>UseCaseUsage</code> to be included is related to the <code>includedUseCase</code> by a <code>ReferenceSubsetting</code> <code>Relationship</code>. An <code>IncludeUseCaseUsage</code> is also a PerformActionUsage, with its <code>useCaseIncluded</code> as the <code>performedAction</code>.</p>\n\nowningType <> null and\n(owningType.oclIsKindOf(UseCaseDefinition) or\n owningType.oclIsKindOf(UseCaseUsage) implies\n    specializesFromLibrary('UseCases::UseCase::includedUseCases')\nreferencedFeatureTarget() <> null implies\n    referencedFeatureTarget().oclIsKindOf(UseCaseUsage)";
    }
    ref useCaseIncluded: UseCaseUsage [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "useCaseInclusion";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>UseCaseUsage</code> to be included by this <code>IncludeUseCaseUsage</code>. It is the <code>performedAction</code> of the <code>IncludeUseCaseUsage</code> considered as a <code>PerformActionUsage</code>, which must be a <code>UseCaseUsage</code>.</p> \n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.121/@eStructuralFeatures.0";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class IndexExpression extends OperatorExpression {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>An <code>IndexExpression</code> is an <code>OperatorExpression</code> whose operator is <code>\"#\"</code>, which resolves to the <code>Function</code> <em><code>BasicFunctions::'#'</code></em> from the Kernel Functions Library.</p>\narguments->notEmpty() and \nnot arguments->first().result.specializesFromLibrary('Collections::Collection') implies\n    result.specializes(arguments->first().result)\noperator = '#'";
    }
  }
  abstract class InstantiationExpression extends Expression {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>An <code>InstantiationExpression</code> is an <code>Expression</code> that instantiates its <code>instantiatedType</code>, binding some or all of the <code>features</code> of that <code>Type</code> to the <code>results</code> of its <code>arguments</code>.</p>\n\n<p><code>InstantiationExpression</code> is abstract, with concrete subclasses <code>InvocationExpression</code> and <code>ConstructorExpression</code>.</p>\nresult.owningType = self\ninstantiatedType = instantiatedType()\ninstantiatedType() <> null";
    }
    op instantiatedType() -> Type [0,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Return the <code>Type</code> to act as the <code>instantiatedType</code> for this <code>InstantiationExpression</code>. By default, this is the <code>memberElement</code> of the first <code>ownedMembership</code> that is not a <code>FeatureMembership</code>, which must be a <code>Type</code>.</p>\n\n<p><b>Note.</b> This operation is overridden in the subclass <code>OperatorExpression</code>.</p>\nlet members : Sequence(Element) = ownedMembership->\n    reject(oclIsKindOf(FeatureMembership)).memberElement in\nif members->isEmpty() or not members->first().oclIsKindOf(Type) then null\nelse typeMembers->first().oclAsType(Type)\nendif";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref argument: Expression [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "instantiation";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Expressions</code> whose <code>results</code> are bound to <code>features</code> of the <code>instantiatedType</code>. The <code>arguments</code> are ordered consistent with the order of the <code>features</code>, though they may not be one-to-one with all the <code>features</code>.</p>\n\n<p><strong>Note.</strong> The derivation of <code>argument</code> is given in the concrete subclasses of <code>InstantiationExpression</code>.</p>";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref instantiatedType: Type [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "instantiationExpression";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Type</code> that is being instantiated.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.107/@eStructuralFeatures.1";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class Interaction extends Association, Behavior {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>An <code>Interaction</code> is a <code>Behavior</code> that is also an <code>Association</code>, providing a context for multiple objects that have behaviors that impact one another.</p>\n";
    }
  }
  class InterfaceDefinition extends ConnectionDefinition {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>An <code>InterfaceDefinition</code> is a <code>ConnectionDefinition</code> all of whose ends are <code>PortUsages</code>, defining an interface between elements that interact through such ports.</p>\nspecializesFromLibrary('Interfaces::Interface')\nownedEndFeature->size() = 2 implies\n    specializesFromLibrary('Interfaces::BinaryInterface')";
    }
    ref interfaceEnd: PortUsage [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "interfaceDefinitionWithEnd";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>PortUsages</code> that are the <code>connectionEnds</code> of this <code>InterfaceDefinition</code>.\n\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.33/@eStructuralFeatures.0";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class InterfaceUsage extends ConnectionUsage {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>An <code>InterfaceUsage</code> is a Usage of an <code>InterfaceDefinition</code> to represent an interface connecting parts of a system through specific ports.</p>\nownedEndFeature->size() = 2 implies\n    specializesFromLibrary('Interfaces::binaryInterfaces')\nspecializesFromLibrary('Interfaces::interfaces')";
    }
    ref interfaceDefinition: InterfaceDefinition [0,*] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "definedInterface";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>InterfaceDefinitions</code> that type this <code>InterfaceUsage</code>.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.34/@eStructuralFeatures.0";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class Intersecting extends Relationship {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p><code>Intersecting</code> is a <code>Relationship</code> that makes its <code>intersectingType</code> one of the <code>intersectingTypes</code> of its <code>typeIntersected</code>.</p>\n";
    }
    ref intersectingType: Type [1,1] unordered
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "intersectedIntersecting";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p><code>Type</code> that partly determines interpretations of <code>typeIntersected</code>, as described in <code>Type::intersectingType</code>.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.129/@eStructuralFeatures.5";
      };
    ref typeIntersected: Type [1,1] unordered derived transient volatile opposite external "#//@eClassifiers.160/@eStructuralFeatures.20"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p><code>Type</code> with interpretations partly determined by <code>intersectingType</code>, as described in <code>Type::intersectingType</code>.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.129/@eStructuralFeatures.4";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.129/@eStructuralFeatures.2";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class Invariant extends BooleanExpression {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>An <code>Invariant</code> is a <code>BooleanExpression</code> that is asserted to have a specific <code><em>Boolean</em></code> result value. If <code>isNegated = false</code>, then the result is asserted to be true. If <code>isNegated = true</code>, then the result is asserted to be false.</p>\n\nif isNegated then\n    specializesFromLibrary('Performances::falseEvaluations')\nelse\n    specializesFromLibrary('Performances::trueEvaluations')\nendif";
    }
    attr isNegated: EBoolean [1,1] unordered default "false"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Whether this <code>Invariant</code> is asserted to be false rather than true.</p>\n";
      };
  }
  class InvocationExpression extends InstantiationExpression {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>An <code>InvocationExpression</code> is an <code>InstantiationExpression</code> whose <code>instantiatedType</code> must be a <code>Behavior</code> or a <code>Feature</code> typed by a single <code>Behavior</code> (such as a <code>Step</code>). Each of the input <code>parameters</code> of the <code>instantiatedType</code> are bound to the <code>result</code> of an <code>argument</code> <code>Expression</code>. If the <code>instantiatedType</code> is a <code>Function</code> or a <code>Feature</code> typed by a <code>Function</code>, then the <code>result</code> of the <code>InvocationExpression</code> is the <code>result</code> of the invoked <code>Function</code>. Otherwise, the <code>result</code> is an instance of the <code>instantiatedType</code> (essentially like a behavioral <code>ConstructorExpression</code>).</p>\n\nnot instantiatedType.oclIsKindOf(Function) and\nnot (instantiatedType.oclIsKindOf(Feature) and \n     instantiatedType.oclAsType(Feature).type->exists(oclIsKindOf(Function))) implies\n    ownedFeature.selectByKind(BindingConnector)->exists(\n        relatedFeature->includes(self) and\n        relatedFeature->includes(result))\nTBD\ninstantiatedType.input->collect(inp | \n    ownedFeatures->select(redefines(inp)).valuation->\n    select(v | v <> null).value\n)\nlet parameters : OrderedSet(Feature) = instantiatedType.input in\ninput->forAll(inp | \n    inp.ownedRedefinition.redefinedFeature->\n        intersection(parameters)->size() = 1)\nlet features : OrderedSet(Feature) = instantiatedType.feature in\ninput->forAll(inp1 | input->forAll(inp2 |\n    inp1 <> inp2 implies\n        inp1.ownedRedefinition.redefinedFeature->\n            intersection(inp2.ownedRedefinition.redefinedFeature)->\n            intersection(features)->isEmpty()))\nnot instantiatedType.oclIsKindOf(Function) and\nnot (instantiatedType.oclIsKindOf(Feature) and \n     instantiatedType.oclAsType(Feature).type->exists(oclIsKindOf(Function))) implies\n    result.specializes(instantiatedType)\nspecializes(instantiatedType)\ninstantiatedType.oclIsKindOf(Behavior) or\ninstantiatedType.oclIsKindOf(Feature) and\n    instantiatedType.type->exists(oclIsKindOf(Behavior)) and\n    instantiatedType.type->size(1)\nownedFeature->forAll(f |\n    f <> result implies \n        f.direction = FeatureDirectionKind::_'in')";
    }
    ref operand: Expression [0,*] containment derived transient volatile
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class ItemDefinition extends OccurrenceDefinition, Structure {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>An <code>ItemDefinition</code> is an <code>OccurrenceDefinition</code> of the <code>Structure</code> of things that may themselves be systems or parts of systems, but may also be things that are acted on by a system or parts of a system, but which do not necessarily perform actions themselves. This includes items that can be exchanged between parts of a system, such as water or electrical signals.</p>\n\nspecializesFromLibrary('Items::Item')";
    }
  }
  class ItemUsage extends OccurrenceUsage {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>An <code>ItemUsage</code> is an <code>OccurrenceUsage</code> whose <code>definition</code> is a <code>Structure</code>. Nominally, if the <code>definition</code> is an <code>ItemDefinition</code>, an <code>ItemUsage</code> is a <code>ItemUsage</code> of that <code>ItemDefinition</code> within a system. However, other kinds of Kernel <code>Structures</code> are also allowed, to permit use of <code>Structures</code> from the Kernel Model Libraries.</p>\nitemDefinition = occurrenceDefinition->selectByKind(Structure)\nspecializesFromLibrary('Items::items')\nisComposite and owningType <> null and\n(owningType.oclIsKindOf(ItemDefinition) or\n owningType.oclIsKindOf(ItemUsage)) implies\n    specializesFromLibrary('Items::Item::subitem')";
    }
    ref itemDefinition: Structure [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "definedItem";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The Structures that are the <code>definitions</code> of this ItemUsage. Nominally, these are ItemDefinitions, but other kinds of Kernel Structures are also allowed, to permit use of Structures from the Kernel Library.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.113/@eStructuralFeatures.2";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class JoinNode extends ControlNode {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>JoinNode</code> is a <code>ControlNode</code> that waits for the completion of all the predecessor <code>Actions</code> given by incoming <code>Successions</code>.</p>\nsourceConnector->selectByKind(Succession)->size() <= 1\nspecializesFromLibrary('Actions::Action::join')";
    }
  }
  class LibraryPackage extends Package {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>LibraryPackage</code> is a <code>Package</code> that is the container for a model library. A <code>LibraryPackage</code> is itself a library <code>Element</code> as are all <code>Elements</code> that are directly or indirectly contained in it.</p>\n";
    }
    attr isStandard: EBoolean [1,1] unordered default "false"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Whether this <code>LibraryPackage</code> contains a standard library model. This should only be set to true for <code>LibraryPackages</code> in the standard Kernel Model Libraries or in normative model libraries for a language built on KerML.</p>";
      };
  }
  class LiteralBoolean extends LiteralExpression {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p><code>LiteralBoolean</code> is a <code>LiteralExpression</code> that provides a <code><em>Boolean</em></code> value as a result. Its <code>result</code> <code>parameter</code> must have type <code><em>Boolean</em></code>.</p>\n\nspecializesFromLibrary('Performances::literalBooleanEvaluations')";
    }
    attr value: EBoolean [1,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code><em>Boolean</em></code> value that is the result of evaluating this <code>LiteralBoolean</code>.</p>\n<p>The Boolean value that is the result of evaluating this Expression.</p>\n";
      };
  }
  class LiteralExpression extends Expression {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>LiteralExpression</code> is an <code>Expression</code> that provides a basic <code><em>DataValue</em></code> as a result.</p>\n\nisModelLevelEvaluable = true\nspecializesFromLibrary('Performances::literalEvaluations')";
    }
  }
  class LiteralInfinity extends LiteralExpression {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>LiteralInfinity</code> is a <code>LiteralExpression</code> that provides the positive infinity value (<code>*</code>). It's <code>result</code> must have the type <code><em>Positive</em></code>.</p>\n\nspecializesFromLibrary('Performances::literalIntegerEvaluations')";
    }
  }
  class LiteralInteger extends LiteralExpression {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>LiteralInteger</code> is a <code>LiteralExpression</code> that provides an <code><em>Integer</em></code> value as a result. Its <code>result</code> <code>parameter</code> must have the type <code><em>Integer</em></code>.</p>\n\nspecializesFromLibrary('Performances::literalIntegerEvaluations')";
    }
    attr value: EInt [1,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code><em>Integer</em></code> value that is the result of evaluating this <code>LiteralInteger</code>.</p>\n<p>The Integer value that is the result of evaluating this Expression.</p>\n";
      };
  }
  class LiteralRational extends LiteralExpression {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>LiteralRational</code> is a <code>LiteralExpression</code> that provides a <code><em>Rational</em></code> value as a result. Its <code>result</code> <code>parameter</code> must have the type <code><em>Rational</em></code>.</p>\n\nspecializesFromLibrary('Performances::literalRationalEvaluations')";
    }
    attr value: EDouble [1,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The value whose rational approximation is the result of evaluating this <code>LiteralRational</code>.</p>\n\n<p>The Real value that is the result of evaluating this Expression.</p>";
      };
  }
  class LiteralString extends LiteralExpression {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>LiteralString</code> is a <code>LiteralExpression</code> that provides a <code><em>String</em></code> value as a result. Its <code>result</code> <code>parameter</code> must have the type <code><em>String</em></code>.</p>\n\nspecializesFromLibrary('Performances::literalStringEvaluations')";
    }
    attr value: EString [1,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The String value that is the result of evaluating this Expression.</p>\n<p>The <code><em>String</em></code> value that is the result of evaluating this <code>LiteralString</code>.</p>\n";
      };
  }
  abstract class LoopActionUsage extends ActionUsage {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>LoopActionUsage</code> is an <code>ActionUsage</code> that specifies that its <code>bodyAction</code> should be performed repeatedly. Its subclasses <code>WhileLoopActionUsage</code> and <code>ForLoopActionUsage</code> provide different ways to determine how many times the <code>bodyAction</code> should be performed.</p>\nbodyAction =\n    let parameter : Feature = inputParameter(2) in\n    if parameter <> null and parameter.oclIsKindOf(Action) then\n        parameter.oclAsType(Action)\n    else\n        null\n    endif\n";
    }
    ref bodyAction: ActionUsage [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "loopAction";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>ActionUsage</code> to be performed repeatedly by the <code>LoopActionUsage</code>. It is the second <code>parameter</code> of the <code>LoopActionUsage</code>.</p> \n";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class Membership extends Relationship {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>Membership</code> is a <code>Relationship</code> between a <code>Namespace</code> and an <code>Element</code> that indicates the <code>Element</code> is a <code>member</code> of (i.e., is contained in) the Namespace. Any <code>memberNames</code> specify how the <code>memberElement</code> is identified in the <code>Namespace</code> and the <code>visibility</code> specifies whether or not the <code>memberElement</code> is publicly visible from outside the <code>Namespace</code>.</p>\n\n<p>If a <code>Membership</code> is an <code>OwningMembership</code>, then it owns its <code>memberElement</code>, which becomes an <code>ownedMember</code> of the <code>membershipOwningNamespace</code>. Otherwise, the <code>memberNames</code> of a <code>Membership</code> are effectively aliases within the <code>membershipOwningNamespace</code> for an <code>Element</code> with a separate <code>OwningMembership</code> in the same or a different <code>Namespace</code>.</p>\n\n<p>&nbsp;</p>\n\nmemberElementId = memberElement.elementId";
    }
    op isDistinguishableFrom(other: Membership [1,1] unordered) -> EBoolean [1,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Whether this <code>Membership</code> is distinguishable from a given <code>other</code> <code>Membership</code>. By default, this is true if this <code>Membership</code> has no <code>memberShortName</code> or <code>memberName</code>; or each of the <code>memberShortName</code> and <code>memberName</code> are different than both of those of the <code>other</code> <code>Membership</code>; or neither of the metaclasses of the <code>memberElement</code> of this <code>Membership</code> and the <code>memberElement</code> of the <code>other</code> <code>Membership</code> conform to the other. But this may be overridden in specializations of <code>Membership</code>.</p>\n\nnot (memberElement.oclKindOf(other.memberElement.oclType()) or\n     other.memberElement.oclKindOf(memberElement.oclType())) or\n(shortMemberName = null or\n    (shortMemberName <> other.shortMemberName and\n     shortMemberName <> other.memberName)) and\n(memberName = null or\n    (memberName <> other.shortMemberName and\n     memberName <> other.memberName)))\n";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref memberElement: Element [1,1] unordered
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "membership";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Element</code> that becomes a <code>member</code> of the <code>membershipOwningNamespace</code> due to this <code>Membership</code>.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.129/@eStructuralFeatures.5";
      };
    attr memberElementId: EString [1,1] unordered derived transient volatile
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>elementId</code> of the <code>memberElement</code>.</p>";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    attr memberName: EString [0,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The name of the <code>memberElement</code> relative to the <code>membershipOwningNamespace</code>.</p>\n";
      };
    attr memberShortName: EString [0,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The short name of the <code>memberElement</code> relative to the <code>membershipOwningNamespace</code>.</p>";
      };
    ref membershipOwningNamespace: Namespace [1,1] unordered derived transient volatile opposite external "#//@eClassifiers.107/@eStructuralFeatures.5"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Namespace</code> of which the <code>memberElement</code> becomes a <code>member</code> due to this <code>Membership</code>.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.129/@eStructuralFeatures.4";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.129/@eStructuralFeatures.2";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    attr visibility: VisibilityKind [1,1] unordered default "public"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Whether or not the <code>Membership</code> of the <code>memberElement</code> in the <code>membershipOwningNamespace</code> is publicly visible outside that <code>Namespace</code>.</p>\n";
      };
  }
  class MembershipExpose extends MembershipImport, Expose {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>MembershipExpose</code> is an <code>Expose</code> <code.Relationship</code> that exposes a specific <code>importedMembership</code> and, if <code>isRecursive = true</code>, additional <code>Memberships</code> recursively.</p>";
    }
  }
  class MembershipImport extends Import {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>MembershipImport</code> is an <code>Import</code> that imports its <code>importedMembership</code> into the <code>importOwningNamespace</code>. If <code>isRecursive = true</code> and the <code>memberElement</code> of the <code>importedMembership</code> is a <code>Namespace</code>, then the equivalent of a recursive <code>NamespaceImport</code> is also performed on that <code>Namespace</code>.</p>\n\nimportedElement = importedMembership.memberElement";
    }
    ref importedMembership: Membership [1,1] unordered
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "import";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Membership</code> to be imported.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.129/@eStructuralFeatures.5";
      };
  }
  class MergeNode extends ControlNode {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>MergeNode</code> is a <code>ControlNode</code> that asserts the merging of its incoming <code>Successions</code>. A <code>MergeNode</code> may have at most one outgoing <code>Successions</code>.</p>\nsourceConnector->selectAsKind(Succession)->size() <= 1\ntargetConnector->selectByKind(Succession)->\n    collect(connectorEnd->at(1))->\n    forAll(sourceMult |\n        multiplicityHasBounds(sourceMult, 0, 1))\ntargetConnector->selectByKind(Succession)->\n    forAll(subsetsChain(self, \n        resolveGlobal('ControlPerformances::MergePerformance::incomingHBLink')))\nspecializesFromLibrary('Actions::Action::merges')";
    }
  }
  class Metaclass extends Structure {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>Metaclass</code> is a <code>Structure</code> used to type <code>MetadataFeatures</code>.</p>\nspecializesFromLibrary('Metaobjects::Metaobject')";
    }
  }
  class MetadataAccessExpression extends Expression {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>MetadataAccessExpression</code> is an <code>Expression</code> whose <code>result</code> is a sequence of instances of <code>Metaclasses</code> representing all the <code>MetadataFeature</code> annotations of the <code>referencedElement</code>. In addition, the sequence includes an instance of the reflective <code>Metaclass</code> corresponding to the MOF class of the <code>referencedElement</code>, with values for all the abstract syntax properties of the <code>referencedElement</code>.</p>\nspecializesFromLibrary('Performances::metadataAccessEvaluations')\nownedMembership->exists(not oclIsKindOf(FeatureMembership))\nreferencedElement =\n    let elements : Sequence(Element) = ownedMembership->\n        reject(oclIsKindOf(FeatureMembership)).memberElement in\n    if elements->isEmpty() then null\n    else elements->first()\n    endif";
    }
    op metaclassFeature() -> MetadataFeature [1,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Return a <code>MetadataFeature</code> whose <code>annotatedElement</code> is the <code>referencedElement</code>, whose <code>metaclass</code> is the reflective <code>Metaclass</code> corresponding to the MOF class of the <code>referencedElement</code> and whose <code>ownedFeatures</code> are bound to the MOF properties of the <code>referencedElement</code>.</p>";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref referencedElement: Element [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "accessExpression";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Element</code> whose metadata is being accessed.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.107/@eStructuralFeatures.1";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class MetadataDefinition extends ItemDefinition, Metaclass {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>MetadataDefinition</code> is an <code>ItemDefinition</code> that is also a <code>Metaclass</code>.</p>\nspecializesFromLibrary('Metadata::MetadataItem')";
    }
  }
  class MetadataFeature extends Feature, AnnotatingElement {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>MetadataFeature</code> is a <code>Feature</code> that is an <code>AnnotatingElement</code> used to annotate another <code>Element</code> with metadata. It is typed by a <code>Metaclass</code>. All its <code>ownedFeatures</code> must redefine <code>features</code> of its <code>metaclass</code> and any feature bindings must be model-level evaluable.</p>\n\n\ntype->selectByKind(Metaclass).size() = 1\nnot metaclass.isAbstract\nspecializesFromLibrary('Metaobjects::metaobjects')\nownedFeature->closure(ownedFeature)->forAll(f |\n    f.declaredName = null and f.declaredShortName = null and\n    f.valuation <> null implies f.valuation.value.isModelLevelEvaluable and\n    f.redefinition.redefinedFeature->size() = 1)\nmetaclass = \n    let metaclassTypes : Sequence(Type) = type->selectByKind(Metaclass) in\n    if metaclassTypes->isEmpty() then null\n    else metaClassTypes->first()\n    endif\nlet baseAnnotatedElementFeature : Feature =\n    resolveGlobal('Metaobjects::Metaobject::annotatedElement').memberElement.\n    oclAsType(Feature) in\nlet annotatedElementFeatures : OrderedSet(Feature) = feature->\n    select(specializes(baseAnnotatedElementFeature))->\n    excluding(baseAnnotatedElementFeature) in\nannotatedElementFeatures->notEmpty() implies\n    let annotatedElementTypes : Set(Feature) =\n        annotatedElementFeatures.typing.type->asSet() in\n    let metaclasses : Set(Metaclass) =\n        annotatedElement.oclType().qualifiedName->collect(qn | \n            resolveGlobal(qn).memberElement.oclAsType(Metaclass)) in\n   metaclasses->forAll(m | annotatedElementTypes->exists(t | m.specializes(t)))\nisSemantic() implies\n    let annotatedTypes : Sequence(Type) = \n        annotatedElement->selectAsKind(Type) in\n    let baseTypes : Sequence(MetadataFeature) = \n        evaluateFeature(resolveGlobal(\n            'Metaobjects::SemanticMetadata::baseType').\n            memberElement.\n            oclAsType(Feature))->\n        selectAsKind(MetadataFeature) in\n    annotatedTypes->notEmpty() and \n    baseTypes()->notEmpty() and \n    baseTypes()->first().isSyntactic() implies\n        let annotatedType : Type = annotatedTypes->first() in\n        let baseType : Element = baseTypes->first().syntaxElement() in\n        if annotatedType.oclIsKindOf(Classifier) and \n            baseType.oclIsKindOf(Feature) then\n            baseType.oclAsType(Feature).type->\n                forAll(t | annotatedType.specializes(t))\n        else if baseType.oclIsKindOf(Type) then\n            annotatedType.specializes(baseType.oclAsType(Type))\n        else\n            true\n        endif";
    }
    op evaluateFeature(baseFeature: Feature [1,1] unordered) -> Element [0,*] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>If the given <code>baseFeature</code> is a <code>feature</code> of this <code>MetadataFeature</code>, or is directly or indirectly redefined by a <code>feature</code>, then return the result of evaluating the appropriate (model-level evaluable) <code>value</code> <code>Expression</code> for it (if any), with the <code>MetadataFeature</code> as the target.</p>\nlet selectedFeatures : Sequence(Feature) = feature->\n    select(closure(ownedRedefinition.redefinedFeature)->\n           includes(baseFeature)) in\nif selectedFeatures->isEmpty() then null\nelse\n    let selectedFeature : Feature = selectedFeatures->first() in\n    let featureValues : FeatureValue = selectedFeature->\n        closure(ownedRedefinition.redefinedFeature).ownedMember->\n        selectAsKind(FeatureValue) in\n    if featureValues->isEmpty() then null\n    else featureValues->first().value.evaluate(self)\n    endif";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op isSemantic() -> EBoolean [1,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Check if this <code>MetadataFeature</code> has a <code>metaclass</code> which is a kind of <code><em>SemanticMetadata</code>.<p>\nspecializesFromLibrary('Metaobjects::SemanticMetadata')";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op isSyntactic() -> EBoolean [1,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Check if this <code>MetadataFeature</code> has a <code>metaclass</code> that is a kind of <code><em>KerML::Element</em></code> (that is, it is from the reflective abstract syntax model).</p>\nspecializesFromLibrary('KerML::Element')";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op syntaxElement() -> Element [0,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>If this <code>MetadataFeature</code> reflectively represents a model element, then return the corresponding <code>Element</code> instance from the MOF abstract syntax representation of the model.</p>\nNo OCL\nisSyntactic()";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref metaclass: Metaclass [0,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "typedMetadata";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>type</code> of this <code>MetadataFeature</code>, which must be a <code>Metaclass</code>.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.58/@eStructuralFeatures.24";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class MetadataUsage extends ItemUsage, MetadataFeature {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A  <code>MetadataUsage</code> is a <code>Usage</code> and a <code>MetadataFeature</code>, used to annotate other <code>Elements</code> in a system model with metadata. As a <code>MetadataFeature</code>, its type must be a <code>Metaclass</code>, which will nominally be a <code>MetadataDefinition</code>. However, any kernel <code>Metaclass</code> is also allowed, to permit use of <code>Metaclasses</code> from the Kernel Model Libraries.</p>\nspecializesFromLibrary('Metadata::metadataItems')";
    }
    ref metadataDefinition: Metaclass [0,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "definedMetadata";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>MetadataDefinition</code> that is the <code>definition</code> of this <code>MetadataUsage</code>.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.86/@eStructuralFeatures.0";
        reference "#//@eClassifiers.103/@eStructuralFeatures.0";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class Multiplicity extends Feature {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>Multiplicity</code> is a <code>Feature</code> whose co-domain is a set of natural numbers giving the allowed cardinalities of each <code>typeWithMultiplicity</code>. The <em>cardinality</em> of a <code>Type</code> is defined as follows, depending on whether the <code>Type</code> is a <code>Classifier</code> or <code>Feature</code>.\n<ul>\n<li><code>Classifier</code> – The number of basic instances of the <code>Classifier</code>, that is, those instances representing things, which are not instances of any subtypes of the <code>Classifier</code> that are <code>Features</code>.\n<li><code>Features</code> – The number of instances with the same featuring instances. In the case of a <code>Feature</code> with a <code>Classifier</code> as its <code>featuringType</code>, this is the number of values of <code>Feature</code> for each basic instance of the <code>Classifier</code>. Note that, for non-unique <code>Features</code>, all duplicate values are included in this count.</li>\n</ul>\n\n<p><code>Multiplicity</code> co-domains (in models) can be specified by <code>Expression</code> that might vary in their results. If the <code>typeWithMultiplicity</code> is a <code>Classifier</code>, the domain of the <code>Multiplicity</code> shall be <em><code>Base::Anything</code></em>.  If the <code>typeWithMultiplicity</code> is a <code>Feature</code>,  the <code>Multiplicity</code> shall have the same domain as the <code>typeWithMultiplicity</code>.</p>\n\nif owningNamespace <> null and owningNamespace.oclIsKindOf(Feature) then\n    featuringType = \n        owningNamespace.oclAsType(Feature).featuringType\nelse\n    featuringType->isEmpty()\nendif\nspecializesFromLibrary('Base::naturals')";
    }
  }
  class MultiplicityRange extends Multiplicity {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>MultiplicityRange</code> is a <code>Multiplicity</code> whose value is defined to be the (inclusive) range of natural numbers given by the result of a <code>lowerBound</code> <code>Expression</code> and the result of an <code>upperBound</code> <code>Expression</code>. The result of these <code>Expressions</code> shall be of type <code><em>Natural</em></code>. If the result of the <code>upperBound</code> <code>Expression</code> is the unbounded value <code>*</code>, then the specified range includes all natural numbers greater than or equal to the <code>lowerBound</code> value. If no <code>lowerBound</code> <code>Expression</code>, then the default is that the lower bound has the same value as the upper bound, except if the <code>upperBound</code> evaluates to <code>*</code>, in which case the default for the lower bound is 0.</p>\n\nlet boundsFeaturingType : OrderedSet(Type) =\n    if owningNamespace <> null and owningNamespace.oclIsKindOf(Feature) and \n        owningNamespace.oclAsType(Feature).isOwnedCrossFeature() then\n        owningNamespace.oclAsType(Feature).owningNamespace.oclAsType(Feature).featuringType\n    else\n        featuringType\n    endif in\nbound->forAll(b | b.featuringType = boundsFeaturingType)\n\nbound->forAll(b |\n    b.result.specializesFromLibrary('ScalarValues::Integer') and\n    let value : UnlimitedNatural = valueOf(b) in\n    value <> null implies value >= 0\n)\nlowerBound =\n    let ownedExpressions : Sequence(Expression) =\n        ownedMember->selectByKind(Expression) in\n    if ownedExpressions->size() < 2 then null\n    else ownedExpressions->first()\n    endif\nupperBound =\n    let ownedExpressions : Sequence(Expression) =\n        ownedMember->selectByKind(Expression) in\n    if ownedExpressions->isEmpty() then null\n    else if ownedExpressions->size() = 1 then ownedExpressions->at(1)\n    else ownedExpressions->at(2)\n    endif endif \nbound =\n    if upperBound = null then Sequence{}\n    else if lowerBound = null then Sequence{upperBound}\n    else Sequence{lowerBound, upperBound}\n    endif endif\nif lowerBound = null then\n    ownedMember->notEmpty() and\n    ownedMember->at(1) = upperBound\nelse\n    ownedMember->size() > 1 and\n    ownedMember->at(1) = lowerBound and\n    ownedMember->at(2) = upperBound\nendif";
    }
    op hasBounds(lower: EInt [1,1] unordered, upper: EInt [1,1] unordered) -> EBoolean [1,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Check whether this <code>MultiplicityRange</code> represents the range bounded by the given values <code>lower</code> and <code>upper</code>, presuming the <code>lowerBound</code> and <code>upperBound</code> <code>Expressions</code> are model-level evaluable.</p>\nvalueOf(upperBound) = upper and\nlet lowerValue: UnlimitedNatural = valueOf(lowerBound) in\n(lowerValue = lower or\n lowerValue = null and \n    (lower = upper or \n     lower = 0 and upper = *))\n ";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op valueOf(bound: Expression [0,1] unordered) -> EInt [0,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Evaluate the given <code>bound</code> <code>Expression</code> (at model level) and return the result represented as a MOF <code>UnlimitedNatural</code> value.</p>\nif bound = null or not bound.isModelLevelEvaluable then \n    null\nelse\n    let boundEval: Sequence(Element) = bound.evaluate(owningType) in\n    if boundEval->size() <> 1 then null else\n        let valueEval: Element = boundEval->at(1) in\n        if valueEval.oclIsKindOf(LiteralInfinity) then *\n        else if valueEval.oclIsKindOf(LiteralInteger) then\n            let value : Integer = \n                valueEval.oclAsKindOf(LiteralInteger).value in\n            if value >= 0 then value else null endif\n        else null\n        endif endif\n    endif\nendif ";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref bound: Expression [1,2] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "multiplicity";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The owned <code>Expressions</code> of the <code>MultiplicityRange</code> whose results provide its bounds. These must be the first <code>ownedMembers</code> of the <code>MultiplicityRange</code>.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.107/@eStructuralFeatures.4";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref lowerBound: Expression [0,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "multiplicity";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Expression</code> whose result provides the lower bound of the <code>MultiplicityRange</code>. If no <code>lowerBound</code> <code>Expression</code> is given, then the lower bound shall have the same value as the upper bound, unless the upper bound is unbounded (<code>*</code>), in which case the lower bound shall be 0.</p>\n";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.106/@eStructuralFeatures.0";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref upperBound: Expression [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "multiplicity";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Expression</code> whose result is the upper bound of the <code>MultiplicityRange</code>.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.106/@eStructuralFeatures.0";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class Namespace extends Element {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>Namespace</code> is an <code>Element</code> that contains other <code>Elements</code>, known as its <code>members</code>, via <code>Membership</code> <code>Relationships</code> with those <code>Elements</code>. The <code>members</code> of a <code>Namespace</code> may be owned by the <code>Namespace</code>, aliased in the <code>Namespace</code>, or imported into the <code>Namespace</code> via <code>Import</code> <code>Relationships</code>.</p>\n\n<p>A <code>Namespace</code> can provide names for its <code>members</code> via the <code>memberNames</code> and <code>memberShortNames</code> specified by the <code>Memberships</code> in the <code>Namespace</code>. If a <code>Membership</code> specifies a <code>memberName</code> and/or <code>memberShortName</code>, then those are names of the corresponding <code>memberElement</code> relative to the <code>Namespace</code>. For an <code>OwningMembership</code>, the <code>ownedMemberName</code> and <code>ownedMemberShortName</code> are given by the <code>Element</code> <code>name</code> and <code>shortName</code>. Note that the same <code>Element</code> may be the <code>memberElement</code> of multiple <code>Memberships</code> in a <code>Namespace</code> (though it may be owned at most once), each of which may define a separate alias for the <code>Element</code> relative to the <code>Namespace</code>.</p>\n\nmembership->forAll(m1 | \n    membership->forAll(m2 | \n        m1 <> m2 implies m1.isDistinguishableFrom(m2)))\nmember = membership.memberElement\nownedMember = ownedMembership->selectByKind(OwningMembership).ownedMemberElement\nimportedMembership = importedMemberships(Set{})\nownedImport = ownedRelationship->selectByKind(Import)\nownedMembership = ownedRelationship->selectByKind(Membership)";
    }
    op importedMemberships(excluded: Namespace [0,*] unordered) -> Membership [0,*]
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Derive the imported <code>Memberships</code> of this <code>Namespace</code> as the <code>importedMembership</code> of all <code>ownedImports</code>, excluding those Imports whose <code>importOwningNamespace</code> is in the <code>excluded</code> set, and excluding <code>Memberships</code> that have distinguisibility collisions with each other or with any <code>ownedMembership</code>.</p>\n\nownedImport.importedMemberships(excluded->including(self))";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op membershipsOfVisibility(
      visibility: VisibilityKind [0,1] unordered,
      excluded: Namespace [0,*] unordered
    ) -> Membership [0,*] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>If <code>visibility</code> is not null, return the <code>Memberships</code> of this <code>Namespace</code> with the given <code>visibility</code>, including <code>ownedMemberships</code> with the given <code>visibility</code> and <code>Memberships</code> imported with the given <code>visibility</code>. If <code>visibility</code> is null, return all <code>ownedMemberships</code> and imported <code>Memberships</code> regardless of visibility. When computing imported <code>Memberships</code>, ignore this <code>Namespace</code> and any <code>Namespaces</code> in the given <code>excluded</code> set.</p>\nownedMembership->\n    select(mem | visibility = null or mem.visibility = visibility)->\n    union(ownedImport->\n        select(imp | visibility = null or imp.visibility = visibility).\n        importedMemberships(excluded->including(self)))";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op namesOf(element: Element [1,1] unordered) -> EString [0,*] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Return the names of the given <code>element</code> as it is known in this <code>Namespace</code>.</p>\n\nlet elementMemberships : Sequence(Membership) = \n    memberships->select(memberElement = element) in\nmemberships.memberShortName->\n    union(memberships.memberName)->\n    asSet()";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op qualificationOf(qualifiedName: EString [1,1] unordered) -> EString [0,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Return a string with valid KerML syntax representing the qualification part of a given <code>qualifiedName</code>, that is, a qualified name with all the segment names of the given name except the last. If the given <code>qualifiedName</code> has only one segment, then return null.</p>\nNo OCL";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op resolve(qualifiedName: EString [1,1] unordered) -> Membership [0,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Resolve the given qualified name to the named <code>Membership</code> (if any), starting with this <code>Namespace</code> as the local scope. The qualified name string must conform to the concrete syntax of the KerML textual notation. According to the KerML name resolution rules every qualified name will resolve to either a single <code>Membership</code>, or to none.</p>\n\nlet qualification : String = qualificationOf(qualifiedName) in\nlet name : String = unqualifiedNameOf(qualifiedName) in\nif qualification = null then resolveLocal(name)\nelse if qualification = '$' then  resolveGlobal(name)\nelse \n    let namespaceMembership : Membership = resolve(qualification) in\n    if namespaceMembership = null or \n       not namespaceMembership.memberElement.oclIsKindOf(Namespace) \n    then null\n    else \n        namespaceMembership.memberElement.oclAsType(Namespace).\n        resolveVisible(name) \n    endif\nendif endif";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op resolveGlobal(qualifiedName: EString [1,1] unordered) -> Membership [0,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Resolve the given qualified name to the named <code>Membership</code> (if any) in the effective global <code>Namespace</code> that is the outermost naming scope. The qualified name string must conform to the concrete syntax of the KerML textual notation.</p>\n\nNo OCL";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op resolveLocal(name: EString [1,1] unordered) -> Membership [0,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Resolve a simple <code>name</code> starting with this <code>Namespace</code> as the local scope, and continuing with containing outer scopes as necessary. However, if this <code>Namespace</code> is a root <code>Namespace</code>, then the resolution is done directly in global scope.</p>\n\nif owningNamespace = null then resolveGlobal(name)\nelse\n    let memberships : Membership = membership->\n        select(memberShortName = name or memberName = name) in\n    if memberships->notEmpty() then memberships->first()\n    else owningNamespace.resolveLocal(name)\n    endif\nendif";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op resolveVisible(name: EString [1,1] unordered) -> Membership [0,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Resolve a simple name from the visible <code>Memberships</code> of this <code>Namespace</code>.</p>\n\nlet memberships : Sequence(Membership) =\n    visibleMemberships(Set{}, false, false)->\n    select(memberShortName = name or memberName = name) in\nif memberships->isEmpty() then null\nelse memberships->first()\nendif";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op unqualifiedNameOf(qualifiedName: EString [1,1] unordered) -> EString [1,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Return the simple name that is the last segment name of the given <code>qualifiedName</code>. If this segment name has the form of a KerML unrestricted name, then \"unescape\" it by removing the surrounding single quotes and replacing all escape sequences with the specified character.</p>\nNo OCL";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op visibilityOf(mem: Membership [1,1] unordered) -> VisibilityKind [1,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Returns this visibility of <code>mem</code> relative to this <code>Namespace</code>. If <code>mem</code> is an <code>importedMembership</code>, this is the <code>visibility</code> of its Import. Otherwise it is the <code>visibility</code> of the <code>Membership</code> itself.</p>\n\nif importedMembership->includes(mem) then\n    ownedImport->\n        select(importedMemberships(Set{})->includes(mem)).\n        first().visibility\nelse if memberships->includes(mem) then\n    mem.visibility\nelse\n    VisibilityKind::private\nendif";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op visibleMemberships(
      excluded: Namespace [0,*] unordered,
      isRecursive: EBoolean [1,1] unordered,
      includeAll: EBoolean [1,1] unordered
    ) -> Membership [0,*]
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>If <code>includeAll = true</code>, then return all the <code>Memberships</code> of this <code>Namespace</code>. Otherwise, return only the publicly visible <code>Memberships</code> of this <code>Namespace</code>, including <code>ownedMemberships</code> that have a <code>visibility</code> of <code>public</code> and <code>Memberships</code> imported with a <code>visibility</code> of <code>public</code>. If <code>isRecursive = true</code>, also recursively include all visible <code>Memberships</code> of any <code>public</code> owned <code>Namespaces</code>, or, if <code>IncludeAll = true</code>, all <code>Memberships</code> of all owned <code>Namespaces</code>. When computing imported <code>Memberships</code>, ignore this <code>Namespace</code> and any <code>Namespaces</code> in the given <code>excluded</code> set.</p>\n\nlet visibleMemberships : OrderedSet(Membership) = \n    if includeAll then membershipsOfVisibility(null, excluded)\n    else membershipsOfVisibility(VisibilityKind::public, excluded)\n    endif in\nif not isRecursive then visibleMemberships\nelse visibleMemberships->union(ownedMember->\n    selectAsKind(Namespace).\n    select(includeAll or owningMembership.visibility = VisibilityKind::public)->\n    visibleMemberships(excluded->including(self), true, includeAll))\nendif\n";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref importedMembership: Membership [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "importingNamespace";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Memberships</code> in this <code>Namespace</code> that result from the <code>ownedImports</code> of this <code>Namespace</code>.</p>\n";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.107/@eStructuralFeatures.2";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref member: Element [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "namespace";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The set of all member <code>Elements</code> of this <code>Namespace</code>, which are the <code>memberElements</code> of all <code>memberships</code> of the <code>Namespace</code>.</p>\n";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref membership: Membership [0,*] derived readonly transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "membershipNamespace";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>All <code>Memberships</code> in this <code>Namespace</code>, including (at least) the union of <code>ownedMemberships</code> and <code>importedMemberships</code>.</p>\n";
      }
      annotation "union" { };
    ref ownedImport: Import [0,*] derived transient volatile opposite external "#//@eClassifiers.75/@eStructuralFeatures.0"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>ownedRelationships</code> of this <code>Namespace</code> that are <code>Imports</code>, for which the <code>Namespace</code> is the <code>importOwningNamespace</code>.</p>\n";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.49/@eStructuralFeatures.10";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref ownedMember: Element [0,*] derived transient volatile opposite external "#//@eClassifiers.49/@eStructuralFeatures.13"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The owned <code>members</code> of this <code>Namespace</code>, which are the <cpde><code>ownedMemberElements</code> of the <code>ownedMemberships</code> of the <code>Namespace</code>.</p>\n";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.107/@eStructuralFeatures.1";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref ownedMembership: Membership [0,*] derived transient volatile opposite external "#//@eClassifiers.96/@eStructuralFeatures.4"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>ownedRelationships</code> of this <code>Namespace</code> that are <code>Memberships</code>, for which the <code>Namespace</code> is the <code>membershipOwningNamespace</code>.</p>\n";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.107/@eStructuralFeatures.2";
        reference "#//@eClassifiers.49/@eStructuralFeatures.10";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class NamespaceExpose extends NamespaceImport, Expose {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>NamespaceExpose</code> is an <code>Expose</code> <code>Relationship</code> that exposes the <code>Memberships</code> of a specific <code>importedNamespace</code> and, if <code>isRecursive = true</code>, additional <code>Memberships</code> recursively.</p>";
    }
  }
  class NamespaceImport extends Import {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>NamespaceImport</code> is an Import that imports <code>Memberships</code> from its <code>importedNamespace</code> into the <code>importOwningNamespace</code>. If <code> isRecursive = false</code>, then only the visible <code>Memberships</code> of the <code>importedNamespace</code> are imported. If <code> isRecursive = true</code>, then, in addition, <code>Memberships</code> are recursively imported from any <code>ownedMembers</code> of the <code>importedNamespace</code> that are <code>Namespaces</code>.</p>\n\nimportedElement = importedNamespace";
    }
    ref importedNamespace: Namespace [1,1] unordered
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "import";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Namespace</code> whose visible <code>Memberships</code> are imported by this <code>NamespaceImport</code>.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.129/@eStructuralFeatures.5";
      };
  }
  class NullExpression extends Expression {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>NullExpression</code> is an <code>Expression</code> that results in a null value.</p>\n\nspecializesFromLibrary('Performances::nullEvaluations')";
    }
  }
  class ObjectiveMembership extends FeatureMembership {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>An <code>ObjectiveMembership</code> is a <code>FeatureMembership</code> that indicates that its <code>ownedObjectiveRequirement</code> is the objective <code>RequirementUsage</code> for its <code>owningType</code>, which must be a <code>CaseDefinition</code> or <code>CaseUsage</code>.</p>\nowningType.oclIsType(CaseDefinition) or\nowningType.oclIsType(CaseUsage)\n\nownedObjectiveRequirement.isComposite";
    }
    ref ownedObjectiveRequirement: RequirementUsage [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "owningObjectiveMembership";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The RequirementUsage that is the <code>ownedMemberFeature</code> of this RequirementUsage.</p> \n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.62/@eStructuralFeatures.0";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class OccurrenceDefinition extends Definition, Class {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>An <code>OccurrenceDefinition</code> is a <code>Definition</code> of a <code>Class</code> of individuals that have an independent life over time and potentially an extent over space. This includes both structural things and behaviors that act on such structures. If <code>isIndividual</code> is true, then the <code>OccurrenceDefinition</code> is constrained to have (at most) a single instance that is the entire life of a single individual.</p>\nisIndividual implies specializesFromLibrary('Occurrences::Life')\nisIndividual implies\n    multiplicity <> null and\n    multiplicity.specializesFromLibrary('Base::zeroOrOne')";
    }
    attr isIndividual: EBoolean [1,1] unordered default "false"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Whether this <code>OccurrenceDefinition</code> is constrained to represent at most one thing.</p>";
      };
  }
  class OccurrenceUsage extends Usage {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>An <code>OccurrenceUsage</code> is a <code>Usage</code> whose <code>types</code> are all <code>Classes</code>. Nominally, if a <code>type</code> is an <code>OccurrenceDefinition</code>, an <code>OccurrenceUsage</code> is a <code>Usage</code> of that <code>OccurrenceDefinition</code> within a system. However, other types of Kernel <code>Classes</code> are also allowed, to permit use of <code>Classes</code> from the Kernel Model Libraries.</p>\n\nindividualDefinition =\n    let individualDefinitions : OrderedSet(OccurrenceDefinition) = \n        occurrenceDefinition->\n            selectByKind(OccurrenceDefinition)->\n            select(isIndividual) in\n    if individualDefinitions->isEmpty() then null\n    else individualDefinitions->first() endif\nisIndividual implies individualDefinition <> null\nspecializesFromLibrary('Occurrences::occurrences')\nisComposite and\nowningType <> null and\n(owningType.oclIsKindOf(Class) or\n owningType.oclIsKindOf(OccurrenceUsage) or\n owningType.oclIsKindOf(Feature) and\n    owningType.oclAsType(Feature).type->\n        exists(oclIsKind(Class))) implies\n    specializesFromLibrary('Occurrences::Occurrence::suboccurrences')\noccurrenceDefinition->\n    selectByKind(OccurrenceDefinition)->\n    select(isIndividual).size() <= 1\nportionKind = PortionKind::snapshot implies\n    specializesFromLibrary('Occurrences::Occurrence::snapshots')\nportionKind = PortionKind::timeslice implies \n    specializesFromLibrary('Occurrences::Occurrence::timeSlices')\nportionKind <> null implies\n    owningType <> null and\n    (owningType.oclIsKindOf(OccurrenceDefinition) or\n     owningType.oclIsKindOf(OccurrenceUsage))\nportionKind <> null implies isPortion";
    }
    ref individualDefinition: OccurrenceDefinition [0,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "individualUsage";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The at most one <code>occurrenceDefinition</code> that has <code>isIndividual = true</code>.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.113/@eStructuralFeatures.2";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    attr isIndividual: EBoolean [1,1] unordered default "false"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Whether this <code>OccurrenceUsage</code> represents the usage of the specific individual represented by its <code>individualDefinition</code>.</p>";
      };
    ref occurrenceDefinition: Class [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "definedOccurrence";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Classes</code> that are the types of this <code>OccurrenceUsage</code>. Nominally, these are <code>OccurrenceDefinitions</code>, but other kinds of kernel <code>Classes</code> are also allowed, to permit use of <code>Classes</code> from the Kernel Model Libraries.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.163/@eStructuralFeatures.0";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    attr portionKind: PortionKind [0,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The kind of temporal portion (time slice or snapshot) is represented by this <code>OccurrenceUsage</code>. If <code>portionKind</code> is not null, then the <code>owningType</code> of the <code>OccurrenceUsage</code> must be non-null, and the <code>OccurrenceUsage</code> represents portions of the featuring instance of the <code>owningType</code>.</p>";
      };
  }
  class OperatorExpression extends InvocationExpression {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>An <code>OperatorExpression</code> is an <code>InvocationExpression</code> whose <code>function</code> is determined by resolving its <code>operator</code> in the context of one of the standard packages from the Kernel Function Library.</p>";
    }
    attr operator: EString [1,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>An <code>operator</code> symbol that names a corresponding <code>Function</code> from one of the standard packages from the Kernel Function Library .</p>";
      };
  }
  class OwningMembership extends Membership {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>An <code>OwningMembership</code> is a <code>Membership</code> that owns its <code>memberElement</code> as a <code>ownedRelatedElement</code>. The <code>ownedMemberElement</code> becomes an <code>ownedMember</code> of the <code>membershipOwningNamespace</code>.</p>\n\nownedMemberName = ownedMemberElement.name\nownedMemberShortName = ownedMemberElement.shortName";
    }
    ref ownedMemberElement: Element [1,1] unordered derived transient volatile opposite external "#//@eClassifiers.49/@eStructuralFeatures.12"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Element</code> that becomes an <code>ownedMember</code> of the <code>membershipOwningNamespace</code> due to this <code>OwningMembership</code>.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.96/@eStructuralFeatures.0";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.129/@eStructuralFeatures.1";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    attr ownedMemberElementId: EString [1,1] unordered derived transient volatile
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>elementId</code> of the <code>ownedMemberElement</code>.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.96/@eStructuralFeatures.1";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    attr ownedMemberName: EString [0,1] unordered derived transient volatile
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>name</code> of the <code>ownedMemberElement</code>.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.96/@eStructuralFeatures.2";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    attr ownedMemberShortName: EString [0,1] unordered derived transient volatile
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>shortName</code> of the <code>ownedMemberElement</code>.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.96/@eStructuralFeatures.3";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class Package extends Namespace {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>Package</code> is a <code>Namespace</code> used to group <code>Elements</code>, without any instance-level semantics. It may have one or more model-level evaluable <code>filterCondition</code> <code>Expressions</code> used to filter its <code>importedMemberships</code>. Any imported <code>member</code> must meet all of the <code>filterConditions</code>.</p>\nfilterCondition = ownedMembership->\n    selectByKind(ElementFilterMembership).condition";
    }
    op includeAsMember(element: Element [1,1] unordered) -> EBoolean [1,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Determine whether the given <code>element</code> meets all the <code>filterConditions</code>.</p>\nlet metadataFeatures: Sequence(AnnotatingElement) = \n    element.ownedAnnotation.annotatingElement->\n        selectByKind(MetadataFeature) in\n    self.filterCondition->forAll(cond | \n        metadataFeatures->exists(elem | \n            cond.checkCondition(elem)))";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref filterCondition: Expression [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "conditionedPackage";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The model-level evaluable <code><em>Boolean</em></code>-valued <code>Expression</code> used to filter the <code>members</code> of this <code>Package</code>, which are owned by the <code>Package</code> are via <code>ElementFilterMemberships</code>.</p>\n";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.107/@eStructuralFeatures.4";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class ParameterMembership extends FeatureMembership {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>ParameterMembership</code> is a <code>FeatureMembership</code> that identifies its <code>memberFeature</code> as a parameter, which is always owned, and must have a <code>direction</code>. A <code>ParameterMembership</code> must be owned by a <code>Behavior</code>, a <code>Step</code>, or the <code>result</code> parameter of a <code>ConstructorExpression</code>.</p>\nownedMemberParameter.direction = parameterDirection()\nowningType.oclIsKindOf(Behavior) or owningType.oclIsKindOf(Step) or\nowningType.owningMembership.oclIsKindOf(ReturnParameterMembership) and\n    owningType.owningNamespace.oclIsKindOf(ConstructorExpression)";
    }
    op parameterDirection() -> FeatureDirectionKind [1,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Return the required value of the <code>direction</code> of the <code>ownedMemberParameter</code>. By default, this is <code>in</code>.</p>\nFeatureDirectionKind::_'in'";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref ownedMemberParameter: Feature [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "owningParameterMembership";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Feature</code> that is identified as a <code>parameter</code> by this <code>ParameterMembership</code>.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.62/@eStructuralFeatures.0";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class PartDefinition extends ItemDefinition {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>PartDefinition</code> is an <code>ItemDefinition</code> of a <code>Class</code> of systems or parts of systems. Note that all parts may be considered items for certain purposes, but not all items are parts that can perform actions within a system.</p>\n\nspecializesFromLibrary('Parts::Part')";
    }
  }
  class PartUsage extends ItemUsage {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>PartUsage</code> is a usage of a <code>PartDefinition</code> to represent a system or a part of a system. At least one of the <code>itemDefinitions</code> of the <code>PartUsage</code> must be a <code>PartDefinition</code>.</p>\n\n<p>A <code>PartUsage</code> must subset, directly or indirectly, the base <code>PartUsage</code> <em><code>parts</code></em> from the Systems Model Library.</p>\nitemDefinition->selectByKind(PartDefinition)\npartDefinition->notEmpty()\nspecializesFromLibrary('Parts::parts')\nisComposite and owningType <> null and\n(owningType.oclIsKindOf(ItemDefinition) or\n owningType.oclIsKindOf(ItemUsage)) implies\n    specializesFromLibrary('Items::Item::subparts')\nowningFeatureMembership <> null and\nowningFeatureMembership.oclIsKindOf(ActorMembership) implies\n    if owningType.oclIsKindOf(RequirementDefinition) or \n       owningType.oclIsKindOf(RequirementUsage)\n    then specializesFromLibrary('Requirements::RequirementCheck::actors')\n    else specializesFromLibrary('Cases::Case::actors')\nowningFeatureMembership <> null and\nowningFeatureMembership.oclIsKindOf(StakeholderMembership) implies\n    specializesFromLibrary('Requirements::RequirementCheck::stakeholders')";
    }
    ref partDefinition: PartDefinition [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "definedPart";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>itemDefinitions</code> of this PartUsage that are PartDefinitions.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.86/@eStructuralFeatures.0";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class PayloadFeature extends Feature {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>PayloadFeature</code> is the <code>ownedFeature</code> of a <code>Flow</code> that identifies the things carried by the kinds of transfers that are instances of the <code>Flow</code>.</p>\nredefinesFromLibrary('Transfers::Transfer::payload')";
    }
  }
  class PerformActionUsage extends ActionUsage, EventOccurrenceUsage {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>PerformActionUsage</code> is an <code>ActionUsage</code> that represents the performance of an <code>ActionUsage</code>. Unless it is the <code>PerformActionUsage</code> itself, the <code>ActionUsage</code> to be performed is related to the <code>PerformActionUsage</code> by a <code>ReferenceSubsetting</code> relationship. A <code>PerformActionUsage</code> is also an <code>EventOccurrenceUsage</code>, with its <code>performedAction</code> as the <code>eventOccurrence</code>.</p>\nreferencedFeatureTarget() <> null implies\n    referencedFeatureTarget().oclIsKindOf(ActionUsage)\nowningType <> null and\n(owningType.oclIsKindOf(PartDefinition) or\n owningType.oclIsKindOf(PartUsage)) implies\n    specializesFromLibrary('Parts::Part::performedActions')";
    }
    ref performedAction: ActionUsage [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "performingAction";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>ActionUsage</code> to be performed by this <code>PerformedActionUsage</code>. It is the <code>eventOccurrence</code> of the <code>PerformActionUsage</code> considered as an <code>EventOccurrenceUsage</code>, which must be an <code>ActionUsage</code>.</p> \n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.54/@eStructuralFeatures.0";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class PortConjugation extends Conjugation {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>PortConjugation</code> is a <code>Conjugation</code> <code>Relationship</code> between a <code>PortDefinition</code> and its corresponding <code>ConjugatedPortDefinition</code>. As a result of this <code>Relationship</code>, the <code>ConjugatedPortDefinition</code> inherits all the <code>features</code> of the original <code>PortDefinition</code>, but input <code>flows</code> of the original <code>PortDefinition</code> become outputs on the <code>ConjugatedPortDefinition</code> and output <code>flows</code> of the original <code>PortDefinition</code> become inputs on the <code>ConjugatedPortDefinition</code>.</code></p>\n";
    }
    ref conjugatedPortDefinition: ConjugatedPortDefinition [1,1] unordered derived transient volatile opposite external "#//@eClassifiers.30/@eStructuralFeatures.1"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>ConjugatedPortDefinition</code> that is conjugate to the <code>originalPortDefinition</code>.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.32/@eStructuralFeatures.2";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref originalPortDefinition: PortDefinition [1,1] unordered
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "portConjugation";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>PortDefinition</code> being conjugated.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.32/@eStructuralFeatures.1";
      };
  }
  class PortDefinition extends OccurrenceDefinition, Structure {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>PortDefinition</code> defines a point at which external entities can connect to and interact with a system or part of a system. Any <code>ownedUsages</code> of a <code>PortDefinition</code>, other than <code>PortUsages</code>, must not be composite.</p>\n\n\n\nconjugatedPortDefinition = \nlet conjugatedPortDefinitions : OrderedSet(ConjugatedPortDefinition) =\n    ownedMember->selectByKind(ConjugatedPortDefinition) in\nif conjugatedPortDefinitions->isEmpty() then null\nelse conjugatedPortDefinitions->first()\nendif\nownedUsage->\n    reject(oclIsKindOf(PortUsage))->\n    forAll(not isComposite)\nnot oclIsKindOf(ConjugatedPortDefinition) implies\n    ownedMember->\n        selectByKind(ConjugatedPortDefinition)->\n        size() = 1\nspecializesFromLibrary('Ports::Port')";
    }
    ref conjugatedPortDefinition: ConjugatedPortDefinition [0,1] unordered derived transient volatile opposite external "#//@eClassifiers.30/@eStructuralFeatures.0"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>ConjugatedPortDefinition</code> that is conjugate to this <code>PortDefinition</code>.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.107/@eStructuralFeatures.4";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class PortUsage extends OccurrenceUsage {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>PortUsage</code> is a usage of a <code>PortDefinition</code>. A <code>PortUsage</code> itself as well as all its <code>nestedUsages</code> must be referential (non-composite).</p>\nnestedUsage->\n    reject(oclIsKindOf(PortUsage))->\n    forAll(not isComposite)\nspecializesFromLibrary('Ports::ports')\nisComposite and owningType <> null and\n(owningType.oclIsKindOf(PortDefinition) or\n owningType.oclIsKindOf(PortUsage)) implies\n    specializesFromLibrary('Ports::Port::subports')\nowningType = null or\nnot owningType.oclIsKindOf(PortDefinition) and\nnot owningType.oclIsKindOf(PortUsage) implies\n    isReference\nowningType <> null and\n(owningType.oclIsKindOf(PartDefinition) or\n owningType.oclIsKindOf(PartUsage)) implies\n    specializesFromLibrary('Parts::Part::ownedPorts')";
    }
    ref portDefinition: PortDefinition [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "definedPort";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>occurrenceDefinitions</code> of this <code>PortUsage</code>, which must all be <code>PortDefinitions<code>.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.113/@eStructuralFeatures.2";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  enum PortionKind {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p><code>PortionKind</code> is an enumeration of the specific kinds of <code><em>Occurrence</em></code> portions that can be represented by an <code>OccurrenceUsage</code>.</p>";
    }
    timeslice = 0
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>A time slice of an <code>Occurrence</code> (a portion over time).</p>";
      };
    snapshot = 1
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>A snapshot of an <code>Occurrence</code> (a time slice with zero duration).</p>";
      };
  }
  class Predicate extends Function {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>Predicate</code> is a <code>Function</code> whose <code>result</code> <code>parameter</code> has type <code><em>Boolean</em></code> and multiplicity <code>1..1</code>.</p>\n\nspecializesFromLibrary('Performances::BooleanEvaluation')";
    }
  }
  class Redefinition extends Subsetting {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p><code>Redefinition</code> is a kind of <code>Subsetting</code> that requires the <code>redefinedFeature</code> and the <code>redefiningFeature</code> to have the same values (on each instance of the domain of the <code>redefiningFeature</code>). This means any restrictions on the <code>redefiningFeature</code>, such as <code>type</code> or <code>multiplicity</code>, also apply to the <code>redefinedFeature</code> (on each instance of the domain of the <code>redefiningFeature</code>), and vice versa. The <code>redefinedFeature</code> might have values for instances of the domain of the <code>redefiningFeature</code>, but only as instances of the domain of the <code>redefinedFeature</code> that happen to also be instances of the domain of the <code>redefiningFeature</code>. This is supported by the constraints inherited from <code>Subsetting</code> on the domains of the <code>redefiningFeature</code> and <code>redefinedFeature</code>. However, these constraints are narrowed for <code>Redefinition</code> to require the <code>owningTypes</code> of the <code>redefiningFeature</code> and <code>redefinedFeature</code> to be different and the <code>redefinedFeature</code> to not be inherited into the <code>owningNamespace</code> of the <code>redefiningFeature</code>.This enables the <code>redefiningFeature</code> to have the same name as the <code>redefinedFeature</code>, if desired.</p>\n\nlet anythingType: Type =\n    redefiningFeature.resolveGlobal('Base::Anything').modelElement.oclAsType(Type) in \n-- Including \"Anything\" accounts for implicit featuringType of Features\n-- with no explicit featuringType.\nlet redefiningFeaturingTypes: Set(Type) =\n    if redefiningFeature.isVariable then Set{redefiningFeature.owningType}\n    else redefiningFeature.featuringTypes->asSet()->including(anythingType) \n    endif in\nlet redefinedFeaturingTypes: Set(Type) =\n    if redefinedFeature.isVariable then Set{redefinedFeature.owningType}\n    else redefinedFeature.featuringTypes->asSet()->including(anythingType)\n    endif in\nredefiningFeaturingTypes <> redefinedFeaturingType\nlet featuringTypes : Sequence(Type) =\n    if redefiningFeature.isVariable then Sequence{redefiningFeature.owningType}\n    else redefiningFeature.featuringType\n    endif in\nfeaturingTypes->forAll(t |\n    let direction : FeatureDirectionKind = t.directionOf(redefinedFeature) in\n    ((direction = FeatureDirectionKind::_'in' or \n      direction = FeatureDirectionKind::out) implies\n         redefiningFeature.direction = direction)\n    and \n    (direction = FeatureDirectionKind::inout implies\n        redefiningFeature.direction <> null))\nredefinedFeature.isEnd and\nredefiningFeature.owningType <> null and\n(redefiningFeature.owningType.oclIsKindOf(Association) or\n redefiningFeature.owningType.oclIsKindOf(Connector)) implies\n    redefiningFeature.isEnd";
    }
    ref redefinedFeature: Feature [1,1] unordered
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "redefining";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Feature</code> that is redefined by the <code>redefiningFeature</code> of this <code>Redefinition</code>.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.150/@eStructuralFeatures.1";
      };
    ref redefiningFeature: Feature [1,1] unordered
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "redefinition";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Feature</code> that is redefining the <code>redefinedFeature</code> of this <code>Redefinition</code>.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.150/@eStructuralFeatures.2";
      };
  }
  class ReferenceSubsetting extends Subsetting {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p><code>ReferenceSubsetting</code> is a kind of <code>Subsetting</code> in which the <code>referencedFeature</code> is syntactically distinguished from other <code>Features</code> subsetted by the <code>referencingFeature</code>. <code>ReferenceSubsetting</code> has the same semantics as <code>Subsetting</code>, but the <code>referencedFeature</code> may have a special purpose relative to the <code>referencingFeature</code>. For instance, <code>ReferenceSubsetting</code> is used to identify the <code>relatedFeatures</code> of a <code>Connector</code>.</p>\n\n<p><code>ReferenceSubsetting</code> is always an <code>ownedRelationship</code> of its <code>referencingFeature</code>. A <code>Feature</code> can have at most one <code>ownedReferenceSubsetting</code>.</p>\n";
    }
    ref referencedFeature: Feature [1,1] unordered
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "referencing";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Feature</code> that is referenced by the <code>referencingFeature</code> of this <code>ReferenceSubsetting</code>.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.150/@eStructuralFeatures.1";
      };
    ref referencingFeature: Feature [1,1] unordered derived transient volatile opposite external "#//@eClassifiers.58/@eStructuralFeatures.18"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Feature</code> that owns this <code>ReferenceSubsetting</code> relationship, which is also its <code>subsettingFeature</code>.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.150/@eStructuralFeatures.0";
        reference "#//@eClassifiers.150/@eStructuralFeatures.2";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class ReferenceUsage extends Usage {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>ReferenceUsage</code> is a <code>Usage</code> that specifies a non-compositional (<code>isComposite = false</code>) reference to something. The <code>definition</code> of a <code>ReferenceUsage</code> can be any kind of <code>Classifier</code>, with the default being the top-level <code>Classifier</code> <code><em>Base::Anything</em></code> from the Kernel Semantic Library. This allows the specification of a generic reference without distinguishing if the thing referenced is an attribute value, item, action, etc.</p>\nisReference";
    }
  }
  abstract class Relationship extends Element {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>Relationship</code> is an <code>Element</code> that relates other <code>Element</code>. Some of its <code>relatedElements</code> may be owned, in which case those <code>ownedRelatedElements</code> will be deleted from a model if their <code>owningRelationship</code> is. A <code>Relationship</code> may also be owned by another <code>Element</code>, in which case the <code>ownedRelatedElements</code> of the <code>Relationship</code> are also considered to be transitively owned by the <code>owningRelatedElement</code> of the <code>Relationship</code>.</p>\n\n<p>The <code>relatedElements</code> of a <code>Relationship</code> are divided into <code>source</code> and <code>target</code> <code>Elements</code>. The <code>Relationship</code> is considered to be directed from the <code>source</code> to the <code>target</code> <code>Elements</code>. An undirected <code>Relationship</code> may have either all <code>source</code> or all <code>target</code> <code>Elements</code>.</p>\n\n<p>A &quot;relationship <code>Element</code>&quot; in the abstract syntax is generically any <code>Element</code> that is an instance of either <code>Relationship</code> or a direct or indirect specialization of <code>Relationship</code>. Any other kind of <code>Element</code> is a &quot;non-relationship <code>Element</code>&quot;. It is a convention of that non-relationship <code>Elements</code> are <em>only</em> related via reified relationship <code>Elements</code>. Any meta-associations directly between non-relationship <code>Elements</code> must be derived from underlying reified <code>Relationship</code>.</p>\n\nrelatedElement = source->union(target)";
    }
    attr isImplied: EBoolean [1,1] unordered default "false"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Whether this Relationship was generated by tooling to meet semantic rules, rather than being directly created by a modeler.</p>";
      };
    ref ownedRelatedElement: Element [0,*] containment opposite external "#//@eClassifiers.49/@eStructuralFeatures.14"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <tt>relatedElements</tt> of this Relationship that are owned by the Relationship.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.129/@eStructuralFeatures.3";
      };
    ref owningRelatedElement: Element [0,1] unordered opposite external "#//@eClassifiers.49/@eStructuralFeatures.10"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <tt>relatedElement</tt> of this Relationship that owns the Relationship, if any.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.129/@eStructuralFeatures.3";
      };
    ref relatedElement: Element [0,*] nonunique derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "relationship";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The Elements that are related by this Relationship, derived as the union of the <code>source</code> and <code>target</code> Elements of the Relationship.</p>";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref source: Element [0,*]
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "sourceRelationship";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>relatedElements</c ode> from which this Relationship is considered to be directed.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.129/@eStructuralFeatures.3";
      };
    ref target: Element [0,*]
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "targetRelationship";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>relatedElements</code> to which this Relationship is considered to be directed.</p>\n";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.129/@eStructuralFeatures.3";
      };
  }
  class RenderingDefinition extends PartDefinition {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>RenderingDefinition</code> is a <code>PartDefinition</code> that defines a specific rendering of the content of a model view (e.g., symbols, style, layout, etc.).</p>\nrendering = usages->selectByKind(RenderingUsage)\nspecializesFromLibrary('Views::Rendering')";
    }
    ref rendering: RenderingUsage [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "featuringRenderingDefinition";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>usages</code> of a <code>RenderingDefinition</code> that are <code>RenderingUsages</code>.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.44/@eStructuralFeatures.29";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class RenderingUsage extends PartUsage {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>RenderingUsage</code> is the usage of a <code>RenderingDefinition</code> to specify the rendering of a specific model view to produce a physical view artifact.</p>\n\n\nspecializesFromLibrary('Views::renderings')\nowningType <> null and\n(owningType.oclIsKindOf(RenderingDefinition) or\n owningType.oclIsKindOf(RenderingUsage)) implies\n    specializesFromLibrary('Views::Rendering::subrenderings')\nowningFeatureMembership <> null and\nowningFeatureMembership.oclIsKindOf(ViewRenderingMembership) implies\n    redefinesFromLibrary('Views::View::viewRendering')";
    }
    ref renderingDefinition: RenderingDefinition [0,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "definedRendering";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>RenderingDefinition</code> that is the <code>definition</code> of this <code>RenderingUsage</code>.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.119/@eStructuralFeatures.0";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  enum RequirementConstraintKind {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>RequirementConstraintKind</code> indicates whether a <code>ConstraintUsage</code> is an assumption or a requirement in a <code>RequirementDefinition</code> or <code>RequirementUsage</code>.</p>";
    }
    assumption = 0
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Indicates that a member <code>ConstraintUsage</code> of a <code>RequirementDefinition</code> or <code>RequirementUsage</code> represents an assumption.</p>";
      };
    requirement = 1
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Indicates that a member <code>ConstraintUsage</code> of a <code>RequirementDefinition</code> or <code>RequirementUsage</code>represents an requirement.</p>";
      };
  }
  class RequirementConstraintMembership extends FeatureMembership {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>RequirementConstraintMembership</code> is a <code>FeatureMembership</code> for an assumed or required <code>ConstraintUsage</code> of a <code>RequirementDefinition</code> or <code>RequirementUsage<code>.</p>\nreferencedConstraint =\n    let referencedFeature : Feature = \n        ownedConstraint.referencedFeatureTarget() in\n    if referencedFeature = null then ownedConstraint\n    else if referencedFeature.oclIsKindOf(ConstraintUsage) then\n        refrencedFeature.oclAsType(ConstraintUsage)\n    else null\n    endif endif\nowningType.oclIsKindOf(RequirementDefinition) or\nowningType.oclIsKindOf(RequirementUsage)\nownedConstraint.isComposite";
    }
    attr kind: RequirementConstraintKind [1,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Whether the <code>RequirementConstraintMembership</code> is for an assumed or required <code>ConstraintUsage</code>.</p>";
      };
    ref ownedConstraint: ConstraintUsage [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "requirementConstraintMembership";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>ConstraintUsage</code> that is the <code>ownedMemberFeature</code> of this <code>RequirementConstraintMembership</code>.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.62/@eStructuralFeatures.0";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref referencedConstraint: ConstraintUsage [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "referencingConstraintMembership";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p> The <code>ConstraintUsage</code> that is referenced through this <code>RequirementConstraintMembership</code>. It is the <code>referencedFeature</code> of the <code>ownedReferenceSubsetting</code> of the <code>ownedConstraint</code>, if there is one, and, otherwise, the <code>ownedConstraint</code> itself.</p>";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class RequirementDefinition extends ConstraintDefinition {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>RequirementDefinition</code> is a <code>ConstraintDefinition</code> that defines a requirement used in the context of a specification as a constraint that a valid solution must satisfy. The specification is relative to a specified subject, possibly in collaboration with one or more external actors.</p>\ntext = documentation.body\nassumedConstraint = ownedFeatureMembership->\n    selectByKind(RequirementConstraintMembership)->\n    select(kind = RequirementConstraintKind::assumption).\n    ownedConstraint\nrequiredConstraint = ownedFeatureMembership->\n    selectByKind(RequirementConstraintMembership)->\n    select(kind = RequirementConstraintKind::requirement).\n    ownedConstraint\nsubjectParameter =\n    let subjects : OrderedSet(SubjectMembership) = \n        featureMembership->selectByKind(SubjectMembership) in\n    if subjects->isEmpty() then null\n    else subjects->first().ownedSubjectParameter\n    endif\nframedConcern = featureMembership->\n    selectByKind(FramedConcernMembership).\n    ownedConcern\nactorParameter = featureMembership->\n    selectByKind(ActorMembership).\n    ownedActorParameter\nstakeholderParameter = featureMembership->\n    selectByKind(StakholderMembership).\n    ownedStakeholderParameter\nfeatureMembership->\t\n    selectByKind(SubjectMembership)->\n    size() <= 1\ninput->notEmpty() and input->first() = subjectParameter\nspecializesFromLibrary('Requirements::RequirementCheck')";
    }
    ref actorParameter: PartUsage [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "actorOwningRequirementDefinition";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>parameters</code> of this <code>RequirementDefinition</code> that represent actors involved in the requirement.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.16/@eStructuralFeatures.0";
        reference "#//@eClassifiers.44/@eStructuralFeatures.29";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref assumedConstraint: ConstraintUsage [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "assumingRequirementDefinition";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The owned <code>ConstraintUsages</code> that represent assumptions of this <code>RequirementDefinition</code>, which are the <code>ownedConstraints</code> of the <code>RequirementConstraintMemberships</code> of the <code>RequirementDefinition</code> with <code>kind = assumption</code>.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.160/@eStructuralFeatures.18";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref framedConcern: ConcernUsage [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "framingRequirementDefinition";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>ConcernUsages</code> framed by this <code>RequirementDefinition</code>, which are the <code>ownedConcerns</code> of all <code>FramedConcernMemberships</code> of the <code>RequirementDefinition</code>.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.133/@eStructuralFeatures.4";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    attr reqId: EString [0,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>An optional modeler-specified identifier for this <code>RequirementDefinition</code> (used, e.g., to link it to an original requirement text in some source document), which is the <code>declaredShortName</code> for the <code>RequirementDefinition</code>.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.49/@eStructuralFeatures.2";
      };
    ref requiredConstraint: ConstraintUsage [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "requiringRequirementDefinition";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The owned <code>ConstraintUsages</code> that represent requirements of this <code>RequirementDefinition</code>, derived as the <code>ownedConstraints</code> of the <code>RequirementConstraintMemberships</code> of the <code>RequirementDefinition</code> with <code>kind</code> = <code>requirement</code>.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.160/@eStructuralFeatures.18";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref stakeholderParameter: PartUsage [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "stakholderOwiningRequirementDefinition";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>parameters</code> of this <code>RequirementDefinition</code> that represent stakeholders for the requirement.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.16/@eStructuralFeatures.0";
        reference "#//@eClassifiers.44/@eStructuralFeatures.29";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref subjectParameter: Usage [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "subjectOwningRequirementDefinition";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>parameter</code> of this <code>RequirementDefinition</code> that represents its subject.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.16/@eStructuralFeatures.0";
        reference "#//@eClassifiers.44/@eStructuralFeatures.29";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    attr text: EString [0,*] unordered derived transient volatile
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>An optional textual statement of the requirement represented by this <code>RequirementDefinition</code>, derived from the <code>bodies</code> of the <code>documentation</code> of the <code>RequirementDefinition</code>.</p>\n";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class RequirementUsage extends ConstraintUsage {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>RequirementUsage</code> is a <code>Usage</code> of a <code>RequirementDefinition</code>.</p>\nactorParameter = featureMembership->\n    selectByKind(ActorMembership).\n    ownedActorParameter\nassumedConstraint = ownedFeatureMembership->\n    selectByKind(RequirementConstraintMembership)->\n    select(kind = RequirementConstraintKind::assumption).\n    ownedConstraint\nframedConcern = featureMembership->\n    selectByKind(FramedConcernMembership).\n    ownedConcern\nrequiredConstraint = ownedFeatureMembership->\n    selectByKind(RequirementConstraintMembership)->\n    select(kind = RequirementConstraintKind::requirement).\n    ownedConstraint\nstakeholderParameter = featureMembership->\n    selectByKind(AStakholderMembership).\n    ownedStakeholderParameter\nsubjectParameter =\n    let subjects : OrderedSet(SubjectMembership) = \n        featureMembership->selectByKind(SubjectMembership) in\n    if subjects->isEmpty() then null\n    else subjects->first().ownedSubjectParameter\n    endif\ntext = documentation.body\nfeatureMembership->\n    selectByKind(SubjectMembership)->\n    size() <= 1\ninput->notEmpty() and input->first() = subjectParameter\nspecializesFromLibrary('Requirements::requirementChecks')\nisComposite and owningType <> null and\n    (owningType.oclIsKindOf(RequirementDefinition) or\n     owningType.oclIsKindOf(RequirementUsage)) and \n    not owningFeatureMembership.oclIsKindOf(RequirementConstraintMembership) implies\n    specializesFromLibrary('Requirements::RequirementCheck::subrequirements')\nowningfeatureMembership <> null and\nowningfeatureMembership.oclIsKindOf(ObjectiveMembership) implies\n    owningType.ownedSpecialization.general->forAll(gen |\n        (gen.oclIsKindOf(CaseDefinition) implies\n            redefines(gen.oclAsType(CaseDefinition).objectiveRequirement)) and\n        (gen.oclIsKindOf(Feature) and \n         gen.oclAsType(Feature).featureTarget.oclIsKindOf(CaseUsage) implies\n            redefines(gen.oclAsType(Feature).featureTarget.\n                        oclAsType(CaseUsage).objectiveRequirement))\nowningFeatureMembership <> null and\nowningFeatureMembership.oclIsKindOf(RequirementVerificationMembership) implies\n    specializesFromLibrary('VerificationCases::VerificationCase::obj::requirementVerifications')";
    }
    ref actorParameter: PartUsage [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "actorOwningRequirement";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>parameters</code> of this <code>RequirementUsage</code> that represent actors involved in the requirement.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.146/@eStructuralFeatures.1";
        reference "#//@eClassifiers.163/@eStructuralFeatures.34";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref assumedConstraint: ConstraintUsage [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "assumingRequirement";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The owned <code>ConstraintUsages</code> that represent assumptions of this <code>RequirementUsage</code>, derived as the <code>ownedConstraints</code> of the <code>RequirementConstraintMemberships</code> of the <code>RequirementUsage</code> with <code>kind</code> = <code>assumption</code>.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.160/@eStructuralFeatures.18";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref framedConcern: ConcernUsage [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "framingRequirement";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>ConcernUsages</code> framed by this <code>RequirementUsage</code>, which are the <code>ownedConcerns</code> of all <code>FramedConcernMemberships</code> of the <code>RequirementUsage</code>.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.134/@eStructuralFeatures.4";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    attr reqId: EString [0,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>An optional modeler-specified identifier for this <code>RequirementUsage</code> (used, e.g., to link it to an original requirement text in some source document), which is the <code>declaredShortName</code> for the <code>RequirementUsage</code>.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.49/@eStructuralFeatures.2";
      };
    ref requiredConstraint: ConstraintUsage [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "requiringRequirement";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The owned <code>ConstraintUsages</code> that represent requirements of this <code>RequirementUsage</code>, which are the <code>ownedConstraints</code> of the <code>RequirementConstraintMemberships</code> of the <code>RequirementUsage</code> with <code>kind</code> = <code>requirement</code>.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.160/@eStructuralFeatures.18";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref requirementDefinition: RequirementDefinition [0,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "definedRequirement";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>RequirementDefinition</code> that is the single <code>definition</code> of this <code>RequirementUsage</code>.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.38/@eStructuralFeatures.0";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref stakeholderParameter: PartUsage [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "stakholderOwningRequirement";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>parameters</code> of this <code>RequirementUsage</code> that represent stakeholders for the requirement.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.146/@eStructuralFeatures.1";
        reference "#//@eClassifiers.163/@eStructuralFeatures.34";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref subjectParameter: Usage [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "subjectOwningRequirement";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>parameter</code> of this <code>RequirementUsage</code> that represents its subject.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.146/@eStructuralFeatures.1";
        reference "#//@eClassifiers.163/@eStructuralFeatures.34";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    attr text: EString [0,*] unordered derived transient volatile
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>An optional textual statement of the requirement represented by this <code>RequirementUsage</code>, derived from the <code>bodies<code> of the <code>documentation</code> of the <code>RequirementUsage</code>.</p>";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class RequirementVerificationMembership extends RequirementConstraintMembership {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>RequirementVerificationMembership</code> is a <code>RequirementConstraintMembership </code> used in the objective of a <code>VerificationCase</code> to identify a <code>RequirementUsage</code> that is verified by the <code>VerificationCase</code>.</p>\nkind = RequirementConstraintKind::requirement\nowningType.oclIsKindOf(RequirementUsage) and\nowningType.owningFeatureMembership <> null and\nowningType.owningFeatureMembership.oclIsKindOf(ObjectiveMembership)";
    }
    ref ownedRequirement: RequirementUsage [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "requirementVerificationMembership";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The owned <code>RequirementUsage</code> that acts as the <code>ownedConstraint</code> for this <code>RequirementVerificationMembership</code>. This will either be the <code>verifiedRequirement</code>, or it will subset the <code>verifiedRequirement</code>.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.132/@eStructuralFeatures.1";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref verifiedRequirement: RequirementUsage [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "requirementVerification";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p> The <code>RequirementUsage</code> that is identified as being verified. It is the <code>referencedConstraint</code> of the <code>RequirementVerificationMembership</code> considered as a <code>RequirementConstraintMembership</code>, which must be a <code>RequirementUsage</code>.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.132/@eStructuralFeatures.2";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class ResultExpressionMembership extends FeatureMembership {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>ResultExpressionMembership</code> is a <code>FeatureMembership</code> that indicates that the <code>ownedResultExpression</code> provides the result values for the <code>Function</code> or <code>Expression</code> that owns it. The owning <code>Function</code> or <code>Expression</code> must contain a <code>BindingConnector</code> between the <code>result</code> <code>parameter</code> of the <code>ownedResultExpression</code> and the <code>result</code> <code>parameter</code> of the owning <code>Function</code> or <code>Expression</code>.</p>\n\nowningType.oclIsKindOf(Function) or owningType.oclIsKindOf(Expression)";
    }
    ref ownedResultExpression: Expression [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "owningResultExpressionMembership";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Expression</code> that provides the result for the owner of the <code>ResultExpressionMembership</code>.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.62/@eStructuralFeatures.0";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class ReturnParameterMembership extends ParameterMembership {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>ReturnParameterMembership</code> is a <code>ParameterMembership</code> that indicates that the <code>ownedMemberParameter</code> is the <code>result</code> <code>parameter</code> of a <code>Function</code> or <code>Expression</code>. The <code>direction</code> of the <code>ownedMemberParameter</code> must be <code>out</code>.</p>\n\nowningType.oclIsKindOf(Function) or owningType.oclIsKindOf(Expression)";
    }
  }
  class SatisfyRequirementUsage extends RequirementUsage, AssertConstraintUsage {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>SatisfyRequirementUsage</code> is an <code>AssertConstraintUsage</code> that asserts, by default, that a satisfied <code>RequirementUsage</code> is true for a specific <code>satisfyingFeature</code>, or, if <code>isNegated = true</code>, that the <code>RequirementUsage</code> is false. The satisfied <code>RequirementUsage</code> is related to the <code>SatisfyRequirementUsage</code> by a <code>ReferenceSubsetting</code> <code>Relationship</code>.</p>\nsatisfyingFeature =\n    let bindings: BindingConnector = ownedMember->\n        selectByKind(BindingConnector)->\n        select(b | b.relatedElement->includes(subjectParameter)) in\n    if bindings->isEmpty() or \n       not bindings->first().relatedElement->exits(r | r <> subjectParameter) \n    then null\n    else bindings->first().relatedElement->any(r | r <> subjectParameter)\n    endif\nownedMember->selectByKind(BindingConnector)->\n    select(b |\n        b.relatedElement->includes(subjectParameter) and\n        b.relatedElement->exists(r | r <> subjectParameter))->\n    size() = 1\nreferencedFeatureTarget() <> null implies\n    referencedFeatureTarget().oclIsKindOf(RequirementUsage)\nif isNegated then\n    specializesFromLibrary('Requirements::notSatisfiedRequirementChecks')\nelse\n    specializesFromLibrary('Requirements::satisfiedRequirementChecks')\nendif";
    }
    ref satisfiedRequirement: RequirementUsage [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "requirementSatisfaction";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>RequirementUsage</code> that is satisfied by the <code>satisfyingSubject</code> of this <code>SatisfyRequirementUsage</code>. It is the <code>assertedConstraint</code> of the <code>SatisfyRequirementUsage</code> considered as an <code>AssertConstraintUsage</code>, which must be a <code>RequirementUsage</code>.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.10/@eStructuralFeatures.0";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref satisfyingFeature: Feature [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "satisfiedRequirement";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Feature</code> that represents the actual subject that is asserted to satisfy the <code>satisfiedRequirement</code>. The <code>satisfyingFeature</code> is bound to the <code>subjectParameter</code> of the <code>SatisfyRequirementUsage</code>.</p>";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class SelectExpression extends OperatorExpression {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>SelectExpression</code> is an <code>OperatorExpression</code> whose operator is <code>\"select\"</code>, which resolves to the <code>Function</code> <em><code>ControlFunctions::select</code></em> from the Kernel Functions Library.</p>\noperator = 'select'\narguments->notEmpty() implies\n    result.specializes(arguments->first().result)";
    }
  }
  class SendActionUsage extends ActionUsage {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>SendActionUsage</code> is an <code>ActionUsage</code> that specifies the sending of a payload given by the result of its <code>payloadArgument</code> <code>Expression</code> via a <em><code>MessageTransfer</code></em> whose <em><code>source</code></em> is given by the result of the <code>senderArgument</code> <code>Expression</code> and whose <code>target</code> is given by the result of the <code>receiverArgument</code> <code>Expression</code>. If no <code>senderArgument</code> is provided, the default is the <em><code>this</code></em> context for the action. If no <code>receiverArgument</code> is given, then the receiver is to be determined by, e.g., outgoing <em><code>Connections</code></em> from the sender.</p> \n\nsenderArgument = argument(2)\npayloadArgument = argument(1)\nowningFeatureMembership <> null and\n(owningFeatureMembership.oclIsKindOf(StateSubactionMembership) or\n owningFeatureMembership.oclIsKindOf(TransitionFeatureMembership)) implies\n    payloadArgument <> null\nreceiverArgument = argument(3)\nisSubactionUsage() implies\n    specializesFromLibrary('Actions::Action::sendSubactions')\nspecializesFromLibrary('Actions::sendActions')";
    }
    ref payloadArgument: Expression [0,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "sendingActionUsage";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>An <code>Expression</code> whose result is bound to the <code><em>payload</em></code> input parameter of this <code>SendActionUsage</code>.</p> \n";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref receiverArgument: Expression [0,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "sendActionUsage";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>An <code>Expression</code> whose result is bound to the <em><code>receiver</code></em> input parameter of this <code>SendActionUsage</code>.</p> \n";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref senderArgument: Expression [0,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "senderActionUsage";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>An <code>Expression</code> whose result is bound to the <em><code>sender</code></em> input parameter of this <code>SendActionUsage</code>.</p> \n";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class Specialization extends Relationship {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p><code>Specialization</code> is a <code>Relationship</code> between two <code>Types</code> that requires all instances of the <code>specific</code> type to also be instances of the <code>general</code> Type (i.e., the set of instances of the <code>specific</code> Type is a <em>subset</em> of those of the <code>general</code> Type, which might be the same set).</p>\n\nnot specific.isConjugated";
    }
    ref general: Type [1,1] unordered
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "generalization";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>A <code>Type</code> with a superset of all instances of the <code>specific</code> <code>Type</code>, which might be the same set.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.129/@eStructuralFeatures.5";
      };
    ref owningType: Type [0,1] unordered derived transient volatile opposite external "#//@eClassifiers.160/@eStructuralFeatures.21"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Type</code> that is the <code>specific</code> <code>Type</code> of this <code>Specialization</code> and owns it as its <code>owningRelatedElement</code>.</p>\n";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.129/@eStructuralFeatures.2";
        reference "#//@eClassifiers.141/@eStructuralFeatures.2";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref specific: Type [1,1] unordered
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "specialization";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>A <code>Type</code> with a subset of all instances of the <code>general</code> <code>Type</code>, which might be the same set.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.129/@eStructuralFeatures.4";
      };
  }
  class StakeholderMembership extends ParameterMembership {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>StakeholderMembership</code> is a <code>ParameterMembership</code> that identifies a <code>PartUsage</code> as a <code>stakeholderParameter</code> of a <code>RequirementDefinition</code> or <code>RequirementUsage</code>, which specifies a role played by an entity with concerns framed by the <code>owningType</code>.</p>\nowningType.oclIsKindOf(RequirementUsage) or\nowningType.oclIsKindOf(RequirementDefinition)";
    }
    ref ownedStakeholderParameter: PartUsage [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "owningStakeholderMembership";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>PartUsage</code> specifying the stakeholder.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.117/@eStructuralFeatures.0";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class StateDefinition extends ActionDefinition {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>StateDefinition</code> is the <code>Definition</code> of the </code>Behavior</code> of a system or part of a system in a certain state condition.</p>\n\n<p>A <code>StateDefinition</code> may be related to up to three of its <code>ownedFeatures</code> by <code>StateBehaviorMembership</code> <code>Relationships</code>, all of different <code>kinds</code>, corresponding to the entry, do and exit actions of the <code>StateDefinition</code>.</p>\nspecializesFromLibrary('States::StateAction')\nownedMembership->\n    selectByKind(StateSubactionMembership)->\n    isUnique(kind)\nstate = action->selectByKind(StateUsage)\ndoAction =\n    let doMemberships : Sequence(StateSubactionMembership) =\n        ownedMembership->\n            selectByKind(StateSubactionMembership)->\n            select(kind = StateSubactionKind::do) in\n    if doMemberships->isEmpty() then null\n    else doMemberships->at(1)\n    endif\nentryAction =\n    let entryMemberships : Sequence(StateSubactionMembership) =\n        ownedMembership->\n            selectByKind(StateSubactionMembership)->\n            select(kind = StateSubactionKind::entry) in\n    if entryMemberships->isEmpty() then null\n    else entryMemberships->at(1)\n    endif\nisParallel implies\n    ownedAction.incomingTransition->isEmpty() and\n    ownedAction.outgoingTransition->isEmpty()\nexitAction = \n    let exitMemberships : Sequence(StateSubactionMembership) =\n        ownedMembership->\n            selectByKind(StateSubactionMembership)->\n            select(kind = StateSubactionKind::exit) in\n    if exitMemberships->isEmpty() then null\n    else exitMemberships->at(1)\n    endif";
    }
    ref doAction: ActionUsage [0,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "activeStateDefintion";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>ActionUsage</code> of this <code>StateDefinition</code> to be performed while in the state defined by the <code>StateDefinition</code>. It is the owned <code>ActionUsage</code> related to the <code>StateDefinition</code> by a <code>StateSubactionMembership</code>  with <code>kind = do</code>.</p>";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref entryAction: ActionUsage [0,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "enteredStateDefinition";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>ActionUsage</code> of this <code>StateDefinition</code> to be performed on entry to the state defined by the <code>StateDefinition</code>. It is the owned <code>ActionUsage</code> related to the <code>StateDefinition</code> by a <code>StateSubactionMembership</code>  with <code>kind = entry</code>.</p>";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref exitAction: ActionUsage [0,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "exitedStateDefinition";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>ActionUsage</code> of this <code>StateDefinition</code> to be performed on exit to the state defined by the <code>StateDefinition</code>. It is the owned <code>ActionUsage</code> related to the <code>StateDefinition</code> by a <code>StateSubactionMembership</code>  with <code>kind = exit</code>.</p>";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    attr isParallel: EBoolean [1,1] unordered default "false"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Whether the <code>ownedStates</code> of this <code>StateDefinition</code> are to all be performed in parallel. If true, none of the <code>ownedActions</code> (which includes <code>ownedStates</code>) may have any incoming or outgoing <code>Transitions</code>. If false, only one <code>ownedState</code> may be performed at a time.</p>\n";
      };
    ref state: StateUsage [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "featuringStateDefinition";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>StateUsages</code>, which are <code>actions</code> in the <code>StateDefinition</code>, that specify the discrete states in the behavior defined by the <code>StateDefinition</code>.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.1/@eStructuralFeatures.0";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  enum StateSubactionKind {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>StateSubactionKind</code> indicates whether the <code>action</code> of a StateSubactionMembership is an entry, do or exit action.</p>";
    }
    entry = 0
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Indicates that the <code>action</code> of a <code>StateSubactionMembership</code> is an <code>entryAction</code>.</p>";
      };
    do = 1
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Indicates that the <code>action</code> of a <code>StateSubactionMembership</code> is a <code>doAction</code>.</p>";
      };
    exit = 2
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Indicates that the <code>action</code> of a <code>StateSubactionMembership</code> is an <code>exitAction</code>.</p>";
      };
  }
  class StateSubactionMembership extends FeatureMembership {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>StateSubactionMembership</code> is a <code>FeatureMembership</code> for an entry, do or exit <code>ActionUsage<code> of a <code>StateDefinition</code> or <code>StateUsage</code>.</p>\nowningType.oclIsKindOf(StateDefinition) or\nowningType.oclIsKindOf(StateUsage)";
    }
    ref action: ActionUsage [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "stateSubactionMembership";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>ActionUsage</code> that is the <code>ownedMemberFeature</code> of this <code>StateSubactionMembership</code>.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.62/@eStructuralFeatures.0";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    attr kind: StateSubactionKind [1,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Whether this <code>StateSubactionMembership</code> is for an <code>entry<code>, <code>do</code> or <code>exit</code> <code>ActionUsage</code>.</p>";
      };
  }
  class StateUsage extends ActionUsage {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>StateUsage</code> is an <code>ActionUsage</code> that is nominally the <code>Usage</code> of a <code>StateDefinition</code>. However, other kinds of kernel <code>Behaviors</code> are also allowed as <code>types</code>, to permit use of <code>Behaviors</code from the Kernel Model Libraries.</p>\n\n<p>A <code>StateUsage</code> may be related to up to three of its <code>ownedFeatures</code> by <code>StateSubactionMembership</code> <code>Relationships</code>, all of different <code>kinds</code>, corresponding to the entry, do and exit actions of the <code>StateUsage</code>.</p>\n\ndoAction =\n    let doMemberships : Sequence(StateSubactionMembership) =\n        ownedMembership->\n            selectByKind(StateSubactionMembership)->\n            select(kind = StateSubactionKind::do) in\n    if doMemberships->isEmpty() then null\n    else doMemberships->at(1)\n    endif\nentryAction =\n    let entryMemberships : Sequence(StateSubactionMembership) =\n        ownedMembership->\n            selectByKind(StateSubactionMembership)->\n            select(kind = StateSubactionKind::entry) in\n    if entryMemberships->isEmpty() then null\n    else entryMemberships->at(1)\n    endif\nisParallel implies\n    nestedAction.incomingTransition->isEmpty() and\n    nestedAction.outgoingTransition->isEmpty()\nisSubstateUsage(false) implies\n    specializesFromLibrary('States::StateAction::exclusiveStates')\nexitAction =\n    let exitMemberships : Sequence(StateSubactionMembership) =\n        ownedMembership->\n            selectByKind(StateSubactionMembership)->\n            select(kind = StateSubactionKind::exit) in\n    if exitMemberships->isEmpty() then null\n    else exitMemberships->at(1)\n    endif\nspecializesFromLibrary('States::stateActions')\nownedMembership->\n    selectByKind(StateSubactionMembership)->\n    isUnique(kind)\nisSubstateUsage(true) implies\n    specializesFromLibrary('States::StateAction::substates')\nisComposite and owningType <> null and\n(owningType.oclIsKindOf(PartDefinition) or\n owningType.oclIsKindOf(PartUsage)) implies\n    specializesFromLibrary('Parts::Part::ownedStates')";
    }
    op isSubstateUsage(isParallel: EBoolean [1,1] unordered) -> EBoolean [1,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Check if this <code>StateUsage</code> is composite and has an <code>owningType</code> that is a <code>StateDefinition</code> or <code>StateUsage</code> with the given value of <code>isParallel</code>, but is <em>not</em> an <code>entryAction</code>, <code>doAction</code>, or <code>exitAction</code>. If so, then it represents a <code><em>StateAction</em></code> that is a <code><em>substate</em></code> or <code><em>exclusiveState</em></code> (for <code>isParallel = false</code>) of another <code><em>StateAction</em></code>.</p>\nisComposite and owningType <> null and\n(owningType.oclIsKindOf(StateDefinition) and\n    owningType.oclAsType(StateDefinition).isParallel = isParallel or\n owningType.oclIsKindOf(StateUsage) and\n    owningType.oclAsType(StateUsage).isParallel = isParallel) and\nnot owningFeatureMembership.oclIsKindOf(StateSubactionMembership)";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref doAction: ActionUsage [0,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "activeState";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>ActionUsage</code> of this <code>StateUsage</code> to be performed while in the state defined by the <code>StateDefinition</code>. It is the owned <code>ActionUsage</code> related to the <code>StateUsage</code> by a <code>StateSubactionMembership</code>  with <code>kind = do</code>.</p>";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref entryAction: ActionUsage [0,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "enteredState";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>ActionUsage</code> of this <code>StateUsage</code> to be performed on entry to the state defined by the <code>StateDefinition</code>. It is the owned <code>ActionUsage</code> related to the <code>StateUsage</code> by a <code>StateSubactionMembership</code>  with <code>kind = entry</code>.</p>";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref exitAction: ActionUsage [0,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "exitedState";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>ActionUsage</code> of this <code>StateUsage</code> to be performed on exit to the state defined by the <code>StateDefinition</code>. It is the owned <code>ActionUsage</code> related to the <code>StateUsage</code> by a <code>StateSubactionMembership</code>  with <code>kind = exit</code>.</p>";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    attr isParallel: EBoolean [1,1] unordered default "false"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Whether the <code>nestedStates</code> of this <code>StateUsage</code> are to all be performed in parallel. If true, none of the <code>nestedActions</code> (which include <code>nestedStates</code>) may have any incoming or outgoing <code>Transitions</code>. If false, only one <code>nestedState</code> may be performed at a time.</p>\n";
      };
    ref stateDefinition: Behavior [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "definedState";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Behaviors</code> that are the <code>types</code> of this <code>StateUsage</code>. Nominally, these would be <code>StateDefinitions</code>, but kernel <code>Behaviors</code> are also allowed, to permit use of <code>Behaviors</code> from the Kernel Model Libraries.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.2/@eStructuralFeatures.0";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class Step extends Feature {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>Step</code> is a <code>Feature</code> that is typed by one or more <code>Behaviors</code>. <code>Steps</code> may be used by one <code>Behavior</code> to coordinate the performance of other <code>Behaviors</code>, supporting a steady refinement of behavioral descriptions. <code>Steps</code> can be ordered in time and can be connected using <code>Flows</code> to specify things flowing between their <code>parameters</code>.</p>\n\nspecializesFromLibrary('Performances::performances')\nowningType <> null and\n    (owningType.oclIsKindOf(Behavior) or\n     owningType.oclIsKindOf(Step)) implies\n    specializesFromLibrary('Performances::Performance::enclosedPerformance')\nisComposite and owningType <> null and\n(owningType.oclIsKindOf(Structure) or\n owningType.oclIsKindOf(Feature) and\n owningType.oclAsType(Feature).type->\n    exists(oclIsKindOf(Structure)) implies\n    specializesFromLibrary('Objects::Object::ownedPerformance')\nowningType <> null and\n    (owningType.oclIsKindOf(Behavior) or\n     owningType.oclIsKindOf(Step)) and\n    self.isComposite implies\n    specializesFromLibrary('Performances::Performance::subperformance')\nbehavior = type->selectByKind(Behavior)";
    }
    ref `behavior`: Behavior [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "typedStep";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Behaviors</code> that type this <code>Step</code>.</p>\n";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.58/@eStructuralFeatures.24";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref `parameter`: Feature [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "parameteredStep";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>parameters</code> of this <code>Step</code>, which are defined as its <code>directedFeatures</code>, whose values are passed into and/or out of a performance of the <code>Step</code>.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.160/@eStructuralFeatures.1";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class Structure extends Class {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>Structure</code> is a <code>Class</code> of objects in the modeled universe that are primarily structural in nature. While such an object is not itself behavioral, it may be involved in and acted on by <code>Behaviors</code>, and it may be the performer of some of them.</p>\n\nspecializesFromLibrary('Objects::Object')\nownedSpecialization.general->forAll(not oclIsKindOf(Behavior))";
    }
  }
  class Subclassification extends Specialization {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p><code>Subclassification</code> is <code>Specialization</code> in which both the <code>specific</code> and <code>general</code> <code>Types</code> are <code>Classifier</code>. This means all instances of the specific <code>Classifier</code> are also instances of the general <code>Classifier</code>.</p>\n";
    }
    ref owningClassifier: Classifier [0,1] unordered derived transient volatile opposite external "#//@eClassifiers.25/@eStructuralFeatures.0"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Classifier</code> that owns this <code>Subclassification</code> relationship, which must also be its <code>subclassifier</code>.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.141/@eStructuralFeatures.1";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref subclassifier: Classifier [1,1] unordered
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "subclassification";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The more specific <code>Classifier</code> in this <code>Subclassification</code>.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.141/@eStructuralFeatures.2";
      };
    ref superclassifier: Classifier [1,1] unordered
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "superclassification";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The more <code>general</code> Classifier in this <code>Subclassification</code>.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.141/@eStructuralFeatures.0";
      };
  }
  class SubjectMembership extends ParameterMembership {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>SubjectMembership</code> is a <code>ParameterMembership</code> that indicates that its <code>ownedSubjectParameter</code> is the subject of its <code>owningType</code>. The <code>owningType</code> of a <code>SubjectMembership</code> must be a <code>RequirementDefinition</code>, <code>RequirementUsage</code>, <code>CaseDefinition</code>, or <code>CaseUsage</code>.</p>\nowningType.oclIsType(RequirementDefinition) or\nowningType.oclIsType(RequiremenCaseRequirementDefinition) or\nowningType.oclIsType(CaseDefinition) or\nowningType.oclIsType(CaseUsage)\n";
    }
    ref ownedSubjectParameter: Usage [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "owningSubjectMembership";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Usage</code< that is the <code>ownedMemberParameter</code> of this <code>SubjectMembership</code>.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.117/@eStructuralFeatures.0";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class Subsetting extends Specialization {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p><code>Subsetting</code> is <code>Specialization</code> in which the <code>specific</code> and <code>general</code> <code>Types</code> are <code>Features</code>. This means all values of the <code>subsettingFeature</code> (on instances of its domain, i.e., the intersection of its <code>featuringTypes</code>) are values of the <code>subsettedFeature</code> on instances of its domain. To support this the domain of the <code>subsettingFeature</code> must be the same or specialize (at least indirectly) the domain of the <code>subsettedFeature</code> (via <code>Specialization</code>), and the co-domain (intersection of the <code>types</code>) of the <code>subsettingFeature</code> must specialize the co-domain of the <code>subsettedFeature</code>.</p>\n\nsubsettingFeature.canAccess(subsettedFeature)\nsubsettedFeature.isUnique implies subsettingFeature.isUnique\nsubsettedFeature.isConstant and subsettingFeature.isVariable implies \n    subsettingFeature.isConstant\n";
    }
    ref owningFeature: Feature [0,1] unordered derived transient volatile opposite external "#//@eClassifiers.58/@eStructuralFeatures.19"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>A <code>subsettingFeature</code> that is also the <code>owningRelatedElement</code> of this <code>Subsetting</code>.</p>\n\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.141/@eStructuralFeatures.1";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.150/@eStructuralFeatures.2";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref subsettedFeature: Feature [1,1] unordered
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "supersetting";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Feature</code> that is subsetted by the <code>subsettingFeature</code> of this <code>Subsetting</code>.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.141/@eStructuralFeatures.0";
      };
    ref subsettingFeature: Feature [1,1] unordered
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "subsetting";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Feature</code> that is a subset of the <code>subsettedFeature</code> of this <code>Subsetting</code>.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.141/@eStructuralFeatures.2";
      };
  }
  class Succession extends Connector {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>Succession</code> is a binary <code>Connector</code> that requires its <code>relatedFeatures</code> to happen separately in time.</p>\n\nspecializesFromLibrary('Occurrences::happensBeforeLinks')";
    }
  }
  class SuccessionAsUsage extends ConnectorAsUsage, Succession {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>SuccessionAsUsage</code> is both a <code>ConnectorAsUsage</code> and a <code>Succession</code>.<p>";
    }
  }
  class SuccessionFlow extends Flow, Succession {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>SuccessionFlow</code> is a <code>Flow</code> that also provides temporal ordering. It classifies <code><em>Transfers</em></code> that cannot start until the source <code><em>Occurrence</em></code> has completed and that must complete before the target <code><em>Occurrence</em></code> can start.</p>\nspecializesFromLibrary('Transfers::flowTransfersBefore')";
    }
  }
  class SuccessionFlowUsage extends FlowUsage, SuccessionFlow {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>SuccessionFlowUsage</code> is a <code>FlowUsage</code> that is also a KerML <code>SuccessionFlow</code>.</p>\nspecializesFromLibrary('Flows::successionFlows')";
    }
  }
  class TerminateActionUsage extends ActionUsage {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>TerminateActionUsage</code> is an <code>ActionUsage</code> that directly or indirectly specializes the <code>ActionDefinition</code> <em><code>TerminateAction</code></em> from the Systems Model Library, which causes a given <em><code>terminatedOccurrence</code></em> to end during its performance. By default, the <code>terminatedOccurrence</code> is the featuring instance (<em><code>that</code></em>) of the performance of the <code>TerminateActionUsage</code>, generally the performance of its immediately containing <code>ActionDefinition</code> or <code>ActionUsage</code>.</p>\nspecializesFromLibrary('Actions::terminateActions')\nterminatedOccurrenceArgument = argument(1)\nisSubactionUsage() implies\n    specializesFromLibrary('Actions::Action::terminateSubactions')";
    }
    ref terminatedOccurrenceArgument: Expression [0,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "terminateActionUsage";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Expression</code> that is the <code>featureValue</code> of the <em><code>terminateOccurrence</code></em> <code>parameter</code> of this <code>TerminateActionUsage</code>.";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class TextualRepresentation extends AnnotatingElement {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>TextualRepresentation</code> is an <code>AnnotatingElement</code> whose <code>body</code> represents the <code>representedElement</code> in a given <code>language</code>. The <code>representedElement</code> must be the <code>owner</code> of the <code>TextualRepresentation</code>. The named <code>language</code> can be a natural language, in which case the <code>body</code> is an informal representation, or an artificial language, in which case the <code>body</code> is expected to be a formal, machine-parsable representation.</p>\n\n<p>If the named <code>language</code> of a <code>TextualRepresentation</code> is machine-parsable, then the <code>body</code> text should be legal input text as defined for that <code>language</code>. The interpretation of the named language string shall be case insensitive. The following <code>language</code> names are defined to correspond to the given standard languages:</p>\n\n<table border=\"1\" cellpadding=\"1\" cellspacing=\"1\" width=\"498\">\n\t<thead>\n\t</thead>\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"text-align: center; width: 154px;\"><code>kerml</code></td>\n\t\t\t<td style=\"width: 332px;\">Kernel Modeling Language</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td style=\"text-align: center; width: 154px;\"><code>ocl</code></td>\n\t\t\t<td style=\"width: 332px;\">Object Constraint Language</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td style=\"text-align: center; width: 154px;\"><code>alf</code></td>\n\t\t\t<td style=\"width: 332px;\">Action Language for fUML</td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<p>Other specifications may define specific <code>language</code> strings, other than those shown above, to be used to indicate the use of languages from those specifications in KerML <code>TextualRepresentation</code>.</p>\n\n<p>If the <code>language</code> of a <code>TextualRepresentation</code> is &quot;<code>kerml</code>&quot;, then the <code>body</code> text shall be a legal representation of the <code>representedElement</code> in the KerML textual concrete syntax. A conforming tool can use such a <code>TextualRepresentation</code> <code>Annotation</code> to record the original KerML concrete syntax text from which an <code>Element</code> was parsed. In this case, it is a tool responsibility to ensure that the <code>body</code> of the <code>TextualRepresentation</code> remains correct (or the Annotation is removed) if the annotated <code>Element</code> changes other than by re-parsing the <code>body</code> text.</p>\n\n<p>An <code>Element</code> with a <code>TextualRepresentation</code> in a language other than KerML is essentially a semantically &quot;opaque&quot; <code>Element</code> specified in the other language. However, a conforming KerML tool may interpret such an element consistently with the specification of the named language.</p>\n";
    }
    attr body: EString [1,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The textual representation of the <code>representedElement</code> in the given <code>language</code>.</p>\n";
      };
    attr language: EString [1,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The natural or artifical language in which the <code>body</code> text is written.</p>\n";
      };
    ref representedElement: Element [1,1] unordered derived transient volatile opposite external "#//@eClassifiers.49/@eStructuralFeatures.17"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Element</code> that is represented by this <code>TextualRepresentation</code>.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.8/@eStructuralFeatures.0";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.49/@eStructuralFeatures.11";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  enum TransitionFeatureKind {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>TransitionActionKind</code> indicates whether the <code>transitionFeature</code> of a <code>TransitionFeatureMembership</code> is a trigger, guard or effect.</p>";
    }
    trigger = 0
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Indicates that the <code>transitionFeature</code> of a <code>TransitionFeatureMembership</code> is a <code>triggerAction</code>.</p>";
      };
    guard = 1
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Indicates that the <code>transitionFeature</code> of a <code>TransitionFeatureMembership</code> is a <code>guardExpression</code>.</p>";
      };
    effect = 2
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Indicates that the <code>transitionFeature</code> of a <code>TransitionFeatureMembership</code> is an <code>effectAction</code>.</p>";
      };
  }
  class TransitionFeatureMembership extends FeatureMembership {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>TransitionFeatureMembership</code> is a <code>FeatureMembership</code> for a trigger, guard or effect of a <code>TransitionUsage</code>, whose <code>transitionFeature</code> is a <code>AcceptActionUsage</code>, <em><code>Boolean</code></em>-valued <code>Expression</code> or <code>ActionUsage</code>, depending on its <code>kind</code>. </p>\nkind = TransitionFeatureKind::trigger implies\n    transitionFeature.oclIsKindOf(AcceptActionUsage)\nowningType.oclIsKindOf(TransitionUsage)\nkind = TransitionFeatureKind::guard implies\n    transitionFeature.oclIsKindOf(Expression) and\n    let guard : Expression = transitionFeature.oclIsKindOf(Expression) in\n    guard.result.specializesFromLibrary('ScalarValues::Boolean') and\n    guard.result.multiplicity <> null and\n    guard.result.multiplicity.hasBounds(1,1)\nkind = TransitionFeatureKind::effect implies\n    transitionFeature.oclIsKindOf(ActionUsage)";
    }
    attr kind: TransitionFeatureKind [1,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Whether this <code>TransitionFeatureMembership </code> is for a <code>trigger</code>, <code>guard</code> or <code>effect</code>.</p>";
      };
    ref transitionFeature: Step [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "transitionFeatureMembership";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Step</code> that is the <code>ownedMemberFeature</code> of this <code>TransitionFeatureMembership</code>.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.62/@eStructuralFeatures.0";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class TransitionUsage extends ActionUsage {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>TransitionUsage</code> is an <code>ActionUsage</code> representing a triggered transition between <code>ActionUsages</code> or <code>StateUsages</code>. When triggered by a <code>triggerAction</code>, when its <code>guardExpression</code> is true, the <code>TransitionUsage</code> asserts that its <code>source</code> is exited, then its <code>effectAction</code> (if any) is performed, and then its <code>target</code> is entered.</p>\n\n<p>A <code>TransitionUsage</code> can be related to some of its <code>ownedFeatures</code> using <code>TransitionFeatureMembership</code> <code>Relationships</code>, corresponding to the <code>triggerAction</code>, <code>guardExpression</code> and <code>effectAction</code> of the <code>TransitionUsage</code>.</p>\nisComposite and owningType <> null and\n(owningType.oclIsKindOf(ActionDefinition) or\n owningType.oclIsKindOf(ActionUsage)) and\nsource <> null and not source.oclIsKindOf(StateUsage) implies\n    specializesFromLibrary('Actions::Action::decisionTransitions')\nisComposite and owningType <> null and\n(owningType.oclIsKindOf(StateDefinition) or\n owningType.oclIsKindOf(StateUsage)) and\nsource <> null and source.oclIsKindOf(StateUsage) implies\n    specializesFromLibrary('States::StateAction::stateTransitions')\n\nspecializesFromLibrary('Actions::transitionActions')\nsource =\n    let sourceFeature : Feature = sourceFeature() in\n    if sourceFeature = null then null\n    else sourceFeature.featureTarget.oclAsType(ActionUsage)\ntarget =\n    if succession.targetFeature->isEmpty() then null\n    else\n        let targetFeature : Feature =\n            succession.targetFeature->first().featureTarget in\n        if not targetFeature.oclIsKindOf(ActionUsage) then null\n        else targetFeature.oclAsType(ActionUsage)\n        endif\n    endif\n\ntriggerAction = ownedFeatureMembership->\n    selectByKind(TransitionFeatureMembership)->\n    select(kind = TransitionFeatureKind::trigger).transitionFeature->\n    selectByKind(AcceptActionUsage)\nlet successions : Sequence(Successions) = \n    ownedMember->selectByKind(Succession) in\nsuccessions->notEmpty() and\nsuccessions->at(1).targetFeature.featureTarget->\n    forAll(oclIsKindOf(ActionUsage))\nguardExpression = ownedFeatureMembership->\n    selectByKind(TransitionFeatureMembership)->\n    select(kind = TransitionFeatureKind::trigger).transitionFeature->\n    selectByKind(Expression)\ntriggerAction->forAll(specializesFromLibrary('Actions::TransitionAction::accepter') and\nguardExpression->forAll(specializesFromLibrary('Actions::TransitionAction::guard') and\neffectAction->forAll(specializesFromLibrary('Actions::TransitionAction::effect'))\ntriggerAction = ownedFeatureMembership->\n    selectByKind(TransitionFeatureMembership)->\n    select(kind = TransitionFeatureKind::trigger).transitionFeatures->\n    selectByKind(AcceptActionUsage)\nsuccession.sourceFeature = source\nownedMember->selectByKind(BindingConnector)->exists(b |\n    b.relatedFeatures->includes(source) and\n    b.relatedFeatures->includes(inputParameter(1)))\ntriggerAction->notEmpty() implies\n    let payloadParameter : Feature = inputParameter(2) in\n    payloadParameter <> null and\n    payloadParameter.subsetsChain(triggerAction->at(1), triggerPayloadParameter())\nownedMember->selectByKind(BindingConnector)->exists(b |\n    b.relatedFeatures->includes(succession) and\n    b.relatedFeatures->includes(resolveGlobal(\n        'TransitionPerformances::TransitionPerformance::transitionLink')))\nif triggerAction->isEmpty() then\n    inputParameters()->size() >= 1\nelse\n    inputParameters()->size() >= 2\nendif\n    \nsuccession = ownedMember->selectByKind(Succession)->at(1)\nsource <> null and not source.oclIsKindOf(StateUsage) implies\n    triggerAction->isEmpty()";
    }
    op sourceFeature() -> Feature [0,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Return the <code>Feature</code> to be used as the <code>source</code> of the <code>succession</code> of this <code>TransitionUsage</code>, which is the first <code>member</code> of the <code>TransitionUsage</code> that is a <code>Feature</code>, that is owned by the <code>TransitionUsage</code> via a <code>Membership</code> that is <em>not</em> a <code>FeatureMembership</code>, and whose <code>featureTarget</code> is an <code>ActionUsage</code>.</p>\nlet features : Sequence(Feature) = ownedMembership->\n    reject(oclIsKindOf(FeatureMembership)).memberElement->\n    selectByKind(Feature)->\n    select(featureTarget.oclIsKindOf(ActionUsage)) in\nif features->isEmpty() then null\nelse features->first()\nendif";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op triggerPayloadParameter() -> ReferenceUsage [0,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Return the <code>payloadParameter</code> of the <code>triggerAction</code> of this <code>TransitionUsage</code>, if it has one.</p>\nif triggerAction->isEmpty() then null\nelse triggerAction->first().payloadParameter\nendif";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref effectAction: ActionUsage [0,*] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "activeTransition";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>ActionUsages</code> that define the effects of this <code>TransitionUsage</code>, which are the <code>ownedFeatures</code> of the <code>TransitionUsage</code> related to it by <code>TransitionFeatureMemberships</code> with <code>kind = effect</code>, which must all be <code>ActionUsages</code>.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.160/@eStructuralFeatures.3";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref guardExpression: Expression [0,*] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "guardedTransition";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Expressions</code> that define the guards of this <code>TransitionUsage</code>, which are the <code>ownedFeatures</code> of the <code>TransitionUsage</code> related to it by <code>TransitionFeatureMemberships</code> with <code>kind = guard</code>, which must all be <code>Expressions</code>.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.160/@eStructuralFeatures.18";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref source: ActionUsage [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "outgoingTransition";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The source <code>ActionUsage</code> of this <code>TransitionUsage</code>, which becomes the <code>source</code> of the <code>succession</code> for the <code>TransitionUsage</code>.</p>";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref succession: Succession [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "linkedTransition";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Succession</code> that is the <code>ownedFeature</code> of this <code>TransitionUsage</code>, which, if the <code>TransitionUsage</code> is triggered, asserts the temporal ordering of the <code>source</code> and <code>target</code>.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.107/@eStructuralFeatures.4";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref target: ActionUsage [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "incomingTransition";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The target <code>ActionUsage</code> of this <code>TransitionUsage<code>, which is the <code>targetFeature</code> of the <code>succession</code> for the <code>TransitionUsage</code>.</p>";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref triggerAction: AcceptActionUsage [0,*] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "triggeredTransition";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>AcceptActionUsages</code> that define the triggers of this <code>TransitionUsage</code>, which are the <code>ownedFeatures</code> of the <code>TransitionUsage</code> related to it by <code>TransitionFeatureMemberships</code> with <code>kind = trigger</code>, which must all be <code>AcceptActionUsages</code>.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.160/@eStructuralFeatures.18";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class TriggerInvocationExpression extends InvocationExpression {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>TriggerInvocationExpression</code> is an <code>InvocationExpression</code> that invokes one of the trigger <code>Functions</code> from the Kernel Semantic Library <code><em>Triggers<em></code> package, as indicated by its <code>kind</code>.</p>\nkind = TriggerKind::after implies\n    argument->notEmpty() and\n    argument->at(1).result.specializesFromLibrary('Quantities::ScalarQuantityValue') and\n    let mRef : Element = \n        resolveGlobal('Quantities::TensorQuantityValue::mRef').ownedMemberElement in\n    argument->at(1).result.feature->\n        select(ownedRedefinition.redefinedFeature->\n           closure(ownedRedefinition.redefinedFeature)->\n           includes(mRef))->\n        exists(specializesFromLibrary('ISQBase::DurationUnit'))\nkind = TriggerKind::at implies\n    argument->notEmpty() and\n    argument->at(1).result.specializesFromLibrary('Time::TimeInstantValue')\nkind = TriggerKind::when implies\n    argument->notEmpty() and\n    argument->at(1).oclIsKindOf(FeatureReferenceExpression) and\n    let referent : Feature = \n        argument->at(1).oclAsType(FeatureReferenceExpression).referent in\n    referent.oclIsKindOf(Expression) and\n    referent.oclAsType(Expression).result.specializesFromLibrary('ScalarValues::Boolean')";
    }
    attr kind: TriggerKind [1,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Indicates which of the <code>Functions</code> from the <code><em>Triggers</em></code> model in the Kernel Semantic Library is to be invoked by this <code>TriggerInvocationExpression</code>.</p>";
      };
  }
  enum TriggerKind {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p><code>TriggerKind</code> enumerates the kinds of triggers that can be represented by a <code>TriggerInvocationExpression</code>.</p>";
    }
    when = 0
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Indicates a <em>change trigger</em>, corresponding to the <em><code>TriggerWhen</code></em> <code>Function</code> from the <em><code>Triggers</code></em> model in the Kernel Semantic Library.</p>";
      };
    at = 1
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Indicates an <em>absolute time trigger</em>, corresponding to the <em><code>TriggerAt</code></em> <code>Function</code> from the <em><code>Triggers</code></em> model in the Kernel Semantic Library.</p>";
      };
    after = 2
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Indicates a <em>relative time trigger</em>, corresponding to the <em><code>TriggerAfter</code></em> <code>Function</code> from the <em><code>Triggers</code></em> model in the <code>Kernel Semantic Library.</p>";
      };
  }
  class Type extends Namespace {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>Type</code> is a <code>Namespace</code> that is the most general kind of <code>Element</code> supporting the semantics of classification. A <code>Type</code> may be a <code>Classifier</code> or a <code>Feature</code>, defining conditions on what is classified by the <code>Type</code> (see also the description of <code>isSufficient</code>).</p>\n\nownedSpecialization = ownedRelationship->selectByKind(Specialization)->\n    select(s | s.special = self)\n    \nmultiplicity = \n    let ownedMultiplicities: Sequence(Multiplicity) =\n        ownedMember->selectByKind(Multiplicity) in\n    if ownedMultiplicities->isEmpty() then null\n    else ownedMultiplicities->first()\n    endif\nownedFeatureMembership = ownedRelationship->selectByKind(FeatureMembership)\nownedConjugator =\n    let ownedConjugators: Sequence(Conjugator) = \n        ownedRelationship->selectByKind(Conjugation) in\n    if ownedConjugators->isEmpty() then null \n    else ownedConjugators->at(1) endif\noutput = feature->select(f | \n    let direction: FeatureDirectionKind = directionOf(f) in\n    direction = FeatureDirectionKind::out or\n    direction = FeatureDirectionKind::inout)\ninput = feature->select(f | \n    let direction: FeatureDirectionKind = directionOf(f) in\n    direction = FeatureDirectionKind::_'in' or\n    direction = FeatureDirectionKind::inout)\ninheritedMembership = inheritedMemberships(Set{}, Set{}, false)\nspecializesFromLibrary('Base::Anything')\ndirectedFeature = feature->select(f | directionOf(f) <> null)\nfeature = featureMembership.ownedMemberFeature\nfeatureMembership = ownedFeatureMembership->\n    union(inheritedMembership->\n        selectByKind(FeatureMembership)->\n        select(mem | self.specializes(mem.owningType)))\nownedFeature = ownedFeatureMembership.ownedMemberFeature\ndifferencingType = ownedDifferencing.differencingType\nintersectingType->excludes(self)\ndifferencingType->excludes(self)\nunioningType = ownedUnioning.unioningType\nunioningType->excludes(self)\nintersectingType = ownedIntersecting.intersectingType\nownedRelationship->selectByKind(Conjugation)->size() <= 1\nownedMember->selectByKind(Multiplicity)->size() <= 1\nendFeature = feature->select(isEnd)\nownedDisjoining =\n    ownedRelationship->selectByKind(Disjoining)\nownedUnioning =\n    ownedRelationship->selectByKind(Unioning)\nownedRelationship->selectByKind(Intersecting)\nownedDifferencing =\n    ownedRelationship->selectByKind(Differencing)\nownedEndFeature = ownedFeature->select(isEnd)\ninheritedFeature = inheritedMemberships->\n    selectByKind(FeatureMembership).memberFeature\nownedUnioning->size() <> 1\nownedIntersecting->size() <> 1\nownedDifferencing->size() <> 1";
    }
    op allRedefinedFeaturesOf(membership: Membership [1,1] unordered) -> Feature [0,*] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>If the <code>memberElement</code> of the given <code>membership</code> is a <code>Feature</code>, then return all <code>Features</code> directly or indirectly redefined by the <code>memberElement</code>.</p>\nif not membership.memberElement.oclIsType(Feature) then Set{} \nelse membership.memberElement.oclAsType(Feature).allRedefinedFeatures()\nendif";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op allSupertypes() -> Type [0,*] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Return this <code>Type</code> and all <code>Types</code> that are directly or transitively supertypes of this <code>Type</code> (as determined by the <code>supertypes</code> operation with <code>excludeImplied = false</code>).</p>\n\nOrderedSet{self}->closure(supertypes(false))";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op directionOf(feature: Feature [1,1] unordered) -> FeatureDirectionKind [0,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>If the given <code>feature</code> is a <code>feature</code> of this <code>Type</code>, then return its direction relative to this <code>Type</code>, taking conjugation into account.</p>\n\ndirectionOfExcluding(f, Set{})";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op directionOfExcluding(
      feature: Feature [1,1] unordered,
      excluded: Type [0,*] unordered
    ) -> FeatureDirectionKind [0,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Return the direction of the given <code>feature</code> relative to this <code>Type</code>, excluding a given set of <code>Types</code> from the search of supertypes of this <code>Type</code>.</p>\nlet excludedSelf : Set(Type) = excluded->including(self) in \nif feature.owningType = self then feature.direction\nelse\n    let directions : Sequence(FeatureDirectionKind) =\n        supertypes(false)->excluding(excludedSelf).\n        directionOfExcluding(feature, excludedSelf)->\n        select(d | d <> null) in\n    if directions->isEmpty() then null\n else\n    let direction : FeatureDirectionKind = directions->first() in\n    if not isConjugated then direction\n    else if direction = FeatureDirectionKind::_'in' then FeatureDirectionKind::out\n    else if direction = FeatureDirectionKind::out then FeatureDirectionKind::_'in'\n    else direction\n    endif endif endif   endif\nendif";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op inheritableMemberships(
      excludedNamespaces: Namespace [0,*] unordered,
      excludedTypes: Type [0,*] unordered,
      excludeImplied: EBoolean [1,1] unordered
    ) -> Membership [0,*]
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Return all the non-<code>private</code> <code>Memberships</code> of all the supertypes of this <code>Type</code>, excluding any supertypes that are this <code>Type</code> or are in the given set of <code>excludedTypes</code>. If <code>excludeImplied = true</code>, then also transitively exclude any supertypes from implied <code>Specializations</code>.</p>\nlet excludingSelf : Set(Type) = excludedType->including(self) in\nsupertypes(excludeImplied)->reject(t | excludingSelf->includes(t)).\n    nonPrivateMemberships(excludedNamespaces, excludingSelf, excludeImplied)\n";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op inheritedMemberships(
      excludedNamespaces: Namespace [0,*] unordered,
      excludedTypes: Type [0,*] unordered,
      excludeImplied: EBoolean [1,1] unordered
    ) -> Membership [0,*]
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Return the <code>Memberships</code> inheritable from supertypes of this <code>Type</code> with redefined <code>Features</code> removed. When computing inheritable <code>Memberships</code>, exclude <code>Imports</code> of <code>excludedNamespaces</code>, <code>Specializations</code> of <code>excludedTypes</code>, and, if <code>excludeImplied = true</code>, all implied <code>Specializations</code>.</p>\n\nremoveRedefinedFeatures(\n    inheritableMemberships(excludedNamespaces, excludedTypes, excludeImplied))";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op isCompatibleWith(otherType: Type [1,1] unordered) -> EBoolean [1,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>By default, this <code>Type</code> is compatible with an <code>otherType</code> if it directly or indirectly specializes the <code>otherType</code>.</p>\nspecializes(otherType)";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op multiplicities() -> Multiplicity [0,*]
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Return the owned or inherited <code>Multiplicities</code> for this <code>Type<./code>.</p>\nif multiplicity <> null then OrderedSet{multiplicity}\nelse \n    ownedSpecialization.general->closure(t |\n        if t.multiplicity <> null then OrderedSet{}\n        else ownedSpecialization.general\n    )->select(multiplicity <> null).multiplicity->asOrderedSet()\nendif";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op nonPrivateMemberships(
      excludedNamespaces: Namespace [0,*] unordered,
      excludedTypes: Type [0,*] unordered,
      excludeImplied: EBoolean [1,1] unordered
    ) -> Membership [0,*]
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Return the <code>public</code>, <code>protected</code> and inherited <code>Memberships</code> of this <code>Type</code>. When computing imported <code>Memberships</code>, exclude the given set of <code>excludedNamespaces</code>. When computing inherited <code>Memberships</code>, exclude <code>Types</code> in the given set of <code>excludedTypes</code>. If <code>excludeImplied = true</code>, then also exclude any supertypes from implied <code>Specializations</code>.</p>\nlet publicMemberships : OrderedSet(Membership) = \n    membershipsOfVisibility(VisibilityKind::public, excludedNamespaces) in\nlet protectedMemberships : OrderedSet(Membership) = \n    membershipsOfVisibility(VisibilityKind::protected, excludedNamespaces) in\nlet inheritedMemberships : OrderedSet(Membership) =\n    inheritedMemberships(excludedNamespaces, excludedTypes, excludeImplied) in\npublicMemberships->\n    union(protectedMemberships)->\n    union(inheritedMemberships)";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op removeRedefinedFeatures(memberships: Membership [0,*]) -> Membership [0,*]
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Return a subset of <code>memberships</code>, removing those <code>Memberships</code> whose <code>memberElements</code> are <code>Features</code> and for which either of the following two conditions holds:</p>\n\n<ol>\n\t<li>The <code>memberElement</code> of the <code>Membership</code> is included in redefined <code>Features</code> of another <code>Membership</code> in <code>memberships</code>.</li>\n\t<li>One of the redefined <code>Features</code> of the <code>Membership</code> is a directly <code>redefinedFeature</code> of an <code>ownedFeature</code> of this <code>Type</code>.</li>\n</ol>\n\n<p>For this purpose, the redefined <code>Features</code> of a <code>Membership</code> whose <code>memberElement</code> is a <code>Feature</code> includes the <code>memberElement</code> and all <code>Features</code> directly or indirectly redefined by the <code>memberElement</code>.</p>\nlet reducedMemberships : Sequence(Membership) =\n    memberships->reject(mem1 |\n        memberships->excluding(mem1)->\n            exists(mem2 | allRedefinedFeaturesOf(mem2)->\n                includes(mem1.memberElement))) in\nlet redefinedFeatures : Set(Feature) = \n    ownedFeature.redefinition.redefinedFeature->asSet() in\nreducedMemberships->reject(mem | allRedefinedFeaturesOf(mem)->\n    exists(feature | redefinedFeatures->includes(feature)))";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op specializes(supertype: Type [1,1] unordered) -> EBoolean [1,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Check whether this <code>Type</code> is a direct or indirect specialization of the given <code>supertype<code>.</p>\nif isConjugated then \n    ownedConjugator.originalType.specializes(supertype)\nelse\n    allSupertypes()->includes(supertype)\nendif";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op specializesFromLibrary(libraryTypeName: EString [1,1] unordered) -> EBoolean [1,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Check whether this <code>Type</code> is a direct or indirect specialization of the named library <code>Type</code>. <code>libraryTypeName</code> must conform to the syntax of a KerML qualified name and must resolve to a <code>Type</code> in global scope.</p>\n\nlet mem : Membership = resolveGlobal(libraryTypeName) in\nmem <> null and mem.memberElement.oclIsKindOf(Type) and\nspecializes(mem.memberElement.oclAsType(Type))";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op supertypes(excludeImplied: EBoolean [1,1] unordered) -> Type [0,*]
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>If this <code>Type</code> is conjugated, then return just the <code>originalType</code> of the <code>Conjugation</code>. Otherwise, return the <code>general</code> <code>Types</code> from all <code>ownedSpecializations</code> of this type, if <code>excludeImplied = false</code>, or all non-implied <code>ownedSpecializations</code>, if <code>excludeImplied = true</code>.</p>\nif isConjugated then Sequence{conjugator.originalType}\nelse if not excludeImplied then ownedSpecialization.general\nelse ownedSpecialization->reject(isImplied).general\nendif\nendif";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref differencingType: Type [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "differencedType";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The interpretations of a <code>Type</code> with <code>differencingTypes</code> are asserted to be those of the first of those <code>Types</code>, but not including those of the remaining <code>Types</code>. For example, a <code>Classifier</code> might be the difference of a <code>Classifier</code> for people and another for people of a particular nationality, leaving people who are not of that nationality. Similarly, a feature of people might be the difference between a feature for their children and a <code>Classifier</code> for people of a particular sex, identifying their children not of that sex (because the interpretations of the children <code>Feature</code> that identify those of that sex are also interpretations of the <code>Classifier</code> for that sex).</p>\n";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref directedFeature: Feature [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "typeWithDirectedFeature";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>features</code> of this <code>Type</code> that have a non-null <code>direction</code>.</p>\n";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.160/@eStructuralFeatures.3";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref endFeature: Feature [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "typeWithEndFeature";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>All <code>features</code> of this <code>Type</code> with <code>isEnd = true</code>.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.160/@eStructuralFeatures.3";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref feature: Feature [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "typeWithFeature";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>ownedMemberFeatures</code> of the <code>featureMemberships</code> of this <code>Type</code>.</p>\n";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.107/@eStructuralFeatures.1";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref featureMembership: FeatureMembership [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "type";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>FeatureMemberships</code> for <code>features</code> of this <code>Type</code>, which include all <code>ownedFeatureMemberships</code> and those <code>inheritedMemberships</code> that are <code>FeatureMemberships</code> (but does <em>not</em> include any <code>importedMemberships</code>).</p>\n";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref inheritedFeature: Feature [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "inheritingType";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>All the <code>memberFeatures</code> of the <code>inheritedMemberships</code> of this <code>Type</code> that are <code>FeatureMemberships</code>.</p>\n";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.160/@eStructuralFeatures.3";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref inheritedMembership: Membership [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "inheritingType";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>All <code>Memberships</code> inherited by this <code>Type</code> via <code>Specialization</code> or <code>Conjugation</code>. These are included in the derived union for the <code>memberships</code> of the <code>Type</code>.</p>\n";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.107/@eStructuralFeatures.2";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref input: Feature [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "typeWithInput";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>All <code>features</code> related to this <code>Type</code> by <code>FeatureMemberships</code> that have <code>direction</code> <code>in</code> or <code>inout</code>.</p>\n";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.160/@eStructuralFeatures.1";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref intersectingType: Type [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "intersectedType";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The interpretations of a <code>Type</code> with <code>intersectingTypes</code> are asserted to be those in common among the <code>intersectingTypes</code>, which are the <code>Types</code> derived from the <code>intersectingType</code> of the <code>ownedIntersectings</code> of this <code>Type</code>. For example, a <code>Classifier</code> might be an intersection of <code>Classifiers</code> for people of a particular sex and of a particular nationality. Similarly, a feature for people&#39;s children of a particular sex might be the intersection of a <code>Feature</code> for their children and a <code>Classifier</code> for people of that sex (because the interpretations of the children <code>Feature</code> that identify those of that sex are also interpretations of the Classifier for that sex).</p>\n";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    attr isAbstract: EBoolean [1,1] unordered default "false"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Indicates whether instances of this <code>Type</code> must also be instances of at least one of its specialized <code>Types</code>.</p>\n";
      };
    attr isConjugated: EBoolean [1,1] unordered derived transient volatile
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Indicates whether this <code>Type</code> has an <code>ownedConjugator</code>.</p>\n";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    attr isSufficient: EBoolean [1,1] unordered default "false"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Whether all things that meet the classification conditions of this <code>Type</code> must be classified by the <code>Type</code>.</p>\n\n<p>(A <code>Type</code>&nbsp;gives conditions that must be met by whatever it classifies, but when <code>isSufficient</code> is false, things may meet those conditions but still not be classified by the <code>Type</code>. For example, a Type <code><em>Car</em></code> that is not sufficient could require everything it classifies to have four wheels, but not all four wheeled things would classify as cars. However, if the <code>Type</code> <code><em>Car</em></code> were sufficient, it would classify all four-wheeled things.)</p>\n";
      };
    ref multiplicity: Multiplicity [0,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "typeWithMultiplicity";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>An <code>ownedMember</code> of this <code>Type</code> that is a <code>Multiplicity</code>, which constraints the cardinality of the <code>Type</code>. If there is no such <code>ownedMember</code>, then the cardinality of this <code>Type</code> is constrained by all the <code>Multiplicity</code> constraints applicable to any direct supertypes.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.107/@eStructuralFeatures.4";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref output: Feature [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "typeWithOutput";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>All <code>features</code> related to this <code>Type</code> by <code>FeatureMemberships</code> that have <code>direction</code> <code>out</code> or <code>inout</code>.</p>\n";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.160/@eStructuralFeatures.1";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref ownedConjugator: Conjugation [0,1] unordered derived transient volatile opposite external "#//@eClassifiers.32/@eStructuralFeatures.2"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>A <code>Conjugation</code> owned by this <code>Type</code> for which the <code>Type</code> is the <code>originalType</code>.</p>\n";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.49/@eStructuralFeatures.10";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref ownedDifferencing: Differencing [0,*] derived transient volatile opposite external "#//@eClassifiers.46/@eStructuralFeatures.1"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>ownedRelationships</code> of this <code>Type</code> that are <code>Differencings</code>, having this <code>Type</code> as their <code>typeDifferenced</code>.</p>\n";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.49/@eStructuralFeatures.10";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref ownedDisjoining: Disjoining [0,*] unordered derived transient volatile opposite external "#//@eClassifiers.47/@eStructuralFeatures.1"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>ownedRelationships</code> of this <code>Type</code> that are <code>Disjoinings</code>, for which the <code>Type</code> is the <code>typeDisjoined</code> <code>Type</code>.</p>\n";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.49/@eStructuralFeatures.10";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref ownedEndFeature: Feature [0,*] derived transient volatile opposite external "#//@eClassifiers.58/@eStructuralFeatures.3"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>All <code>endFeatures</code> of this <code>Type</code> that are <code>ownedFeatures</code>.</p>\n";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.160/@eStructuralFeatures.2";
        reference "#//@eClassifiers.160/@eStructuralFeatures.18";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref ownedFeature: Feature [0,*] derived transient volatile opposite external "#//@eClassifiers.58/@eStructuralFeatures.23"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>ownedMemberFeatures</code> of the <code>ownedFeatureMemberships</code> of this <code>Type</code>.</p>\n";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.107/@eStructuralFeatures.4";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref ownedFeatureMembership: FeatureMembership [0,*] derived transient volatile opposite external "#//@eClassifiers.62/@eStructuralFeatures.1"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>ownedMemberships</code> of this <code>Type</code> that are <code>FeatureMemberships</code>, for which the <code>Type</code> is the <code>owningType</code>. Each such <code>FeatureMembership</code> identifies an <code>ownedFeature</code> of the <code>Type</code>.</p>\n";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.107/@eStructuralFeatures.5";
        reference "#//@eClassifiers.160/@eStructuralFeatures.4";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref ownedIntersecting: Intersecting [0,*] derived transient volatile opposite external "#//@eClassifiers.82/@eStructuralFeatures.1"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>ownedRelationships</code> of this <code>Type</code> that are <code>Intersectings</code>, have the <code>Type</code> as their <code>typeIntersected</code>.</p>\n";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.49/@eStructuralFeatures.10";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref ownedSpecialization: Specialization [0,*] derived transient volatile opposite external "#//@eClassifiers.141/@eStructuralFeatures.1"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>ownedRelationships</code> of this <code>Type</code> that are <code>Specializations</code>, for which the <code>Type</code> is the <code>specific</code> <code>Type</code>.</p>\n";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.49/@eStructuralFeatures.10";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref ownedUnioning: Unioning [0,*] derived transient volatile opposite external "#//@eClassifiers.162/@eStructuralFeatures.0"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>ownedRelationships</code> of this <code>Type</code> that are <code>Unionings</code>, having the <code>Type</code> as their <code>typeUnioned</code>.</p>\n";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.49/@eStructuralFeatures.10";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref unioningType: Type [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "unionedType";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The interpretations of a <code>Type</code> with <code>unioningTypes</code> are asserted to be the same as those of all the <code>unioningTypes</code> together, which are the <code>Types</code> derived from the <code>unioningType</code> of the <code>ownedUnionings</code> of this <code>Type</code>. For example, a <code>Classifier</code> for people might be the union of <code>Classifiers</code> for all the sexes. Similarly, a feature for people&#39;s children might be the union of features dividing them in the same ways as people in general.</p>\n";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class TypeFeaturing extends Relationship {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>TypeFeaturing</code> is a <code>Featuring</code> <code>Relationship</code> in which the <code>featureOfType</code> is the <code>source</code> and the <code>featuringType</code> is the <code>target</code>.</p>";
    }
    ref featureOfType: Feature [1,1] unordered
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "typeFeaturing";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Feature</code> that is featured by the <code>featuringType</code>. It is the <code>source</code> of the <code>TypeFeaturing</code>.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.129/@eStructuralFeatures.4";
      };
    ref featuringType: Type [1,1] unordered
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "typeFeaturingOfType";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Type</code> that features the <code>featureOfType</code>. It is the <code>target</code> of the <code>TypeFeaturing</code>.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.129/@eStructuralFeatures.5";
      };
    ref owningFeatureOfType: Feature [0,1] unordered derived transient volatile opposite external "#//@eClassifiers.58/@eStructuralFeatures.20"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>A <code>featureOfType</code> that is also the <code>owningRelatedElement</code> of this <code>TypeFeaturing</code>.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.129/@eStructuralFeatures.2";
        reference "#//@eClassifiers.161/@eStructuralFeatures.0";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class Unioning extends Relationship {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p><code>Unioning</code> is a <code>Relationship</code> that makes its <code>unioningType</code> one of the <code>unioningTypes</code> of its <code>typeUnioned</code>.</p>\n";
    }
    ref typeUnioned: Type [1,1] unordered derived transient volatile opposite external "#//@eClassifiers.160/@eStructuralFeatures.22"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p><code>Type</code> with interpretations partly determined by <code>unioningType</code>, as described in <code>Type::unioningType</code>.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.129/@eStructuralFeatures.4";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.129/@eStructuralFeatures.2";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref unioningType: Type [1,1] unordered
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "unionedUnioning";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p><code>Type</code> that partly determines interpretations of <code>typeUnioned</code>, as described in <code>Type::unioningType</code>.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.129/@eStructuralFeatures.5";
      };
  }
  class Usage extends Feature {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>Usage</code> is a usage of a <code>Definition</code>.</p>\n\n<p>A <code>Usage</code> may have <code>nestedUsages</code> that model <code>features</code> that apply in the context of the <code>owningUsage</code>. A <code>Usage</code> may also have <code>Definitions</code> nested in it, but this has no semantic significance, other than the nested scoping resulting from the <code>Usage</code> being considered as a <code>Namespace</code> for any nested <code>Definitions</code>.</p>\n\n<p>However, if a <code>Usage</code> has <code>isVariation = true</code>, then it represents a <em>variation point</em> <code>Usage</code>. In this case, all of its <code>members</code> must be <code>variant</code> <code>Usages</code>, related to the <code>Usage</code> by <code>VariantMembership</code> <code>Relationships</code>. Rather than being <code>features</code> of the <code>Usage</code>, <code>variant</code> <code>Usages</code> model different concrete alternatives that can be chosen to fill in for the variation point <code>Usage</code>.</p>\nvariant = variantMembership.ownedVariantUsage\nvariantMembership = ownedMembership->selectByKind(VariantMembership)\nisVariation implies ownedFeatureMembership->isEmpty()\nisReference = not isComposite\nowningVariationUsage <> null implies\n    specializes(owningVariationUsage)\nisVariation implies\n    not ownedSpecialization.specific->exists(\n        oclIsKindOf(Definition) and\n        oclAsType(Definition).isVariation or\n        oclIsKindOf(Usage) and\n        oclAsType(Usage).isVariation)\nowningVariationDefinition <> null implies\n    specializes(owningVariationDefinition)\ndirectedUsage = directedFeature->selectByKind(Usage)\nnestedAction = nestedUsage->selectByKind(ActionUsage)\nnestedAllocation = nestedUsage->selectByKind(AllocationUsage)\nnestedAnalysisCase = nestedUsage->selectByKind(AnalysisCaseUsage)\nnestedAttribute = nestedUsage->selectByKind(AttributeUsage)\nnestedCalculation = nestedUsage->selectByKind(CalculationUsage)\nnestedCase = nestedUsage->selectByKind(CaseUsage)\nnestedConcern = nestedUsage->selectByKind(ConcernUsage)\nnestedConnection = nestedUsage->selectByKind(ConnectorAsUsage)\nnestedConstraint = nestedUsage->selectByKind(ConstraintUsage)\nownedNested = nestedUsage->selectByKind(EnumerationUsage)\nnestedFlow = nestedUsage->selectByKind(FlowUsage)\nnestedInterface = nestedUsage->selectByKind(ReferenceUsage)\nnestedItem = nestedUsage->selectByKind(ItemUsage)\nnestedMetadata = ownedMember->selectByKind(MetadataUsage)\nnestedOccurrence = nestedUsage->selectByKind(OccurrenceUsage)\nnestedPart = nestedUsage->selectByKind(PartUsage)\nnestedPort = nestedUsage->selectByKind(PortUsage)\nnestedReference = nestedUsage->selectByKind(ReferenceUsage)\nnestedRendering = nestedUsage->selectByKind(RenderingUsage)\nnestedRequirement = nestedUsage->selectByKind(RequirementUsage)\nnestedState = nestedUsage->selectByKind(StateUsage)\nnestedTransition = nestedUsage->selectByKind(TransitionUsage)\nnestedUsage = ownedFeature->selectByKind(Usage)\nnestedUseCase = nestedUsage->selectByKind(UseCaseUsage)\nnestedVerificationCase = nestedUsage->selectByKind(VerificationCaseUsage)\nnestedView = nestedUsage->selectByKind(ViewUsage)\nnestedViewpoint = nestedUsage->selectByKind(ViewpointUsage)\nusage = feature->selectByKind(Usage)\ndirection <> null or isEnd or featuringType->isEmpty() implies\n    isReference\nisVariation implies isAbstract\nmayTimeVary =\n    owningType <> null and\n    owningType.specializesFromLibrary('Occurrences::Occurrence') and\n    not (\n        isPortion or\n        specializesFromLibrary('Links::SelfLink') or\n        specializesFromLibrary('Occurrences::HappensLink') or\n        isComposite and specializesFromLibrary('Actions::Action')\n    )\nowningVariationUsage <> null implies\n    featuringType->asSet() = owningVariationUsage.featuringType->asSet()";
    }
    op referencedFeatureTarget() -> Feature [1,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>If <code>ownedReferenceSubsetting</code> is not null, return the <code>featureTarget</code> of the <code>referencedFeature</code> of the <code>ownedReferenceSubsetting</code>.</p>\nif ownedReferenceSubsetting = null then null\nelse ownedReferenceSubsetting.referencedFeature.featureTarget\nendif";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref definition: Classifier [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "definedUsage";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Classifiers</code> that are the types of this <code>Usage</code>. Nominally, these are <code>Definitions</code>, but other kinds of Kernel <code>Classifiers</code> are also allowed, to permit use of <code>Classifiers</code> from the Kernel Model Libraries.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.58/@eStructuralFeatures.24";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref directedUsage: Usage [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "usageWithDirectedUsage";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>usages</code> of this <code>Usage</code> that are <code>directedFeatures</code>.</p>\n";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.160/@eStructuralFeatures.1";
        reference "#//@eClassifiers.163/@eStructuralFeatures.34";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    attr isReference: EBoolean [1,1] unordered derived transient volatile
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Whether this <code>Usage</code> is a referential <code>Usage</code>, that is, it has <code>isComposite = false</code>.<p>";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    attr isVariation: EBoolean [1,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Whether this <code>Usage</code> is for a variation point or not. If true, then all the <code>memberships</code> of the <code>Usage</code> must be <code>VariantMemberships</code>.</p>";
      };
    attr mayTimeVary: EBoolean [1,1] unordered derived transient volatile
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Whether this <code>Usage</code> may be time varying (that is, whether it is featured by the snapshots of its <code>owningType</code>, rather than being featured by the <code>owningType</code> itself). However, if <code>isConstant</code> is also true, then the value of the <code>Usage</code> is nevertheless constant over the entire duration of an instance of its <code>owningType</code> (that is, it has the same value on all snapshots).</p>\n\n<p>The property <code>mayTimeVary</code> redefines the KerML property <code>Feature::isVariable</code>, making it derived. The property <code>isConstant</code> is inherited from <code>Feature</code>.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.58/@eStructuralFeatures.13";
      }
      annotation "http://www.omg.org/spec/SysML" { };
