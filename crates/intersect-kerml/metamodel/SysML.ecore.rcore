        detail "documentation" = "<p>The <code>usages</code> of this <code>Definition</code> that are <code>directedFeatures</code>.</p>\n";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.160/@eStructuralFeatures.1";
        reference "#//@eClassifiers.44/@eStructuralFeatures.29";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    attr isVariation: EBoolean [1,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Whether this <code>Definition</code> is for a variation point or not. If true, then all the <code>memberships</code> of the <code>Definition</code> must be <code>VariantMemberships</code>.</p>";
      };
