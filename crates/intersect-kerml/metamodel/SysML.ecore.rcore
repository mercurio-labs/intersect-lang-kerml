rcore 1;
package sysml version "1";
metamodel "https://www.omg.org/spec/SysML/20250201" prefix sysml {
  annotation "http://www.eclipse.org/emf/2002/Ecore" {
    detail "settingDelegates" = "http://www.omg.org/spec/SysML";
    detail "invocationDelegates" = "http://www.omg.org/spec/SysML";
  }
  class AcceptActionUsage extends ActionUsage {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>An <code>AcceptActionUsage</code> is an <code>ActionUsage</code> that specifies the acceptance of an <em><code>incomingTransfer</code></em> from the <code><em>Occurrence</em></code> given by the result of its <code>receiverArgument</code> Expression. (If no <code>receiverArgument</code> is provided, the default is the <em><code>this</code></em> context of the AcceptActionUsage.) The payload of the accepted <em><code>Transfer</em></code> is output on its <code>payloadParameter</code>. Which <em><code>Transfers</em></code> may be accepted is determined by conformance to the typing and (potentially) binding of the <code>payloadParameter</code>.</p>\n\ninputParameters()->notEmpty()\nreceiverArgument = argument(2)\npayloadArgument = argument(1)\npayloadParameter = \n if parameter->isEmpty() then null\n else parameter->first() endif\nnot isTriggerAction() implies\n    specializesFromLibrary('Actions::acceptActions')\nisSubactionUsage() and not isTriggerAction() implies\n    specializesFromLibrary('Actions::Action::acceptSubactions')\nisTriggerAction() implies\n    specializesFromLibrary('Actions::TransitionAction::accepter')\npayloadArgument <> null and\npayloadArgument.oclIsKindOf(TriggerInvocationExpression) implies\n    let invocation : Expression =\n        payloadArgument.oclAsType(Expression) in\n    parameter->size() >= 2 and\n    invocation.parameter->size() >= 2 and        \n    ownedFeature->selectByKind(BindingConnector)->exists(b |\n        b.relatedFeatures->includes(parameter->at(2)) and\n        b.relatedFeatures->includes(invocation.parameter->at(2)))";
    }
    op isTriggerAction() -> EBoolean [1,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Check if this <code>AcceptActionUsage</code> is the <code>triggerAction</code> of a <code>TransitionUsage</code>.</p>\nowningType <> null and \nowningType.oclIsKindOf(TransitionUsage) and\nowningType.oclAsType(TransitionUsage).triggerAction->includes(self)";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref payloadArgument: Expression [0,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "acceptingActionUsage";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>An <code>Expression</code> whose <code>result</code> is bound to the <code><em>payload</em></code> <code>parameter</code> of this <code>AcceptActionUsage</code>. If provided, the <code>AcceptActionUsage</code> will only accept a <code><em>Transfer</em></code> with exactly this <code><em>payload</em></code>.</p> \n";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref payloadParameter: ReferenceUsage [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "owningAcceptActionUsage";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>nestedReference</code> of this <code>AcceptActionUsage</code> that redefines the <code>payload</code> output <code>parameter</code> of the base <code>AcceptActionUsage</code> <em><code>AcceptAction</code></em> from the Systems Model Library.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.163/@eStructuralFeatures.22";
        reference "#//@eClassifiers.146/@eStructuralFeatures.1";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref receiverArgument: Expression [0,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "acceptActionUsage";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>An <code>Expression</code> whose <code>result</code> is bound to the <em><code>receiver</code></em> input <code>parameter</code> of this <code>AcceptActionUsage</code>.</p> \n";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class ActionDefinition extends OccurrenceDefinition, Behavior {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>An <code>ActionDefinition</code> is a <code>Definition</code> that is also a <code>Behavior</code> that defines an <em><code>Action</code></em> performed by a system or part of a system.</p>\nspecializesFromLibrary('Actions::Action')\naction = usage->selectByKind(ActionUsage)";
    }
    ref action: ActionUsage [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "featuringActionDefinition";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>ActionUsages</code> that are <code>steps</code> in this <code>ActionDefinition</code>, which define the actions that specify the behavior of the <code>ActionDefinition</code>.</p> \n";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.16/@eStructuralFeatures.1";
        reference "#//@eClassifiers.44/@eStructuralFeatures.29";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class ActionUsage extends OccurrenceUsage, Step {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>An <code>ActionUsage</code> is a <code>Usage</code> that is also a <code>Step</code>, and, so, is typed by a <code>Behavior</code>. Nominally, if the type is an <code>ActionDefinition</code>, an <code>ActionUsage</code> is a <code>Usage</code> of that <code>ActionDefinition</code> within a system. However, other kinds of kernel <code>Behaviors</code> are also allowed, to permit use of <code>Behaviors</code> from the Kernel Model Libraries.</p>\n\nisSubactionUsage() implies\n    specializesFromLibrary('Actions::Action::subactions')\nspecializesFromLibrary('Actions::actions')\nisComposite and owningType <> null and\n(owningType.oclIsKindOf(PartDefinition) or\n owningType.oclIsKindOf(PartUsage)) implies\n    specializesFromLibrary('Parts::Part::ownedActions')\nowningFeatureMembership <> null and\nowningFeatureMembership.oclIsKindOf(StateSubactionMembership) implies\n    let kind : StateSubactionKind = \n        owningFeatureMembership.oclAsType(StateSubactionMembership).kind in\n    if kind = StateSubactionKind::entry then\n        redefinesFromLibrary('States::StateAction::entryAction')\n    else if kind = StateSubactionKind::do then\n        redefinesFromLibrary('States::StateAction::doAction')\n    else\n        redefinesFromLibrary('States::StateAction::exitAction')\n    endif endif";
    }
    op argument(i: EInt [1,1] unordered) -> Expression [0,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Return the <code>i</code>-th argument <code>Expression</code> of an <code>ActionUsage</code>, defined as the <code>value</code> <code>Expression</code> of the <code>FeatureValue</code> of the <code>i</code>-th owned input <code>parameter</code> of the <code>ActionUsage</code>. Return null if the <code>ActionUsage</code> has less than <code>i</code> owned input <code>parameters</code> or the <code>i</code>-th owned input <code>parameter</code> has no <code>FeatureValue</code>.</p>\nif inputParameter(i) = null then null\nelse\n    let featureValue : Sequence(FeatureValue) = inputParameter(i).\n        ownedMembership->select(oclIsKindOf(FeatureValue)) in\n    if featureValue->isEmpty() then null\n    else featureValue->at(1).value\n    endif\nendif";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op inputParameter(i: EInt [1,1] unordered) -> Feature [0,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Return the <code>i</code>-th owned input <code>parameter</code> of the <code>ActionUsage</code>. Return null if the <code>ActionUsage</code> has less than <code>i</code> owned input <code>parameters</code>.</p>\nif inputParameters()->size() < i then null\nelse inputParameters()->at(i)\nendif";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op inputParameters() -> Feature [0,*] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Return the owned input <code>parameters</code> of this <code>ActionUsage</code>.</p>\ninput->select(f | f.owner = self)";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    op isSubactionUsage() -> EBoolean [1,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Check if this <code>ActionUsage</code> is composite and has an <code>owningType</code> that is an <code>ActionDefinition</code> or <code>ActionUsage</code> but is <em>not</em> the <code>entryAction</code> or <code>exitAction</em></code> of a <code>StateDefinition</code> or <code>StateUsage</code>. If so, then it represents an <code><em>Action</em></code> that is a <code><em>subaction</em></code> of another <code><em>Action</em></code>.</p>\nisComposite and owningType <> null and\n(owningType.oclIsKindOf(ActionDefinition) or\n owningType.oclIsKindOf(ActionUsage)) and\n(owningFeatureMembership.oclIsKindOf(StateSubactionMembership) implies\n owningFeatureMembership.oclAsType(StateSubactionMembership).kind = \n    StateSubactionKind::do)";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref actionDefinition: Behavior [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "definedAction";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Behaviors</code> that are the <code>types</code> of this <code>ActionUsage</code>. Nominally, these would be <code>ActionDefinitions</code>, but other kinds of Kernel <code>Behaviors</code> are also allowed, to permit use of <code>Behaviors</code> from the Kernel Model Libraries.</p> \n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.146/@eStructuralFeatures.0";
        reference "#//@eClassifiers.113/@eStructuralFeatures.2";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class ActorMembership extends ParameterMembership {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>An <code>ActorMembership</code> is a <code>ParameterMembership</code> that identifies a <code>PartUsage</code> as an <em>actor</em> <code>parameter</code>, which specifies a role played by an external entity in interaction with the <code>owningType</code> of the <code>ActorMembership</code>.</p>\nowningType.oclIsKindOf(RequirementUsage) or\nowningType.oclIsKindOf(RequirementDefinition) or\nowningType.oclIsKindOf(CaseDefinition) or\nowningType.oclIsKindOf(CaseUsage)\n";
    }
    ref ownedActorParameter: PartUsage [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "owningActorMembership";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>PartUsage</code> specifying the actor.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.117/@eStructuralFeatures.0";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class AllocationDefinition extends ConnectionDefinition {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>An <code>AllocationDefinition</code> is a <code>ConnectionDefinition</code> that specifies that some or all of the responsibility to realize the intent of the <code>source</code> is allocated to the <code>target</code> instances. Such allocations define mappings across the various structures and hierarchies of a system model, perhaps as a precursor to more rigorous specifications and implementations. An <code>AllocationDefinition</code> can itself be refined using nested <code>allocations</code> that give a finer-grained decomposition of the containing allocation mapping.</p>\nallocation = usage->selectAsKind(AllocationUsage)\nspecializesFromLibrary('Allocations::Allocation')";
    }
    ref allocation: AllocationUsage [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "featuringAllocationDefinition";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>AllocationUsages</code> that refine the allocation mapping defined by this <code>AllocationDefinition</code>.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.44/@eStructuralFeatures.29";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class AllocationUsage extends ConnectionUsage {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>An <code>AllocationUsage</code> is a usage of an <code>AllocationDefinition</code> asserting the allocation of the <code>source</code> feature to the <code>target</code> feature.</p>\nspecializesFromLibrary('Allocations::allocations')";
    }
    ref allocationDefinition: AllocationDefinition [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "definedAllocation";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>AllocationDefinitions</code> that are the types of this <code>AllocationUsage</code>.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.34/@eStructuralFeatures.0";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class AnalysisCaseDefinition extends CaseDefinition {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>An <code>AnalysisCaseDefinition</code> is a <code>CaseDefinition</code> for the case of carrying out an analysis.</p>\nresultExpression =\n    let results : OrderedSet(ResultExpressionMembership) =\n        featureMembersip->\n            selectByKind(ResultExpressionMembership) in\n    if results->isEmpty() then null\n    else results->first().ownedResultExpression\n    endif\nspecializesFromLibrary('AnalysisCases::AnalysisCase')";
    }
    ref resultExpression: Expression [0,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "analysisCaseDefintion";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>An <code>Expression</code> used to compute the <code>result</code> of the <code>AnalysisCaseDefinition</code>, owned via a <code>ResultExpressionMembership</code>.</p>\n";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.73/@eStructuralFeatures.0";
        reference "#//@eClassifiers.160/@eStructuralFeatures.18";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class AnalysisCaseUsage extends CaseUsage {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>An <code>AnalysisCaseUsage</code> is a <code>Usage</code> of an <code>AnalysisCaseDefinition</code>.</p>\nresultExpression =\n    let results : OrderedSet(ResultExpressionMembership) =\n        featureMembersip->\n            selectByKind(ResultExpressionMembership) in\n    if results->isEmpty() then null\n    else results->first().ownedResultExpression\n    endif\nspecializesFromLibrary('AnalysisCases::analysisCases')\nisComposite and owningType <> null and\n    (owningType.oclIsKindOf(AnalysisCaseDefinition) or\n     owningType.oclIsKindOf(AnalysisCaseUsage)) implies\n    specializesFromLibrary('AnalysisCases::AnalysisCase::subAnalysisCases')";
    }
    ref analysisCaseDefinition: AnalysisCaseDefinition [0,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "definedAnalysisCase";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>AnalysisCaseDefinition</code> that is the <code>definition</code> of this <code>AnalysisCaseUsage</code>.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.23/@eStructuralFeatures.1";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref resultExpression: Expression [0,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "analysisCase";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>An <code>Expression</code> used to compute the <code>result</code> of the <code>AnalysisCaseUsage</code>, owned via a <code>ResultExpressionMembership</code>.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.160/@eStructuralFeatures.18";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class AnnotatingElement extends Element {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>An <code>AnnotatingElement</code> is an <code>Element</code> that provides additional description of or metadata on some other <code>Element</code>. An <code>AnnotatingElement</code> is either attached to its <code>annotatedElements</code> by <code>Annotation</code> <code>Relationships</code>, or it implicitly annotates its <code>owningNamespace</code>.</p>\n\nannotatedElement = \n if annotation->notEmpty() then annotation.annotatedElement\n else Sequence{owningNamespace} endif\nownedAnnotatingRelationship = ownedRelationship->\n    selectByKind(Annotation)->\n    select(a | a.annotatedElement <> self)\nannotation = \n    if owningAnnotatingRelationship = null then ownedAnnotatingRelationship\n    else owningAnnotatingRelationship->prepend(owningAnnotatingRelationship)\n    endif";
    }
    ref annotatedElement: Element [1,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "annotatingElement";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Elements</code> that are annotated by this <code>AnnotatingElement</code>. If <code>annotation</code> is not empty, these are the <code>annotatedElements</code> of the <code>annotations</code>. If <code>annotation</code> is empty, then it is the <code>owningNamespace</code> of the <code>AnnotatingElement</code>.</p>\n";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref `annotation`: Annotation [0,*] derived transient volatile opposite external "#//@eClassifiers.9/@eStructuralFeatures.1"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Annotations</code> that relate this <code>AnnotatingElement</code> to its <code>annotatedElements</code>. This includes the <code>owningAnnotatingRelationship</code> (if any) followed by all the <code>ownedAnnotatingRelationshps</code>.</p>\n";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref ownedAnnotatingRelationship: Annotation [0,*] derived transient volatile opposite external "#//@eClassifiers.9/@eStructuralFeatures.4"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>ownedRelationships</code> of this <code>AnnotatingElement</code> that are <code>Annotations</code>, for which this <code>AnnotatingElement</code> is the <code>annotatingElement</code>.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.8/@eStructuralFeatures.1";
        reference "#//@eClassifiers.49/@eStructuralFeatures.10";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref owningAnnotatingRelationship: Annotation [0,1] unordered derived transient volatile opposite external "#//@eClassifiers.9/@eStructuralFeatures.2"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>owningRelationship</code> of this <code>AnnotatingRelationship</code>, if it is an <code>Annotation</code></p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.49/@eStructuralFeatures.14";
        reference "#//@eClassifiers.8/@eStructuralFeatures.1";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class Annotation extends Relationship {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>An <code>Annotation</code> is a Relationship between an <code>AnnotatingElement</code> and the <code>Element</code> that is annotated by that <code>AnnotatingElement</code>.</p>\n\n(owningAnnotatedElement <> null) = (ownedAnnotatingElement <> null)\nownedAnnotatingElement <> null xor owningAnnotatingElement <> null\nownedAnnotatingElement =\n    let ownedAnnotatingElements : Sequence(AnnotatingElement) = \n        ownedRelatedElement->selectByKind(AnnotatingElement) in\n    if ownedAnnotatingElements->isEmpty() then null\n    else ownedAnnotatingElements->first()\n    endif\nannotatingElement =\n    if ownedAnnotatingElement <> null then ownedAnnotatingElement\n    else owningAnnotatingElement\n    endif";
    }
    ref annotatedElement: Element [1,1] unordered
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "annotation";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Element</code> that is annotated by the <code>annotatingElement</code> of this Annotation.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.129/@eStructuralFeatures.5";
      };
    ref annotatingElement: AnnotatingElement [1,1] unordered derived transient volatile opposite external "#//@eClassifiers.8/@eStructuralFeatures.1"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = " <p>The <code>AnnotatingElement</code> that annotates the <code>annotatedElement</code> of this <code>Annotation</code>. This is always either the <code>ownedAnnotatingElement</code> or the <code>owningAnnotatingElement</code>.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.129/@eStructuralFeatures.4";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref ownedAnnotatingElement: AnnotatingElement [0,1] unordered derived transient volatile opposite external "#//@eClassifiers.8/@eStructuralFeatures.3"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>annotatingElement</code> of this <code>Annotation</code>, when it is an <code>ownedRelatedElement</code>.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.9/@eStructuralFeatures.1";
        reference "#//@eClassifiers.129/@eStructuralFeatures.1";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref owningAnnotatedElement: Element [0,1] unordered derived transient volatile opposite external "#//@eClassifiers.49/@eStructuralFeatures.8"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>annotatedElement</code> of this <code>Annotation</code>, when it is also the <code>owningRelatedElement</code>.</p>\n";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.9/@eStructuralFeatures.0";
        reference "#//@eClassifiers.129/@eStructuralFeatures.2";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref owningAnnotatingElement: AnnotatingElement [0,1] unordered derived transient volatile opposite external "#//@eClassifiers.8/@eStructuralFeatures.2"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>annotatingElement</code> of this <code>Annotation</code>, when it is the <code>owningRelatedElement</code>.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.9/@eStructuralFeatures.1";
        reference "#//@eClassifiers.129/@eStructuralFeatures.2";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class AssertConstraintUsage extends ConstraintUsage, Invariant {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>An <code>AssertConstraintUsage</code> is a <code>ConstraintUsage</code> that is also an <code>Invariant</code> and, so, is asserted to be true (by default). Unless it is the <code>AssertConstraintUsage</code> itself, the asserted <code>ConstraintUsage</code> is related to the <code>AssertConstraintUsage</code> by a ReferenceSubsetting <code>Relationship</code>.</p>\nassertedConstraint =\n    if referencedFeatureTarget() = null then self\n    else if referencedFeatureTarget().oclIsKindOf(ConstraintUsage) then\n        referencedFeatureTarget().oclAsType(ConstraintUsage)\n    else null\n    endif endif\nif isNegated then\n    specializesFromLibrary('Constraints::negatedConstraintChecks')\nelse\n    specializesFromLibrary('Constraints::assertedConstraintChecks')\nendif\nreferencedFeatureTarget() <> null implies\n    referencedFeatureTarget().oclIsKindOf(ConstraintUsage)";
    }
    ref assertedConstraint: ConstraintUsage [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "constraintAssertion";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>ConstraintUsage</code> to be performed by the <code>AssertConstraintUsage</code>. It is the <code>referenceFeature</code> of the <code>ownedReferenceSubsetting</code> for the <code>AssertConstraintUsage</code>, if there is one, and, otherwise, the <code>AssertConstraintUsage</code> itself.</p>";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class AssignmentActionUsage extends ActionUsage {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>An <code>AssignmentActionUsage</code> is an <code>ActionUsage</code> that is defined, directly or indirectly, by the <code>ActionDefinition</code> <em><code>AssignmentAction</code></em> from the Systems Model Library. It specifies that the value of the <code>referent</code> <code>Feature</code>, relative to the target given by the result of the <code>targetArgument</code> <code>Expression</code>, should be set to the result of the <code>valueExpression</code>.</p>\n\nspecializesFromLibrary('Actions::assignmentActions')\nlet targetParameter : Feature = inputParameter(1) in\ntargetParameter <> null and\ntargetParameter.ownedFeature->notEmpty() and\ntargetParameter.ownedFeature->first().\n    redefinesFromLibrary('AssignmentAction::target::startingAt')\nvalueExpression = argument(2)\ntargetArgument = argument(1)\nisSubactionUsage() implies\n    specializesFromLibrary('Actions::Action::assignments')\nlet targetParameter : Feature = inputParameter(1) in\ntargetParameter <> null and\ntargetParameter.ownedFeature->notEmpty() and\ntargetParameter.ownedFeature->first().ownedFeature->notEmpty() and\ntargetParameter.ownedFeature->first().ownedFeature->first().\n    redefinesFromLibrary('AssigmentAction::target::startingAt::accessedFeature')\nlet targetParameter : Feature = inputParameter(1) in\ntargetParameter <> null and\ntargetParameter.ownedFeature->notEmpty() and\ntargetParameter.ownedFeature->first().ownedFeature->notEmpty() and\ntargetParameter.ownedFeature->first().ownedFeature->first().redefines(referent)\nreferent =\n    let unownedFeatures : Sequence(Feature) = ownedMembership->\n        reject(oclIsKindOf(FeatureMembership)).memberElement->\n        select(oclIsKindOf(Feature) and \n               not oclIsKindOf(MetadataFeature)) in\n    if unownedFeatures->isEmpty() then null\n    else unownedFeatures->first().oclAsType(Feature)\n    endif\nownedMembership->exists(\n    not oclIsKindOf(OwningMembership) and \n    memberElement.oclIsKindOf(Feature) and\n    not memberElement.oclIsKindOf(MetadataFeature))\nreferent <> null implies referent.featureTarget.isVariable";
    }
    ref referent: Feature [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "assignment";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Feature</code> whose value is to be set.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.107/@eStructuralFeatures.1";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref targetArgument: Expression [0,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "assignmentAction";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Expression</code> whose value is an occurrence in the domain of the <code>referent</code> <code>Feature</code>, for which the value of the <code>referent</code> will be set to the result of the <code>valueExpression</code> by this <code>AssignmentActionUsage</code>.</p>";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref valueExpression: Expression [0,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "assigningAction";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Expression</code> whose result is to be assigned to the <code>referent</code> <code>Feature</code>.</p>";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class Association extends Classifier, Relationship {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>An <code>Association</code> is a <code>Relationship</code> and a <code>Classifier</code> to enable classification of links between things (in the universe). The co-domains (<code>types</code>) of the <code>associationEnd</code> <code>Features</code> are the <code>relatedTypes</code>, as co-domain and participants (linked things) of an <code>Association</code> identify each other.</p>\n\nrelatedType = associationEnd.type\nspecializesFromLibrary('Links::Link')\noclIsKindOf(Structure) = oclIsKindOf(AssociationStructure)\nassociationEnd->size() = 2 implies\n    specializesFromLibrary('Links::BinaryLink')\nnot isAbstract implies relatedType->size() >= 2\nassociationEnds->size() > 2 implies\n    not specializesFromLibrary('Links::BinaryLink')\nsourceType =\n    if relatedType->isEmpty() then null\n    else relatedType->first() endif\ntargetType =\n    if relatedType->size() < 2 then OrderedSet{}\n    else \n        relatedType->\n            subSequence(2, relatedType->size())->\n            asOrderedSet() \n    endif\nownedEndFeature->forAll(type->size() = 1)";
    }
    ref associationEnd: Feature [0,*] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "associationWithEnd";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>features</code> of the <code>Association</code> that identify the things that can be related by it. A concrete <code>Association</code> must have at least two <code>associationEnds</code>. When it has exactly two, the <code>Association</code> is called a <em>binary</em> <code>Association</code>.</p> \n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.160/@eStructuralFeatures.2";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref relatedType: Type [0,*] nonunique derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "association";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>types</code> of the <code>associationEnds</code> of the <code>Association</code>, which are the <code>relatedElements</code> of the <code>Association</code> considered as a <code>Relationship</code>.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.129/@eStructuralFeatures.3";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref sourceType: Type [0,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "sourceAssociation";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The source <code>relatedType</code> for this <code>Association</code>. It is the first <code>relatedType</code> of the <code>Association</code>.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.129/@eStructuralFeatures.4";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.12/@eStructuralFeatures.1";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref targetType: Type [0,*] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "targetAssociation";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The target <code>relatedTypes</code> for this <code>Association</code>. This includes all the <code>relatedTypes</code> other than the <code>sourceType</code>.</p> \n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.129/@eStructuralFeatures.5";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.12/@eStructuralFeatures.1";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class AssociationStructure extends Association, Structure {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>An <code>AssociationStructure</code> is an <code>Association</code> that is also a <code>Structure</code>, classifying link objects that are both links and objects. As objects, link objects can be created and destroyed, and their non-end <code>Features</code> can change over time. However, the values of the end <code>Features</code> of a link object are fixed and cannot change over its lifetime.</p>\nspecializesFromLibrary('Objects::LinkObject')\nendFeature->size() = 2 implies\n    specializesFromLibrary('Objects::BinaryLinkObject')";
    }
  }
  class AttributeDefinition extends Definition, DataType {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>An <code>AttributeDefinition</code> is a <code>Definition</code> and a <code>DataType</code> of information about a quality or characteristic of a system or part of a system that has no independent identity other than its value. All <code>features</code> of an <code>AttributeDefinition</code> must be referential (non-composite).</p>\n\n<p>As a <code>DataType</code>, an <code>AttributeDefinition</code> must specialize, directly or indirectly, the base <code>DataType</code> <code><em>Base::DataValue</em></code> from the Kernel Semantic Library.</p>\nfeature->forAll(not isComposite)";
    }
  }
  class AttributeUsage extends Usage {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>An <code>AttributeUsage</code> is a <code>Usage</code> whose type is a <code>DataType</code>. Nominally, if the type is an <code>AttributeDefinition</code>, an <code>AttributeUsage</code> is a usage of a <code>AttributeDefinition</code> to represent the value of some system quality or characteristic. However, other kinds of kernel <code>DataTypes</code> are also allowed, to permit use of <code>DataTypes</code> from the Kernel Model Libraries. An <code>AttributeUsage</code> itself as well as all its nested <code>features</code> must be referential (non-composite).</p>\n\n<p>An <code>AttributeUsage</code> must specialize, directly or indirectly, the base <code>Feature</code> <code><em>Base::dataValues</em></code> from the Kernel Semantic Library.</p>\nisReference\nfeature->forAll(not isComposite)\nspecializesFromLibrary('Base::dataValues')";
    }
    ref attributeDefinition: DataType [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "definedAttribute";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>DataTypes</code> that are the types of this <code>AttributeUsage</code>. Nominally, these are <code>AttributeDefinitions</code>, but other kinds of kernel <code>DataTypes</code> are also allowed, to permit use of <code>DataTypes</code> from the Kernel Model Libraries.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.163/@eStructuralFeatures.0";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class Behavior extends Class {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>Behavior </code>coordinates occurrences of other <code>Behaviors</code>, as well as changes in objects. <code>Behaviors</code> can be decomposed into <code>Steps</code> and be characterized by <code>parameters</code>.</p>\n\nownedSpecialization.general->forAll(not oclIsKindOf(Structure))\nspecializesFromLibrary('Performances::Performance')\nstep = feature->selectByKind(Step)";
    }
    ref `parameter`: Feature [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "parameteredBehavior";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The parameters of this <code>Behavior</code>, which are defined as its <code>directedFeatures</code>, whose values are passed into and/or out of a performance of the <code>Behavior</code>.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.160/@eStructuralFeatures.1";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref step: Step [0,*] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "featuringBehavior";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Steps</code> that make up this <code>Behavior</code>.</p>\n";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.160/@eStructuralFeatures.3";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class BindingConnector extends Connector {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>BindingConnector</code> is a binary <code>Connector</code> that requires its <code>relatedFeatures</code> to identify the same things (have the same values).</p>\n\nrelatedFeature->size() = 2\nspecializesFromLibrary('Links::selfLinks')";
    }
  }
  class BindingConnectorAsUsage extends ConnectorAsUsage, BindingConnector {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>BindingConnectorAsUsage</code> is both a <code>BindingConnector</code> and a <code>ConnectorAsUsage</code>.</p>";
    }
  }
  class BooleanExpression extends Expression {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>BooleanExpression</code> is a <em><code>Boolean</code></em>-valued <code>Expression</code> whose type is a <code>Predicate</code>. It represents a logical condition resulting from the evaluation of the <code>Predicate</code>.</p>\n\nspecializesFromLibrary('Performances::booleanEvaluations')";
    }
    ref predicate: Predicate [0,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "typedBooleanExpression";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The Predicate that types the Expression.</p>\n\n<p>The <code>Predicate</code> that types this <code>BooleanExpression</code>.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.57/@eStructuralFeatures.0";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class CalculationDefinition extends ActionDefinition, Function {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>CalculationDefinition</code> is an <coed>ActionDefinition</code> that also defines a <code>Function</code> producing a <code>result</code>.</p>\nspecializesFromLibrary('Calculations::Calculation')\ncalculation = action->selectByKind(CalculationUsage)";
    }
    ref calculation: CalculationUsage [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "featuringCalculationDefinition";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>actions</code> of this <code>CalculationDefinition</code> that are <code>CalculationUsages</code>.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.1/@eStructuralFeatures.0";
        reference "#//@eClassifiers.73/@eStructuralFeatures.0";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class CalculationUsage extends ActionUsage, Expression {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>CalculationUsage</code> is an <code>ActionUsage</code> that is also an <code>Expression</code>, and, so, is typed by a <code>Function</code>. Nominally, if the <code>type</code> is a <code>CalculationDefinition</code>, a <code>CalculationUsage</code> is a <code>Usage</code> of that <code>CalculationDefinition</code> within a system. However, other kinds of kernel <code>Functions</code> are also allowed, to permit use of <code>Functions</code> from the Kernel Model Libraries.</p>\nspecializesFromLibrary('Calculations::calculations')\nowningType <> null and\n(owningType.oclIsKindOf(CalculationDefinition) or\n owningType.oclIsKindOf(CalculationUsage)) implies\n    specializesFromLibrary('Calculations::Calculation::subcalculations')";
    }
    ref calculationDefinition: Function [0,1] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "definedCalculation";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <ode>Function</code> that is the <code>type</code> of this <code>CalculationUsage</code>. Nominally, this would be a <code>CalculationDefinition</code>, but a kernel <code>Function</code> is also allowed, to permit use of <code>Functions</code> from the Kernel Model Libraries.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.57/@eStructuralFeatures.0";
        reference "#//@eClassifiers.2/@eStructuralFeatures.0";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class CaseDefinition extends CalculationDefinition {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>CaseDefinition</code> is a <code>CalculationDefinition</code> for a process, often involving collecting evidence or data, relative to a subject, possibly involving the collaboration of one or more other actors, producing a result that meets an objective.</p>\nobjectiveRequirement = \n    let objectives: OrderedSet(RequirementUsage) = \n        featureMembership->\n            selectByKind(ObjectiveMembership).\n            ownedRequirement in\n    if objectives->isEmpty() then null\n    else objectives->first().ownedObjectiveRequirement\n    endif\nfeatureMembership->\n    selectByKind(ObjectiveMembership)->\n    size() <= 1\nsubjectParameter =\n    let subjectMems : OrderedSet(SubjectMembership) = \n        featureMembership->selectByKind(SubjectMembership) in\n    if subjectMems->isEmpty() then null\n    else subjectMems->first().ownedSubjectParameter\n    endif\nactorParameter = featureMembership->\n    selectByKind(ActorMembership).\n    ownedActorParameter\nfeatureMembership->selectByKind(SubjectMembership)->size() <= 1\ninput->notEmpty() and input->first() = subjectParameter\nspecializesFromLibrary('Cases::Case')";
    }
    ref actorParameter: PartUsage [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "actorOwningCaseDefinition";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>parameters</code> of this <code>CaseDefinition</code> that represent actors involved in the case.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.16/@eStructuralFeatures.0";
        reference "#//@eClassifiers.44/@eStructuralFeatures.29";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref objectiveRequirement: RequirementUsage [0,1] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "objectiveOwningCaseDefinition";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>RequirementUsage</code> representing the objective of this <code>CaseDefinition</code>.</p> \n";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.44/@eStructuralFeatures.29";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref subjectParameter: Usage [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "subjectOwningCaseDefinition";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>parameter</code> of this <code>CaseDefinition</code> that represents its subject.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.16/@eStructuralFeatures.0";
        reference "#//@eClassifiers.44/@eStructuralFeatures.29";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class CaseUsage extends CalculationUsage {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>CaseUsage</code> is a <code>Usage</code> of a <code>CaseDefinition</code>.</p>\nobjectiveRequirement = \n    let objectives: OrderedSet(RequirementUsage) = \n        featureMembership->\n            selectByKind(ObjectiveMembership).\n            ownedRequirement in\n    if objectives->isEmpty() then null\n    else objectives->first().ownedObjectiveRequirement\n    endif\nfeatureMembership->\n    selectByKind(ObjectiveMembership)->\n    size() <= 1\nfeatureMembership->\n\tselectByKind(SubjectMembership)->\n\tsize() <= 1\nactorParameter = featureMembership->\n    selectByKind(ActorMembership).\n    ownedActorParameter\nsubjectParameter =\n    let subjects : OrderedSet(SubjectMembership) = \n        featureMembership->selectByKind(SubjectMembership) in\n    if subjects->isEmpty() then null\n    else subjects->first().ownedSubjectParameter\n    endif\ninput->notEmpty() and input->first() = subjectParameter\nspecializesFromLibrary('Cases::cases')\nisComposite and owningType <> null and \n    (owningType.oclIsKindOf(CaseDefinition) or\n     owningType.oclIsKindOf(CaseUsage)) implies\n    specializesFromLibrary('Cases::Case::subcases')";
    }
    ref actorParameter: PartUsage [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "actorOwningCase";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>parameters</code> of this <code>CaseUsage</code> that represent actors involved in the case.</p>";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.146/@eStructuralFeatures.1";
        reference "#//@eClassifiers.163/@eStructuralFeatures.34";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref caseDefinition: CaseDefinition [0,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "definedCase";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The CaseDefinition that is the type of this CaseUsage.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.21/@eStructuralFeatures.0";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref objectiveRequirement: RequirementUsage [0,1] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "objectiveOwningCase";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>RequirementUsage</code> representing the objective of this <code>CaseUsage</code>.</p> \n";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.163/@eStructuralFeatures.34";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref subjectParameter: Usage [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "subjectOwningCase";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>parameter</code> of this <code>CaseUsage</code> that represents its subject.</p>\n";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.146/@eStructuralFeatures.1";
        reference "#//@eClassifiers.163/@eStructuralFeatures.34";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class Class extends Classifier {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>Class</code> is a <code>Classifier</code> of things (in the universe) that can be distinguished without regard to how they are related to other things (via <code>Features</code>). This means multiple things classified by the same <code>Class</code> can be distinguished, even when they are related other things in exactly the same way.</p>\n\nspecializesFromLibrary('Occurrences::Occurrence')\nownedSpecialization.general->\n    forAll(not oclIsKindOf(DataType)) and\nnot oclIsKindOf(Association) implies\n    ownedSpecialization.general->\n        forAll(not oclIsKindOf(Association))";
    }
  }
  class Classifier extends Type {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>Classifier</code> is a <code>Type</code> that classifies:</p>\n\n<ul>\n\t<li>Things (in the universe) regardless of how <code>Features</code> relate them. (These are interpreted semantically as sequences of exactly one thing.)</li>\n\t<li>How the above things are related by <code>Features.</code> (These are interpreted semantically as sequences of multiple things, such that the last thing in the sequence is also classified by the <code>Classifier</code>. Note that this means that a <code>Classifier</code> modeled as specializing a <code>Feature</code> cannot classify anything.)</li>\n</ul>\n\n\nownedSubclassification = \n    ownedSpecialization->selectByKind(Subclassification)\nmultiplicity <> null implies multiplicity.featuringType->isEmpty()";
    }
    ref ownedSubclassification: Subclassification [0,*] unordered derived transient volatile opposite external "#//@eClassifiers.148/@eStructuralFeatures.0"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>ownedSpecializations</code> of this <code>Classifier</code> that are <code>Subclassifications</code>, for which this <code>Classifier</code> is the <code>subclassifier</code>.</p>\n";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.160/@eStructuralFeatures.21";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class CollectExpression extends OperatorExpression {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>CollectExpression</code> is an <code>OperatorExpression</code> whose <code>operator</code> is <code>\"collect\"</code>, which resolves to the <code>Function</code> <em><code>ControlFunctions::collect</code></em> from the Kernel Functions Library.</p>\noperator = 'collect'";
    }
  }
  class Comment extends AnnotatingElement {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>Comment</code> is an <code>AnnotatingElement</code> whose <code>body</code> in some way describes its <code>annotatedElements</code>.</p>\n";
    }
    attr body: EString [1,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The annotation text for the <code>Comment</code>.</p>\n";
      };
    attr locale: EString [0,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Identification of the language of the <code>body</code> text and, optionally, the region and/or encoding. The format shall be a POSIX locale conformant to ISO/IEC 15897, with the format <code>[language[_territory][.codeset][@modifier]]</code>.</p>";
      };
  }
  class ConcernDefinition extends RequirementDefinition {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>ConcernDefinition</code> is a <code>RequirementDefinition</code> that one or more stakeholders may be interested in having addressed. These stakeholders are identified by the <code>ownedStakeholders</code>of the <code>ConcernDefinition</code>.</p>\n\nspecializesFromLibrary('Requirements::ConcernCheck')";
    }
  }
  class ConcernUsage extends RequirementUsage {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>ConcernUsage</code> is a <code>Usage</code> of a <code>ConcernDefinition</code>.</p>\n\n The <code>ownedStakeholder</code> features of the ConcernUsage shall all subset the <em><code>ConcernCheck::concernedStakeholders</code> </em>feature. If the ConcernUsage is an <code>ownedFeature</code> of a StakeholderDefinition or StakeholderUsage, then the ConcernUsage shall have an <code>ownedStakeholder</code> feature that is bound to the <em><code>self</code></em> feature of its owner.</p>\n\nspecializesFromLibrary('Requirements::concernChecks')\nowningFeatureMembership <> null and\nowningFeatureMembership.oclIsKindOf(FramedConcernMembership) implies\n    specializesFromLibrary('Requirements::RequirementCheck::concerns')";
    }
    ref concernDefinition: ConcernDefinition [0,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "definedConcern";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The ConcernDefinition that is the single type of this ConcernUsage.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.134/@eStructuralFeatures.5";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class ConjugatedPortDefinition extends PortDefinition {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>ConjugatedPortDefinition</code> is a <code>PortDefinition</code> that is a <code>PortDefinition</code> of its original <code>PortDefinition</code>. That is, a <code>ConjugatedPortDefinition</code> inherits all the <code>features</code> of the original <code>PortDefinition</code>, but input <code>flows</code> of the original <code>PortDefinition</code> become outputs on the <code>ConjugatedPortDefinition</code> and output <code>flows</code> of the original <code>PortDefinition</code> become inputs on the <code>ConjugatedPortDefinition</code>. Every <code>PortDefinition</code> (that is not itself a <code><code>ConjugatedPortDefinition</code></code>) has exactly one corresponding <code>ConjugatedPortDefinition</code>, whose effective name is the name of the <code>originalPortDefinition</code>, with the character <code>~</code> prepended.</p>\nownedPortConjugator.originalPortDefinition = originalPortDefinition\nconjugatedPortDefinition = null";
    }
    ref originalPortDefinition: PortDefinition [1,1] unordered derived transient volatile opposite external "#//@eClassifiers.123/@eStructuralFeatures.0"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The original <code>PortDefinition</code> for this <code>ConjugatedPortDefinition</code>, which is the <code>owningNamespace</code> of the <code>ConjugatedPortDefinition</code>.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.49/@eStructuralFeatures.13";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref ownedPortConjugator: PortConjugation [1,1] unordered derived transient volatile opposite external "#//@eClassifiers.122/@eStructuralFeatures.0"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>PortConjugation</code> that is the <code>ownedConjugator</code> of this <code>ConjugatedPortDefinition</code>, linking it to its <code>originalPortDefinition</code>.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.160/@eStructuralFeatures.14";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class ConjugatedPortTyping extends FeatureTyping {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>ConjugatedPortTyping</code> is a <code>FeatureTyping</code> whose <code>type</code> is a <code>ConjugatedPortDefinition</code>. (This relationship is intended to be an abstract-syntax marker for a special surface notation for conjugated typing of ports.)</p>\nportDefinition = conjugatedPortDefinition.originalPortDefinition";
    }
    ref conjugatedPortDefinition: ConjugatedPortDefinition [1,1] unordered
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "typingByConjugatedPort";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>type</code> of this <code>ConjugatedPortTyping</code> considered as a <code>FeatureTyping</code>, which must be a <code>ConjugatedPortDefinition</code>.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.64/@eStructuralFeatures.1";
      };
    ref portDefinition: PortDefinition [1,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "conjugatedPortTyping";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>originalPortDefinition</code> of the <code>conjugatedPortDefinition</code> of this <code>ConjugatedPortTyping</code>.</p>";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class Conjugation extends Relationship {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p><code>Conjugation</code> is a <code>Relationship</code> between two types in which the <code>conjugatedType</code> inherits all the <code>Features</code> of the <code>originalType</code>, but with all <code>input</code> and <code>output</code> <code>Features</code> reversed. That is, any <code>Features</code> with a <code>direction</code> <em>in</em> relative to the <code>originalType</code> are considered to have an effective <code>direction</code> of <em>out</em> relative to the <code>conjugatedType</code> and, similarly, <code>Features</code> with <code>direction</code> <em>out</em> in the <code>originalType</code> are considered to have an effective <code>direction</code> of <em>in</em> in the <code>conjugatedType</code>. <code>Features</code> with <code>direction</code> <em>inout</em>, or with no <code>direction</code>, in the <code>originalType</code>, are inherited without change.</p>\n\n<p>A <code>Type</code> may participate as a <code>conjugatedType</code> in at most one <code>Conjugation</code> relationship, and such a <code>Type</code> may not also be the <code>specific</code> <code>Type</code> in any <code>Specialization</code> relationship.</p>\n";
    }
    ref conjugatedType: Type [1,1] unordered
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "conjugator";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Type</code> that is the result of applying <code>Conjugation</code> to the <code>originalType</code>.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.129/@eStructuralFeatures.4";
      };
    ref originalType: Type [1,1] unordered
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "conjugation";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Type</code> to be conjugated.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.129/@eStructuralFeatures.5";
      };
    ref owningType: Type [0,1] unordered derived transient volatile opposite external "#//@eClassifiers.160/@eStructuralFeatures.14"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>conjugatedType</code> of this <code>Conjugation</code> that is also its <code>owningRelatedElement</code>.</p>\n";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.32/@eStructuralFeatures.0";
        reference "#//@eClassifiers.129/@eStructuralFeatures.2";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class ConnectionDefinition extends PartDefinition, AssociationStructure {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>ConnectionDefinition</code> is a <code>PartDefinition</code> that is also an <code>AssociationStructure</code>. The end <code>Features</code> of a <code>ConnectionDefinition</code> must be <code>Usages</code>.</p>\nspecializesFromLibrary('Connections::Connection')\nownedEndFeature->size() = 2 implies\n    specializesFromLibrary('Connections::BinaryConnection')\nisSufficient";
    }
    ref connectionEnd: Usage [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "connectionDefinitionWithEnd";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Usages</code> that define the things related by the <code>ConnectionDefinition</code>.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.12/@eStructuralFeatures.0";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class ConnectionUsage extends ConnectorAsUsage, PartUsage {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>ConnectionUsage</code> is a <code>ConnectorAsUsage</code> that is also a <code>PartUsage</code>. Nominally, if its type is a <code>ConnectionDefinition</code>, then a <code>ConnectionUsage</code> is a Usage of that <code>ConnectionDefinition</code>, representing a connection between parts of a system. However, other kinds of kernel <code>AssociationStructures</code> are also allowed, to permit use of <code>AssociationStructures</code> from the Kernel Model Libraries.</p>\nspecializesFromLibrary('Connections::connections')\nownedEndFeature->size() = 2 implies\n    specializesFromLibrary('Connections::binaryConnections')";
    }
    ref connectionDefinition: AssociationStructure [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "definedConnection";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>AssociationStructures</code> that are the types of this <code>ConnectionUsage</code>. Nominally, these are , but other kinds of Kernel <code>AssociationStructures</code> are also allowed, to permit use of <code>AssociationStructures</code> from the Kernel Model Libraries</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.35/@eStructuralFeatures.0";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.86/@eStructuralFeatures.0";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class Connector extends Feature, Relationship {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>Connector</code> is a usage of <code>Associations</code>, with links restricted according to instances of the <code>Type</code> in which they are used (domain of the <code>Connector</code>). The <code>associations</code> of the <code>Connector</code> restrict what kinds of things might be linked. The <code>Connector</code> further restricts these links to be between values of <code>Features</code> on instances of its domain.</p>\n\nrelatedFeature = connectorEnd.ownedReferenceSubsetting->\n    select(s | s <> null).subsettedFeature\nrelatedFeature->forAll(f | \n    if featuringType->isEmpty() then f.isFeaturedWithin(null)\n    else featuringType->forAll(t | f.isFeaturedWithin(t))\n    endif)\nsourceFeature = \n    if relatedFeature->isEmpty() then null \n    else relatedFeature->first() \n    endif\ntargetFeature =\n    if relatedFeature->size() < 2 then OrderedSet{}\n    else \n        relatedFeature->\n            subSequence(2, relatedFeature->size())->\n            asOrderedSet()\n    endif\nnot isAbstract implies relatedFeature->size() >= 2\nspecializesFromLibrary('Links::links')\nassociation->exists(oclIsKindOf(AssociationStructure)) implies\n    specializesFromLibrary('Objects::linkObjects')\nconnectorEnds->size() = 2 and\nassociation->exists(oclIsKindOf(AssociationStructure)) implies\n    specializesFromLibrary('Objects::binaryLinkObjects')\nconnectorEnd->size() = 2 implies\n    specializesFromLibrary('Links::binaryLinks')\nconnectorEnds->size() > 2 implies\n    not specializesFromLibrary('Links::BinaryLink')\nlet commonFeaturingTypes : OrderedSet(Type) = \n    relatedFeature->closure(featuringType)->select(t | \n        relatedFeature->forAll(f | f.isFeaturedWithin(t))\n    ) in\nlet nearestCommonFeaturingTypes : OrderedSet(Type) =\n    commonFeaturingTypes->reject(t1 | \n        commonFeaturingTypes->exists(t2 | \n            t2 <> t1 and t2->closure(featuringType)->contains(t1)\n    )) in\nif nearestCommonFeaturingTypes->isEmpty() then null\nelse nearestCommonFeaturingTypes->first()\nendif";
    }
    ref association: Association [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "typedConnector";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Associations</code> that type the <code>Connector</code>.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.58/@eStructuralFeatures.24";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref connectorEnd: Feature [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "featuringConnector";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>endFeatures</code> of a <code>Connector</code>, which redefine the <code>endFeatures</code> of the <code>associations</code> of the <code>Connector</code>. The <code>connectorEnds</code> determine via <code>ReferenceSubsetting</code> <code>Relationships</code> which <code>Features</code> are related by the <code>Connector</code>.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.160/@eStructuralFeatures.2";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref defaultFeaturingType: Type [0,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "featuredConnector";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The innermost <code>Type</code> that is a common direct or indirect <code>featuringType</code> of the <code>relatedFeatures</code>, such that, if it exists and was the <code>featuringType</code> of this <code>Connector</code>, the <code>Connector</code> would satisfy the <code>checkConnectorTypeFeaturing</code> constraint.</p>";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref relatedFeature: Feature [0,*] nonunique derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "connector";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The <code>Features</code> that are related by this <code>Connector</code> considered as a <code>Relationship</code> and that restrict the links it identifies, given by the referenced <code>Features</code> of the <code>connectorEnds</code> of the <code>Connector</code>.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.129/@eStructuralFeatures.3";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref sourceFeature: Feature [0,1] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "sourceConnector";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The source <code>relatedFeature</code> for this <code>Connector</code>. It is the first <code>relatedFeature</code>.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.129/@eStructuralFeatures.4";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.35/@eStructuralFeatures.3";
      }
      annotation "http://www.omg.org/spec/SysML" { };
    ref targetFeature: Feature [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "targetConnector";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The target <code>relatedFeatures</code> for this <code>Connector</code>. This includes all the <code>relatedFeatures</code> other than the <code>sourceFeature</code>.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.129/@eStructuralFeatures.5";
      }
      annotation "subsets" {
        reference "#//@eClassifiers.35/@eStructuralFeatures.3";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  abstract class ConnectorAsUsage extends Usage, Connector {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>ConnectorAsUsage</code> is both a <code>Connector</code> and a <code>Usage</code>. <code>ConnectorAsUsage</code> cannot itself be instantiated in a SysML model, but it is a base class for the concrete classes <code>BindingConnectorAsUsage</code>, <code>SuccessionAsUsage</code>, <code>ConnectionUsage</code> and <code>FlowUsage</code>.</p>";
    }
  }
  class ConstraintDefinition extends OccurrenceDefinition, Predicate {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>ConstraintDefinition</code> is an <code>OccurrenceDefinition</code> that is also a <code>Predicate</code> that defines a constraint that may be asserted to hold on a system or part of a system.</p>\n\n\nspecializesFromLibrary('Constraints::ConstraintCheck')";
    }
  }
  class ConstraintUsage extends OccurrenceUsage, BooleanExpression {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>ConstraintUsage</code> is an <code>OccurrenceUsage</code> that is also a <code>BooleanExpression</code>, and, so, is typed by a <code>Predicate</code>. Nominally, if the type is a <code>ConstraintDefinition</code>, a <code>ConstraintUsage</code> is a <code>Usage</code> of that <code>ConstraintDefinition</code>. However, other kinds of kernel <code>Predicates</code> are also allowed, to permit use of <code>Predicates</code> from the Kernel Model Libraries.</p>\nisComposite and\nowningFeatureMembership <> null and\nowningFeatureMembership.oclIsKindOf(RequirementConstraintMembership) implies\n    if owningFeatureMembership.oclAsType(RequirementConstraintMembership).kind = \n        RequirementConstraintKind::assumption then\n        specializesFromLibrary('Requirements::RequirementCheck::assumptions')\n    else\n        specializesFromLibrary('Requirements::RequirementCheck::constraints')\n    endif\nspecializesFromLibrary('Constraints::constraintChecks')\nowningType <> null and\n(owningType.oclIsKindOf(ItemDefinition) or\n owningType.oclIsKindOf(ItemUsage)) implies\n    specializesFromLibrary('Items::Item::checkedConstraints')";
    }
    ref constraintDefinition: Predicate [0,1] unordered derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "definedConstraint";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The (single) <code>Predicate</code> that is the type of this <code>ConstraintUsage</code>. Nominally, this will be a <code>ConstraintDefinition</code>, but other kinds of <code>Predicates</code> are also allowed, to permit use of <code>Predicates</code> from the Kernel Model Libraries.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.19/@eStructuralFeatures.0";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class ConstructorExpression extends InstantiationExpression {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>ConstructorExpression</code> is an <code>InstantiationExpression</code> whose <code>result</code> specializes its <code>instantiatedType</code>, binding some or all of the <code>features</code> of the <code>instantiatedType</code> to the <code>results</code> of its <code>argument</code> <code>Expressions</code>.</p>\ninstantiatedType.feature->collect(f | \n    result.ownedFeatures->select(redefines(f)).valuation->\n    select(v | v <> null).value\n)\nlet features : OrderedSet(Feature) = instantiatedType.feature->\n    select(visibility = VisibilityKind::public) in\nresult.ownedFeature->forAll(f1 | result.ownedFeature->forAll(f2 |\n    f1 <> f2 implies\n        f1.ownedRedefinition.redefinedFeature->\n            intersection(f2.ownedRedefinition.redefinedFeature)->\n            intersection(features)->isEmpty()))\nlet features : OrderedSet(Feature) = instantiatedType.feature->\n    select(owningMembership.visibility = VisibilityKind::public) in\nresult.ownedFeature->forAll(f | \n    f.ownedRedefinition.redefinedFeature->\n        intersection(features)->size() = 1)\nTBD\nspecializes('Performances::constructorEvaluations')\nresult.specializes(instantiatedType)\nownedFeatures->excluding(result)->isEmpty()";
    }
  }
  abstract class ControlNode extends ActionUsage {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>ControlNode</code> is an <code>ActionUsage</code> that does not have any inherent behavior but provides constraints on incoming and outgoing <code>Successions</code> that are used to control other <code>Actions</code>. A <code>ControlNode</code> must be a composite owned <code>usage</code> of an <code>ActionDefinition</code> or <code>ActionUsage</code>.</p>\n\nsourceConnector->selectByKind(Succession)->\n    collect(connectorEnd->at(1).multiplicity)->\n    forAll(sourceMult | \n        multiplicityHasBounds(sourceMult, 1, 1))\nowningType <> null and \n(owningType.oclIsKindOf(ActionDefinition) or\n owningType.oclIsKindOf(ActionUsage))\ntargetConnector->selectByKind(Succession)->\n    collect(connectorEnd->at(2).multiplicity)->\n    forAll(targetMult | \n        multiplicityHasBounds(targetMult, 1, 1))\nspecializesFromLibrary('Action::Action::controls')\nisComposite";
    }
    op multiplicityHasBounds(
      mult: Multiplicity [1,1] unordered,
      lower: EInt [1,1] unordered,
      upper: EInt [1,1] unordered
    ) -> EBoolean [1,1] unordered
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>Check that the given <code>Multiplicity</code> has <code>lowerBound</code> and <code>upperBound</code> expressions that are model-level evaluable to the given <code>lower</code> and <code>upper</code> values.</p>\nmult <> null and\nif mult.oclIsKindOf(MultiplicityRange) then\n    mult.oclAsType(MultiplicityRange).hasBounds(lower, upper)\nelse\n    mult.allSuperTypes()->exists(\n        oclisKindOf(MultiplicityRange) and\n        oclAsType(MultiplicityRange).hasBounds(lower, upper)\nendif";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class CrossSubsetting extends Subsetting {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p><code>CrossSubsetting</code> is a kind of <code>Subsetting</code> for end <code>Features</code>, as identified by <code>crossingFeature</code>, to subset a chained <code>Feature</code>, identified by <code>crossedFeature.</code> It navigates to instances of the end <code>Feature</code>’s type from instances of other end <code>Feature</code> types on the same <code>owningType</code> (at least two end <code>Features</code> are required for any of them to have a <code>CrossSubsetting</code>).</p>\n\n<p>The <code>crossedFeature</code> of a <code>CrossSubsetting</code> must have a feature chain of exactly two <code>Features</code>. The second <code>Feature</code> in the chain is the <code>crossFeature</code> of the <code>crossingFeature</code> (end <code>Feature</code>), which has the same type as the <code>crossingFeature</code>. When the <code>owningType</code> of the <code>crossingFeature</code> has exactly two end <code>Features</code>, the first <code>Feature</code> in the chain of the <code>crossedFeature</code> is the other end <code>Feature</code>. The <code>crossFeature</code>’s <code>featuringType</code> in this case is the other end <code>Feature</code>. When the <code>owningType</code> has more than two end <code>Features</code>, the first <code>Feature</code> in the chain is a <code>Feature</code> that <code>CrossMultiplies</code> all the other end <code>Features</code>, which is also the <code>featuringType</code> of the <code>crossFeature</code>.</p>\n\n<p>A <code>crossFeature</code> must be owned by its <code>featureCrossing</code> (end <code>Feature</code>) when the <code>featureCrossing</code> <code>owningType</code> has more than two end <code>Features</code>. Otherwise, for exactly two end <code>Features</code>, the <code>crossFeatures</code> of each the ends can instead optionally be inherited by the other end from one of its <code>types</code> or a subsetted <code>Feature</code>.</p>\ncrossingFeature.isEnd and crossingFeature.owningType <> null implies\n    let endFeatures: Sequence(Feature) = crossingFeature.owningType.endFeature in\n    let chainingFeatures: Sequence(Feature) = crossedFeature.chainingFeature in\n    chainingFeatures->size() = 2 and\n    endFeatures->size() = 2 implies \n        chainingFeatures->at(1) = endFeatures->excluding(crossingFeature)->at(1)\ncrossingFeature.isEnd and\ncrossingFeature.owningType<>null and\ncrossingFeature.owningType.endFeature ->size() > 1";
    }
    ref crossedFeature: Feature [1,1] unordered
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "crossSupersetting";
      }
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The chained <code>Feature</code> that is cross subset by the <code>crossingFeature</code> of this <code>CrossSubsetting</code>.</p>\n";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.150/@eStructuralFeatures.1";
      };
    ref crossingFeature: Feature [1,1] unordered derived transient volatile opposite external "#//@eClassifiers.58/@eStructuralFeatures.14"
      annotation "http://www.eclipse.org/emf/2002/GenModel" {
        detail "documentation" = "<p>The end <code>Feature</code> that owns this <code>CrossSubsetting</code> relationship and is also its </code>subsettingFeature</code>.</p>";
      }
      annotation "redefines" {
        reference "#//@eClassifiers.150/@eStructuralFeatures.0";
        reference "#//@eClassifiers.150/@eStructuralFeatures.2";
      }
      annotation "http://www.omg.org/spec/SysML" { };
  }
  class DataType extends Classifier {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>DataType</code> is a <code>Classifier</code> of things (in the universe) that can only be distinguished by how they are related to other things (via Features). This means multiple things classified by the same <code>DataType</code></p>\n\n<ul>\n\t<li>Cannot be distinguished when they are related to other things in exactly the same way, even when they are intended to be about different things.</li>\n\t<li>Can be distinguished when they are related to other things in different ways, even when they are intended to be about the same thing.</li>\n</ul>\n\nownedSpecialization.general->\n    forAll(not oclIsKindOf(Class) and \n           not oclIsKindOf(Association))\nspecializesFromLibrary('Base::DataValue')";
    }
  }
  class DecisionNode extends ControlNode {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>DecisionNode</code> is a <code>ControlNode</code> that makes a selection from its outgoing <code>Successions</code>.</p>\ntargetConnector->selectByKind(Succession)->size() <= 1\nsourceConnector->selectAsKind(Succession)->\n    collect(connectorEnd->at(2))->\n    forAll(targetMult |\n        multiplicityHasBounds(targetMult, 0, 1))\nspecializesFromLibrary('Actions::Action::decisions')\nsourceConnector->selectByKind(Succession)->\n    forAll(subsetsChain(self, \n        resolveGlobal('ControlPerformances::DecisionPerformance::outgoingHBLink')))";
    }
  }
  class Definition extends Classifier {
    annotation "http://www.eclipse.org/emf/2002/GenModel" {
      detail "documentation" = "<p>A <code>Definition</code> is a <code>Classifier</code> of <code>Usages</code>. The actual kinds of <code>Definition</code> that may appear in a model are given by the subclasses of <code>Definition</code> (possibly as extended with user-defined <em><code>SemanticMetadata</code></em>).</p>\n\n<p>Normally, a <code>Definition</code> has owned Usages that model <code>features</code> of the thing being defined. A <code>Definition</code> may also have other <code>Definitions</code> nested in it, but this has no semantic significance, other than the nested scoping resulting from the <code>Definition</code> being considered as a <code>Namespace</code> for any nested <code>Definitions</code>.</p>\n\n<p>However, if a <code>Definition</code> has <code>isVariation</code> = <code>true</code>, then it represents a <em>variation point</em> <code>Definition</code>. In this case, all of its <code>members</code> must be <code>variant</code> <code>Usages</code>, related to the <code>Definition</code> by <code>VariantMembership</code> <code>Relationships</code>. Rather than being <code>features</code> of the <code>Definition</code>, <code>variant</code> <code>Usages</code> model different concrete alternatives that can be chosen to fill in for an abstract <code>Usage</code> of the variation point <code>Definition</code>.</p>\n\nisVariation implies ownedFeatureMembership->isEmpty()\nvariant = variantMembership.ownedVariantUsage\nvariantMembership = ownedMembership->selectByKind(VariantMembership)\nisVariation implies\n    not ownedSpecialization.specific->exists(\n        oclIsKindOf(Definition) and\n        oclAsType(Definition).isVariation)\nusage = feature->selectByKind(Usage)\ndirectedUsage = directedFeature->selectByKind(Usage)\nownedUsage = ownedFeature->selectByKind(Usage)\nownedAttribute = ownedUsage->selectByKind(AttributeUsage)\nownedReference = ownedUsage->selectByKind(ReferenceUsage)\nownedEnumeration = ownedUsage->selectByKind(EnumerationUsage)\nownedOccurrence = ownedUsage->selectByKind(OccurrenceUsage)\nownedItem = ownedUsage->selectByKind(ItemUsage)\nownedPart = ownedUsage->selectByKind(PartUsage)\nownedPort = ownedUsage->selectByKind(PortUsage)\nownedConnection = ownedUsage->selectByKind(ConnectorAsUsage)\nownedFlow = ownedUsage->selectByKind(FlowUsage)\nownedInterface = ownedUsage->selectByKind(ReferenceUsage)\nownedAllocation = ownedUsage->selectByKind(AllocationUsage)\nownedAction = ownedUsage->selectByKind(ActionUsage)\nownedState = ownedUsage->selectByKind(StateUsage)\nownedTransition = ownedUsage->selectByKind(TransitionUsage)\nownedCalculation = ownedUsage->selectByKind(CalculationUsage)\nownedConstraint = ownedUsage->selectByKind(ConstraintUsage)\nownedRequirement = ownedUsage->selectByKind(RequirementUsage)\nownedConcern = ownedUsage->selectByKind(ConcernUsage)\nownedCase = ownedUsage->selectByKind(CaseUsage)\nownedAnalysisCase = ownedUsage->selectByKind(AnalysisCaseUsage)\nownedVerificationCase = ownedUsage->selectByKind(VerificationCaseUsage)\nownedUseCase = ownedUsage->selectByKind(UseCaseUsage)\nownedView = ownedUsage->selectByKind(ViewUsage)\nownedViewpoint = ownedUsage->selectByKind(ViewpointUsage)\nownedRendering = ownedUsage->selectByKind(RenderingUsage)\nownedMetadata = ownedMember->selectByKind(MetadataUsage)\nisVariation implies isAbstract";
    }
    ref directedUsage: Usage [0,*] derived transient volatile
      annotation "http://schema.omg.org/spec/MOF/2.0/emof.xml#Property.oppositeRoleName" {
        detail "body" = "definitionWithDirectedUsage";
